<article class="view-component view-component-about about-style-3">
    <div class="row">
        <header class="article-header col-lg-6 mb-3 mb-lg-0">
            {include uri='design:explayouts/block/component/_picture.tpl' cmp=$cmp pic_class='image'}
            {include uri='design:explayouts/block/component/_about_eyebrow_title.tpl' cmp=$cmp}
        </header>
        <div class="article-info col-lg-5 offset-lg-1">
            {include uri='design:explayouts/block/component/_about_short.tpl' cmp=$cmp}
            {include uri='design:explayouts/block/component/_about_actions.tpl' cmp=$cmp btn_class='btn btn-primary'}
        </div>
    </div>
</article>
