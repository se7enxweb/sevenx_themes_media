




{% set location_path = exp_path(location) %}
{% set children = filterChildren(location, ['image'], 1) %}

<article {{ item_params(toolbar_macros, content, location) }} class="view-type view-type-{{ view_type }} ng-gallery vl1">
    <i class="icon-camera article-icon" aria-hidden="true"></i>
    {% if exp_not((children.searchHits|count)|eq(0)) %}
        {% set first_image = children[0].content %}

        <figure class="image">
            {{ ng_render_field(first_image.fields.image, {'parameters': {'alias': 'i480', 'alt_text': first_image.fields.name.value, 'link_href': location_path}}) }}
        </figure>
    {% endif %}
    <header class="article-header">
        <h3 class="title"><a href="{{ location_path }}">{{ title(content_fields, content) }}</a></h3>
    </header>

    {% if first_set(with_intro, 'false') %}
        {{ intro(content_fields, content) }}
    {% endif %}
</article>{# exp:template:convert tpl->twig md5:f625382978ba765be2356906618e0167 from override/templates/node/view/standard/standard_ng_gallery.tpl -- generated; a file changed by hand is not replaced without --force #}