





<article {{ item_params(toolbar_macros, content, location) }} class="view-type view-type-{{ view_type }} ng-news vl1">
    {{ image(content_fields, content, location) }}

    <header class="article-header">
        <h3 class="title"><a href="{{ exp_path(location) }}">{{ title(content_fields, content) }}</a></h3>
        <div class="info">
            {% expinclude uri='design:content/parts/author.tpl' %}
            {% expinclude uri='design:content/parts/time.tpl' %}
        </div>
    </header>

    {% if first_set(with_intro, 'false') %}
        {{ intro(content_fields, content) }}
    {% endif %}
</article>{# exp:template:convert tpl->twig md5:f52db84a8973e658145596823d9fa259 from override/templates/node/view/standard/standard_ng_news.tpl -- generated; a file changed by hand is not replaced without --force #}