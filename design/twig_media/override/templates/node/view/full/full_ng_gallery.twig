{% set gf_img = gf_img ?? null %}
{% set gf_url = gf_url ?? null %}
{% set gf_map = node.object.data_map %}
{% set content = node.object %}
{% explblock name='content' %}
<div class="view-type view-type-full ng-gallery">
    {% explblock name='article_header' %}
    <header class="full-page-header">
        <div class="container">
            {% expinclude uri='design:content/parts/main_topic.tpl' content=node.object %}

            <h1 class="full-page-title"><span class="exp_string-field">{% if exp_and(is_set(node.data_map.title), node.data_map.title.has_content) %}
{{ node.data_map.title.content|wash }}{% else %}
{{ node.name|wash }}{% endif %}
</span></h1>

            <div class="full-page-info">
                {% expinclude uri='design:content/parts/author.tpl' content=node.object node=node %}
                {% expinclude uri='design:content/parts/time.tpl' %}
            </div>
        </div>
    </header>
    {% endexplblock %}

    {% set gf_children = fetch('content', 'list', {'parent_node_id': node.node_id, 'class_filter_type': 'include', 'class_filter_array': ['image'], 'sort_by': [['priority', true]]}) %}
    {% if (gf_children|count)|gt(0) %}
    {% explblock name='article_media' %}
    <div class="full-page-image">
        <div class="container container-wide">
            <div class="related-multimedia swiper">
                <div class="swiper-wrapper">
                    {% for gf_child in gf_children %}
                        {% if exp_and(is_set(gf_child.data_map.image), gf_child.data_map.image.has_content) %}
                        {% set gf_img = gf_child.data_map.image.content %}
                        {% set gf_url = '' %}
                        {% if is_set(gf_img.i1320) %}
{% set gf_url = gf_img.i1320.url %}
                        {% elseif is_set(gf_img.large) %}
{% set gf_url = gf_img.large.url %}
                        {% elseif is_set(gf_img.original) %}
{% set gf_url = gf_img.original.url %}
{% endif %}
                        {% if gf_url|ne('') %}
                        <div class="swiper-slide">
                            <figure class="image-wrapper">
                                <img src={{ gf_url|ezroot }} loading="lazy" alt="{{ gf_img.alternative_text|wash }}" />
                            </figure>
                        </div>
                        {% endif %}
                        {% set gf_img = null %}
{% set gf_url = null %}
                        {% endif %}
                    {% endfor %}
                </div>
                <div class="swiper-navigation">
                    <div class="swiper-pagination"></div>
                    <div class="swiper-button-prev"></div>
                    <div class="swiper-button-next"></div>
                </div>
            </div>
        </div>
    </div>
    {% endexplblock %}
    {% endif %}
    {% set gf_children = null %}

    <div class="container container-narrow">
        {% explblock name='article_body' %}
        <div class="full-page-body">
            {% if exp_and(is_set(gf_map.teaser_intro), gf_map.teaser_intro.has_content) %}
            <div class="full-page-intro">
                <div class="exp_richtext-field">{{ attribute_view_gui({'attribute': gf_map.teaser_intro}) }}</div>
            </div>
            {% endif %}
            {% if exp_and(is_set(gf_map.description), gf_map.description.has_content) %}
            <div class="exp_richtext-field">{{ attribute_view_gui({'attribute': gf_map.description}) }}</div>
            {% endif %}
            {% expinclude uri='design:content/parts/tags.tpl' content=node.object node=node %}
        </div>
        {% endexplblock %}
    </div>
</div>{% endexplblock %}
{% set gf_map = null %}
