
{% set v_map = node.object.data_map %}

<article class="review-item">
    <header class="review-item-head">
        {% if exp_and(is_set(v_map.rating), v_map.rating.has_content) %}
        <span class="product-stars" data-rating="{{ v_map.rating.content }}" aria-hidden="true"></span>
        <span class="review-item-score">{{ v_map.rating.content }}/5</span>
        {% endif %}

        {% if exp_and(is_set(v_map.title), v_map.title.has_content) %}
        <h3 class="review-item-title">{{ v_map.title.content|wash }}</h3>
        {% endif %}

        <p class="review-item-meta">
            <span class="review-item-author">
                {% if exp_and(is_set(v_map.author), v_map.author.has_content) %}
                    {{ v_map.author.content|wash }}
                {% else %}
                    {{ node.object.owner.name|wash }}
                {% endif %}
            </span>
            <time datetime="{{ node.object.published|datetime('custom', '%Y-%m-%d') }}">
                {{ node.object.published|l10n('shortdate') }}
            </time>
            {% if exp_and(is_set(v_map.verified_purchase), v_map.verified_purchase.content) %}
            <span class="review-item-verified">{{ 'Verified purchase'|i18n('ngsite') }}</span>
            {% endif %}
        </p>
    </header>

    {% if exp_and(is_set(v_map.body), v_map.body.has_content) %}
    <div class="review-item-body">{{ (v_map.body.content|wash)|exp_nl2br }}</div>
    {% endif %}
</article>
{% set v_map = null %}
