





{% if exp_or(exp_not(content.fields.video_file.empty), exp_not(content.fields.video_identifier.empty)) %}
<article {{ item_params(toolbar_macros, content, location) }} class="view-type view-type-{{ view_type }} ng-video vl4">
    <i class="icon-play article-icon" aria-hidden="true"></i>
    <figure class="image">
        {{ poster(video, content, location) }}
    </figure>
    <div class="article-content">
        <header class="article-header">
            <h3 class="title"><a href="{{ exp_path(location) }}">{{ title(content_fields, content) }}</a></h3>
        </header>
        {{ intro(content_fields, content) }}
    </div>
</article>{% endif %}
