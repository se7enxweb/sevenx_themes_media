





<article {{ item_params(toolbar_macros, content, location) }} class="view-type view-type-{{ view_type }} ng-blog-post vl4">
    {{ image(content_fields, content, location, 'i320') }}

    <div class="article-content">
        <header class="article-header">
            <h3 class="title"><a href="{{ exp_path(location) }}">{{ title(content_fields, content) }}</a></h3>
            <div class="info">
                {% expinclude uri='design:content/parts/author.tpl' %}
                {% expinclude uri='design:content/parts/time.tpl' %}
            </div>
        </header>
        {{ intro(content_fields, content) }}
    </div>
</article>{# exp:template:convert tpl->twig md5:82347bad50e761adf58919410b89c3cb from override/templates/node/view/line/line_ng_blog_post.tpl -- generated; a file changed by hand is not replaced without --force #}