





<article {{ item_params(toolbar_macros, content, location) }} class="view-type view-type-{{ view_type }} ng-article vl4">
    {{ image(content_fields, content, location, 'i320') }}

    <div class="article-content">
        <header class="article-header">
            <h3 class="title"><a href="{{ exp_path(location) }}">{{ title(content_fields, content) }}</a></h3>
            <div class="info">
                {% expinclude uri='design:content/parts/author.tpl' %}
            </div>
        </header>
        {{ intro(content_fields, content) }}
    </div>
</article>{# exp:template:convert tpl->twig md5:c2888adafb3c49ae1f0bc8aee43116ec from override/templates/node/view/line/line_ng_article.tpl -- generated; a file changed by hand is not replaced without --force #}