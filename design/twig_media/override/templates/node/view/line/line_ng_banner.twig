





<article {{ item_params(toolbar_macros, content, location) }} class="view-type view-type-{{ view_type }} ng-banner vl4">
    {% if exp_not(content.fields.image.empty) %}
        <figure class="image">
            {{ image_link(links, content, 'image', 'i480') }}
        </figure>
    {% endif %}

    <div class="article-content">
        <header class="article-header">
            <h3 class="title">
                {{ content_link(links, content, content.fields.title.value.text) }}
            </h3>
        </header>
        <div class="short">
            {{ ng_render_field(content.fields.description) }}
        </div>
    </div>
</article>{# exp:template:convert tpl->twig md5:a94e19992ee35b54fa6eb0b191d4c8aa from override/templates/node/view/line/line_ng_banner.tpl -- generated; a file changed by hand is not replaced without --force #}