{% explblock name=zone.identifier %}
<section class="zone zone-{{ zone.identifier|wash }}">{% for zone_block in zone.blocks %}
    {% if exp_and(is_set(zone_block.parent_id), zone_block.parent_id|eq(0)) %}
        {% if exp_and(is_set(zone_block.definition_identifier), zone_block.definition_identifier|ne('')) %}
            {% expinclude uri='design:explayouts/block/block.tpl' name='zoneblock' block=zone_block zone=zone module_result=module_result %}
        {% else %}
            {% expinclude uri='design:explayouts/block/tpl_block.tpl' block=zone_block zone=zone module_result=module_result %}
        {% endif %}
    {% endif %}
{% endfor %}
</section>{% endexplblock %}
