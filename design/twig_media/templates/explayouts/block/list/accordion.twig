
<div class="slb slb-list slb-list-accordion" data-block-id="{{ block.id|wash }}">
    {% if block.name %}
<h3>{{ block.name|wash }}</h3>{% endif %}
    {% for item in block.values.items %}
        <details class="accordion-item">
            <summary><a href={{ item.url_alias|ezurl }}>{{ item.name|wash }}</a></summary>
            <p>{{ item.name|wash }}</p>
        </details>
    {% endfor %}
    {% if eq(count(block.values.items), 0) %}
<p class="empty">{{ 'No items found.'|i18n('design/media/block') }}</p>{% endif %}
</div>
