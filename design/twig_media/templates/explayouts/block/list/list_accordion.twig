{% set la_tpl = la_tpl ?? null %}

<div class="list-row">
    {% for la_node in block.values.items %}
    <div class="list-item">
        {% set la_tpl = item_view_template('accordion', la_node.class_identifier) %}
        {% if la_tpl|ne('') %}
            {% expinclude uri=(concat('design:', la_tpl)) node=la_node content=la_node.object location=la_node view_type='accordion' %}
        {% endif %}
        {% set la_tpl = null %}
    </div>
    {% endfor %}
</div>
