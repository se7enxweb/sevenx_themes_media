{% set list_items = list_items ?? null %}
{% set running_image = running_image ?? null %}
{% set img = img ?? null %}
{% set allowed_list_classes = ['ng_article', 'ng_blog_post', 'ng_news', 'ng_recipe', 'ng_video', 'ng_topic', 'ng_gallery'] %}
{% set excluded_names = ['Cookie Policy', 'Privacy Policy', 'Blog post test'] %}
{% set list_items = [] %}
{% for node in block.values.items %}
    {% if exp_and(allowed_list_classes|contains(node.class_identifier), (excluded_names|contains(node.name))|exp_not, count(list_items)|lt(3)) %}
        {% set list_items = list_items|append(node) %}
    {% endif %}
{% endfor %}
<div class="running-track">{% for node in list_items %}
    {% set running_image = '' %}
    {% for attr_name in ['image', 'teaser_image', 'cover_image'] %}
        {% if exp_and(is_set(node.data_map[attr_name]), node.data_map[attr_name].has_content, running_image|eq('')) %}
            {% set img = node.data_map[attr_name].content %}
            {% if is_set(img.small) %}
                {% set running_image = img.small.url %}
            {% elseif is_set(img.original) %}
                {% set running_image = img.original.url %}
            {% endif %}
            {% set img = null %}
        {% endif %}
    {% endfor %}
    <article class="running-item">
        <a href={{ node.url_alias|ezurl }} class="running-link">
            {% if running_image|ne('') %}
                <figure class="running-image"><img src={{ running_image|ezroot }} alt="" /></figure>
            {% endif %}
            <h3 class="running-title">{{ node.name|wash }}</h3>
        </a>
    </article>
    {% set running_image = null %}
{% endfor %}
</div>{% set allowed_list_classes = null %}
{% set excluded_names = null %}
{% set list_items = null %}
