{% if exp_and(block.values.text|ne(''), block.values.link|ne('')) %}
        <a href={{ block.values.link|ezurl }}
                             class="{{ block.values.class|wash }}"
                    >
                        {{ layout_title(block.values.text)|wash }}
    </a>{% elseif block.values.text|ne('') %}
        <span class="{{ block.values.class|wash }}">{{ layout_title(block.values.text)|wash }}</span>{% endif %}
