{% set qs_title = qs_title ?? null %}
{% set qs_desc = qs_desc ?? null %}
{% set qs_pimg_attr = qs_pimg_attr ?? null %}
{% set qs_pimg = qs_pimg ?? null %}
{% set qs_purl = qs_purl ?? null %}
{% set qs_pname = qs_pname ?? null %}
{% set qs_pdesc = qs_pdesc ?? null %}
<article class="view-component view-component-quote quote-style-1">
    <div class="quote-swiper swiper"
        data-effect="slide"
        data-loop="true"
        data-autoplay="5000"
    >
        <div class="swiper-wrapper">
            {% set qs_map = cmp.data_map %}
            {% for qs_idx in exprange(1, 8) %}
                {% set qs_title = qs_map[concat('item_', qs_idx, '_title')] %}
                {% if exp_and(is_set(qs_title), qs_title.has_content) %}
                <div class="swiper-slide">
                    <div class="container container-narrow">
                        <div class="quote-item">
                            <img class="quote-icon" src={{ 'images/quote.svg'|ezdesign('no') }} alt="" />
                            <h3 class="item-title">                <span         class="exp_string-field" >{{ qs_title.content|wash }}</span>
</h3>
                            {% set qs_desc = qs_map[concat('item_', qs_idx, '_description')] %}
                            {% if exp_and(is_set(qs_desc), qs_desc.has_content) %}
                            <div class="item-short">
                                <div         class="exp_richtext-field" >{{ attribute_view_gui({'attribute': qs_desc}) }}</div>
                            </div>
                            {% endif %}
                            {% set qs_desc = null %}
                            <div class="quote-person">
                                {% set qs_pimg_attr = qs_map[concat('item_', qs_idx, '_person_image')] %}
                                {% if exp_and(is_set(qs_pimg_attr), qs_pimg_attr.has_content) %}
                                {% set qs_pimg = qs_pimg_attr.content %}
                                {% set qs_purl = '' %}
                                {% if is_set(qs_pimg.i160) %}
{% set qs_purl = qs_pimg.i160.url %}
                                {% elseif is_set(qs_pimg.original) %}
{% set qs_purl = qs_pimg.original.url %}
{% endif %}
                                {% if qs_purl|ne('') %}
                                <div class="quote-person-image">
                                    <img
            src={{ qs_purl|ezroot }}
            loading="lazy"                                                alt=""
                    class="exp_image-field"  />
                                </div>
                                {% endif %}
                                {% set qs_pimg = null %}
{% set qs_purl = null %}
                                {% endif %}
                                {% set qs_pimg_attr = null %}
                                <div class="quote-person-info">
                                    {% set qs_pname = qs_map[concat('item_', qs_idx, '_person_name')] %}
                                    {% if exp_and(is_set(qs_pname), qs_pname.has_content) %}
                                    <div class="quote-person-info-name">{{ qs_pname.content|wash }}</div>
                                    {% endif %}
                                    {% set qs_pname = null %}
                                    {% set qs_pdesc = qs_map[concat('item_', qs_idx, '_person_description')] %}
                                    {% if exp_and(is_set(qs_pdesc), qs_pdesc.has_content) %}
                                    <span         class="exp_string-field" >{{ qs_pdesc.content|wash }}</span>
                                    {% endif %}
                                    {% set qs_pdesc = null %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {% endif %}
                {% set qs_title = null %}
            {% endfor %}
            {% set qs_map = null %}
        </div>
        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
    </div>
</article>
