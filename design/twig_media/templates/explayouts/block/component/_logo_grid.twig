{% set lg_map = lg_map ?? null %}
{% set lg_img = lg_img ?? null %}
{% set lg_count = lg_count ?? null %}
{% set lg_logos = fieldRelations(cmp, 'logos') %}
{% set lg_count = 0 %}
{% set lg_max = first_set(logo_limit, 0) %}
<div class="logo-grid">
    {% for lg_logo in lg_logos %}
        {% if exp_or(lg_max|eq(0), lg_count|lt(lg_max)) %}
        {% set lg_map = lg_logo.data_map %}
        {% if exp_and(is_set(lg_map.logo_svg), lg_map.logo_svg.has_content) %}
        <div class="logo-grid-item">
            <img src={{ concat('/var/site/storage/original/image/', lg_map.logo_svg.content.filename)|ezroot }} alt="{{ lg_logo.name|wash }}" />
        </div>
        {% elseif exp_and(is_set(lg_map.logo), lg_map.logo.has_content) %}
        {% set lg_img = lg_map.logo.content %}
        {% if is_set(lg_img.original) %}
        <div class="logo-grid-item">
            <img src={{ lg_img.original.url|ezroot }} alt="{{ lg_logo.name|wash }}" />
        </div>
        {% endif %}
        {% set lg_img = null %}
        {% endif %}
        {% set lg_count = lg_count|sum(1) %}
        {% set lg_map = null %}
        {% endif %}
    {% endfor %}
</div>{% set lg_logos = null %}
{% set lg_count = null %}
{% set lg_max = null %}
