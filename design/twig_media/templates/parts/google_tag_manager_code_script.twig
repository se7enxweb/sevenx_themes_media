{% set exp_config = (exponential()).configResolver %}
{% if hasParameter(exp_config, 'site_settings.google_tag_manager_code') %}
    {% set google_tag_manager_code = getParameter(exp_config, 'site_settings.google_tag_manager_code') %}

    {% if (google_tag_manager_code|count)|gt(0) %}
        <!-- Google Tag Manager -->
        <meta name="exp-google-tag-manager" content="{{ google_tag_manager_code|wash }}" />
        {{ ezscript(['exp-google-tag-manager.js']) }}
        <!-- End Google Tag Manager -->
    {% endif %}
{% endif %}
