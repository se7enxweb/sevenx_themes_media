{% set RemovedItem__index = RemovedItem__index ?? null %}
{% set RemovedItem__number = RemovedItem__number ?? null %}
{% set Basket__ProductItem__index = Basket__ProductItem__index ?? null %}
{% set Basket__ProductItem__number = Basket__ProductItem__number ?? null %}
{% set Basket__ProductItem__sequence = Basket__ProductItem__sequence ?? null %}
{% set Basket__ProductItem__Options__index = Basket__ProductItem__Options__index ?? null %}
{% set Basket__ProductItem__Options__number = Basket__ProductItem__Options__number ?? null %}
{% set Basket__ProductItem__Options__sequence = Basket__ProductItem__Options__sequence ?? null %}

{% set basket_page_name = cond(is_set(basket_view_name), basket_view_name, 'basket') %}

<header class="full-page-header text-center no-breadcrumbs">
    <div class="container">
        <h1 class="full-page-title">{% if basket_page_name|eq('cart') %}
{{ 'Cart'|i18n('design/ezwebin/shop/basket') }}{% else %}
{{ 'Basket'|i18n('design/ezwebin/shop/basket') }}{% endif %}
</h1>
        <ol class="checkout-steps">
            <li class="selected active">1. {{ 'Shopping basket'|i18n('design/ezwebin/shop/basket') }}</li>
            <li>2. {{ 'Account information'|i18n('design/ezwebin/shop/basket') }}</li>
            <li>3. {{ 'Confirm order'|i18n('design/ezwebin/shop/basket') }}</li>
        </ol>
    </div>
</header>

<div class="full-form-content shop-checkout">
    <div class="container">

        {% if removed_items %}
            <div class="alert alert-warning">
                <h2>{{ 'The following items were removed from your basket because the products were changed.'|i18n('design/ezwebin/shop/basket', expvoid(), expvoid()) }}</h2>
                <ul>
                    {% for RemovedItem__key, RemovedItem__item in expsectionloop(removed_items, 0, null, false) %}
{% set RemovedItem__index = loop.index0 %}
{% set RemovedItem__number = loop.index %}
                        <li>{{ RemovedItem__item.name|wash }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {% if exp_not(vat_is_known) %}
            <div class="alert alert-warning">
                <h2>{{ 'VAT is unknown'|i18n('design/ezwebin/shop/basket') }}</h2>
                <p>
                    {{ 'VAT percentage is not yet known for some of the items being purchased.'|i18n('design/ezwebin/shop/basket') }}
                    {{ 'This probably means that some information about you is not yet available and will be obtained during checkout.'|i18n('design/ezwebin/shop/basket') }}
                </p>
            </div>
        {% endif %}

        {% if error %}
            {% if error|eq(1) %}
                <div class="alert alert-danger">
                    <h2>{{ 'Attempted to add object without price to basket.'|i18n('design/ezwebin/shop/basket', expvoid(), expvoid()) }}</h2>
                </div>
            {% endif %}
            {% if eq(error, 'aborted') %}
                <div class="alert alert-danger">
                    <h2>{{ 'Your payment was aborted.'|i18n('design/ezwebin/shop/basket', expvoid(), expvoid()) }}</h2>
                </div>
            {% endif %}
        {% endif %}

        <form method="post" name="Basket" class="embed-form" action={{ concat('/shop/', basket_page_name, '/')|ezurl }}>

            {% set currency = fetch('shop', 'currency', {'code': basket.productcollection.currency_code}) %}
{% set locale = false %}
{% set symbol = false %}

            {% if currency %}
                {% set locale = currency.locale %}
{% set symbol = currency.symbol %}
            {% endif %}

            {% if basket.items %}

                <div class="shop-table-wrap">
                    <table class="shop-table">
                        <tr>
                            <th>{{ 'Product'|i18n('design/ezwebin/shop/basket') }}</th>
                            <th>{{ 'Count'|i18n('design/ezwebin/shop/basket') }}</th>
                            <th>{{ 'VAT'|i18n('design/ezwebin/shop/basket') }}</th>
                            <th>{{ 'Price inc. VAT'|i18n('design/ezwebin/shop/basket') }}</th>
                            <th>{{ 'Discount'|i18n('design/ezwebin/shop/basket') }}</th>
                            <th>{{ 'Total price ex. VAT'|i18n('design/ezwebin/shop/basket') }}</th>
                            <th>{{ 'Total price inc. VAT'|i18n('design/ezwebin/shop/basket') }}</th>
                            <th>{{ 'Remove'|i18n('design/ezwebin/shop/basket') }}</th>
                        </tr>

                        {% set __sequence1 = ['bgdark', 'bglight'] %}
{% for Basket__ProductItem__key, Basket__ProductItem__item in expsectionloop(basket.items, 0, null, false) %}
{% set Basket__ProductItem__index = loop.index0 %}
{% set Basket__ProductItem__number = loop.index %}
{% set Basket__ProductItem__sequence = expsequence(__sequence1, loop.index0) %}
                            <tr class="{{ Basket__ProductItem__sequence }}">
                                <td>
                                    <input type="hidden" name="ProductItemIDList[]" value="{{ Basket__ProductItem__item.id }}" />
                                    <a href={{ concat('/content/view/full/', Basket__ProductItem__item.node_id, '/')|ezurl }}>{{ Basket__ProductItem__item.object_name|wash }}</a>
                                </td>
                                <td>
                                    <input class="form-control shop-qty" type="text" name="ProductItemCountList[]" value="{{ Basket__ProductItem__item.item_count }}" size="5" />
                                </td>
                                <td>
                                    {% if ne(Basket__ProductItem__item.vat_value, -1) %}
                                        {{ Basket__ProductItem__item.vat_value }} %
                                    {% else %}
                                        {{ 'Unknown'|i18n('design/ezwebin/shop/basket') }}
                                    {% endif %}
                                </td>
                                <td>{{ Basket__ProductItem__item.price_inc_vat|l10n('currency', locale, symbol) }}</td>
                                <td>{{ Basket__ProductItem__item.discount_percent }}%</td>
                                <td>{{ Basket__ProductItem__item.total_price_ex_vat|l10n('currency', locale, symbol) }}</td>
                                <td>{{ Basket__ProductItem__item.total_price_inc_vat|l10n('currency', locale, symbol) }}</td>
                                <td>
                                    <input type="checkbox" name="RemoveProductItemDeleteList[]" value="{{ Basket__ProductItem__item.id }}" />
                                </td>
                            </tr>

                            {% if Basket__ProductItem__item.item_object.option_list %}
                                <tr>
                                    <td colspan="8">
                                        <table class="shop-options-table w-100">
                                            <tr>
                                                <td colspan="3">{{ 'Selected options'|i18n('design/ezwebin/shop/basket') }}</td>
                                            </tr>
                                            {% set __sequence2 = ['bglight', 'bgdark'] %}
{% for Basket__ProductItem__Options__key, Basket__ProductItem__Options__item in expsectionloop(Basket__ProductItem__item.item_object.option_list, 0, null, false) %}
{% set Basket__ProductItem__Options__index = loop.index0 %}
{% set Basket__ProductItem__Options__number = loop.index %}
{% set Basket__ProductItem__Options__sequence = expsequence(__sequence2, loop.index0) %}
                                                <tr>
                                                    <td>{{ Basket__ProductItem__Options__item.name|wash }}</td>
                                                    <td>{{ Basket__ProductItem__Options__item.value|wash }}</td>
                                                    <td>{{ Basket__ProductItem__Options__item.price|l10n('currency', locale, symbol) }}</td>
                                                </tr>
                                            {% endfor %}
                                        </table>
                                    </td>
                                </tr>
                            {% endif %}
                        {% endfor %}
                    </table>
                </div>

                <div class="basket-actions buttonblock clearfix shop-actions">
                    <input class="btn btn-secondary" type="submit" name="StoreChangesButton" value="{{ 'Update'|i18n('design/ezwebin/shop/basket') }}" />
                    <input class="btn btn-secondary" type="submit" name="RemoveProductItemButton" value="{{ 'Remove'|i18n('design/ezwebin/shop/basket') }}" />
                </div>

                <h2 class="form-section-title">{{ 'Basket summary'|i18n('design/ezwebin/shop/basket') }}</h2>

                <div class="shop-table-wrap">
                    <table class="shop-table">
                        <tr>
                            <th>{{ 'Summary'|i18n('design/ezwebin/shop/basket') }}</th>
                            <th>{{ 'Total price ex. VAT'|i18n('design/ezwebin/shop/basket') }}</th>
                            <th>{{ 'Total price inc. VAT'|i18n('design/ezwebin/shop/basket') }}</th>
                        </tr>
                        <tr class="bglight">
                            <td>{{ 'Subtotal of items'|i18n('design/ezwebin/shop/basket') }}:</td>
                            <td>{{ basket.total_ex_vat|l10n('currency', locale, symbol) }}</td>
                            <td>{{ basket.total_inc_vat|l10n('currency', locale, symbol) }}</td>
                        </tr>

                        {% if is_set(shipping_info) %}
                            <tr class="bgdark">
                                <td>
                                    <a href={{ shipping_info.management_link|ezurl }}>{{ 'Shipping'|i18n('design/ezwebin/shop/basket') }}{% if shipping_info.description %}
 ({{ shipping_info.description }}){% endif %}
</a>:
                                </td>
                                <td>{{ shipping_info.cost|l10n('currency', locale, symbol) }}</td>
                                <td>{{ shipping_info.cost|l10n('currency', locale, symbol) }}</td>
                            </tr>
                            <tr class="bglight">
                                <td><strong>{{ 'Order total'|i18n('design/ezwebin/shop/basket') }}:</strong></td>
                                <td><strong>{{ total_inc_shipping_ex_vat|l10n('currency', locale, symbol) }}</strong></td>
                                <td><strong>{{ total_inc_shipping_inc_vat|l10n('currency', locale, symbol) }}</strong></td>
                            </tr>
                        {% endif %}
                    </table>
                </div>

                <div class="buttonblock clearfix">
                    <input class="btn btn-primary" type="submit" id="CheckoutButton" name="CheckoutButton" value="{{ 'Checkout'|i18n('design/ezwebin/shop/basket') }}" />
                    <input class="btn btn-secondary" type="submit" name="ContinueShoppingButton" value="{{ 'Continue shopping'|i18n('design/ezwebin/shop/basket') }}" />
                </div>

            {% else %}

                <div class="alert alert-info">
                    <h2>{{ 'You have no products in your basket.'|i18n('design/ezwebin/shop/basket') }}</h2>
                </div>

                <div class="buttonblock clearfix">
                    <input class="btn btn-secondary" type="submit" name="ContinueShoppingButton" value="{{ 'Continue shopping'|i18n('design/ezwebin/shop/basket') }}" />
                </div>

            {% endif %}

            {% set currency = null %}
{% set locale = null %}
{% set symbol = null %}
        </form>
    </div>
</div>
{% set basket_page_name = null %}
