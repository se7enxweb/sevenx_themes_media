{% set si = fetch('content', 'object', {'object_id': false, 'remote_id': ezini('SiteInfo', 'RemoteID', 'menu.ini')}) %}
{% set site_name_text = ezini('SiteSettings', 'SiteName', 'site.ini') %}
{% set logo_url = '' %}
{% if exp_and(is_object(si), si.data_map.site_logo.has_content) %}
    {% set logo_url = si.data_map.site_logo.content.filepath %}
{% endif %}
{% if logo_url|eq('') %}
    {% set logo_url = 'images/site-logo.svg'|ezdesign('no') %}
{% endif %}

<a class="site-logo" href={{ '/'|ezurl }} title="{{ site_name_text|wash }}">
    <img src={{ logo_url|ezroot }} alt="{{ site_name_text|wash }}" />
</a>
{% set si = null %}
{% set site_name_text = null %}
{% set logo_url = null %}
