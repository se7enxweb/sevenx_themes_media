<div class="related-multimedia">{% if exp_not(content.fields.image.empty) %}
    <figure class="image-wrapper">
        {{ ng_render_field(content.fields.image) }}
    </figure>{% endif %}
{% set relatedMultimedia = fieldRelations(content, 'related_multimedia') %}
{% if (relatedMultimedia|count)|gt(0) %}
    {% for multimediaItem in relatedMultimedia %}
        {% if exp_not(multimediaItem.dataMap.image.empty) %}
            <figure class="image-wrapper">
                {{ ng_render_field(multimediaItem.dataMap.image) }}
            </figure>
        {% endif %}
    {% endfor %}
{% endif %}
</div>
