{% set fh_node = false %}
{% if exp_and(is_set(module_result.content_info.node_id), module_result.content_info.node_id|gt(0)) %}
    {% set fh_node = fetch('content', 'node', {'node_id': module_result.content_info.node_id}) %}
{% endif %}
{% if fh_node %}
{% if exp_not(is_set(node)) %}
{% set node = fh_node %}
{% endif %}
{% if exp_not(is_set(content)) %}
{% set content = fh_node.object %}
{% endif %}
{% explblock name='article_header' %}
<header class="full-page-header">
    <div class="container">
        {% expinclude uri='design:content/parts/main_topic.tpl' %}

        <h1 class="full-page-title"><span class="exp_string-field">{{ fh_node.name|wash }}</span></h1>

        <div class="full-page-info">
            {% expinclude uri='design:content/parts/author.tpl' %}
        </div>
    </div>
</header>{% endexplblock %}
{% endif %}
{% set fh_node = null %}
