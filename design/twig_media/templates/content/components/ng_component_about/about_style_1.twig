

{% set image = fieldValue(content, 'image') %}
{% set image_mobile = fieldValue(content, 'image_mobile') %}


    <article class="view-component view-component-about about-style-1">

        {% if exp_or(exp_not(content.fields.eyebrow_title.empty), exp_not(content.fields.title.empty)) %}
            <header class="article-header">
                {% if exp_not(content.fields.eyebrow_title.empty) %}
                    <div class="eyebrow-title">
                        {{ ng_render_field(content.fields.eyebrow_title) }}
                    </div>
                {% endif %}

                {% if exp_not(content.fields.title.empty) %}
                    <h2 class="title">
                        {{ ng_render_field(content.fields.title) }}
                    </h2>
                {% endif %}
            </header>
        {% endif %}
        
        <div class="article-info">
            {% if exp_not(content.fields.description.empty) %}
                <div class="short">
                    {{ ng_render_field(content.fields.description) }}
                </div>
            {% endif %}

            <div class="actions">
                {% if exp_not(content.fields.link_1.empty) %}
                    {{ ng_render_field(content.fields.link_1, {'parameters': {'css_class': 'btn btn-secondary'}}) }}
                {% endif %}

                {% if exp_not(content.fields.link_2.empty) %}
                    {{ ng_render_field(content.fields.link_2, {'parameters': {'css_class': 'btn btn-default'}}) }}
                {% endif %}
            </div>
        </div>

    </article>
