

{% set image = fieldValue(content, 'image') %}
{% set image_mobile = fieldValue(content, 'image_mobile') %}
{% set actions = exp_or(exp_not(content.fields.link_1.empty), exp_not(content.fields.link_2.empty)) %}


<article class="view-component view-component-about about-style-4">
    <header class="article-header">
        {% if exp_not(content.fields.title.empty) %}
            <h2 class="title">
                {{ ng_render_field(content.fields.title) }}
            </h2>
        {% endif %}
        {% if exp_or(exp_not(content.fields.description.empty), exp_not(content.fields.description_2.empty)) %}
            <div class="text">
                {% if exp_not(content.fields.description.empty) %}
                    <div class="short">
                        {{ ng_render_field(content.fields.description) }}
                    </div>
                {% endif %}
                {% if exp_not(content.fields.description_2.empty) %}
                    <div class="short">
                        {{ ng_render_field(content.fields.description_2) }}
                    </div>
                {% endif %}
            </div>
        {% endif %}
        {% if actions %}
            <div class="actions">
                {% if exp_not(content.fields.link_1.empty) %}
                    {{ ng_render_field(content.fields.link_1, {'parameters': {'css_class': 'btn btn-primary'}}) }}
                {% endif %}
                {% if exp_not(content.fields.link_2.empty) %}
                    {{ ng_render_field(content.fields.link_2, {'parameters': {'css_class': 'btn btn-default'}}) }}
                {% endif %}
            </div>
        {% endif %}
    </header>
</article>
