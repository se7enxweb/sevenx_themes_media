

{% set image = content.fields.image %}
{% set image_mobile = content.fields.image_mobile %}
{% set local_video = content.fields.video %}
{% set local_video_mobile = content.fields.video_mobile %}


    <article class="view-component view-component-hero hero-style-1">
        <div class="container">
            <div class="row">
                <div class="col-md-10 col-lg-8 col-xl-7">
                    <header class="article-header">
                        {% if exp_not(content.fields.eyebrow_title.empty) %}
                            <div class="eyebrow-title">
                                {{ ng_render_field(content.fields.eyebrow_title) }}
                            </div>
                        {% endif %}
                        {% if exp_not(content.fields.title.empty) %}
                            <h1 class="title">
                                {{ ng_render_field(content.fields.title) }}
                            </h1>
                        {% endif %}
                        {% if exp_not(content.fields.description.empty) %}
                            <div class="short">
                                {{ ng_render_field(content.fields.description) }}
                            </div>
                        {% endif %}
                        <div class="actions">
                            {% if exp_not(content.fields.link_1.empty) %}
                                {{ ng_render_field(content.fields.link_1, {'parameters': {'css_class': 'btn btn-primary'}}) }}
                            {% endif %}

                            {% if exp_not(content.fields.link_2.empty) %}
                                {{ ng_render_field(content.fields.link_2, {'parameters': {'css_class': 'btn btn-default'}}) }}
                            {% endif %}
                        </div>
                    </header>
                </div>
            </div>
        </div>
        <figure>
            {% if exp_and(is_set(local_video), exp_not(local_video.empty)) %}
                <video preload="auto" autoplay="" loop="" muted="" playsinline="" class="js-responsive-video"
                    data-desktop-vid="{{ path('ngsite_download', {'contentId': content.id, 'fieldId': local_video.id, 'isInline': 1}) }}"
                    {% if exp_and(is_set(local_video_mobile), exp_not(local_video_mobile.empty)) %}
                    data-mobile-vid="{{ path('ngsite_download', {'contentId': content.id, 'fieldId': local_video_mobile.id, 'isInline': 1}) }}"
                {% endif %}
                ></video>
                <span class="overlay"></span>
            {% elseif exp_not(image.empty) %}
                <picture>
                    {% if exp_not(image_mobile.empty) %}
                        <source media="(max-width: 991px)" srcset="{{ ng_image_alias(content.fields.image_mobile, 'i770') }}">
                    {% endif %}
                    <source media="(min-width: 992px)" srcset="{{ ng_image_alias(content.fields.image, 'original') }}">
                    {{ ng_render_field(content.fields.image, {'parameters': {'lazy_loading': 'false', 'alias': 'i1920'}}) }}
                </picture>
                <span class="overlay"></span>
            {% endif %}
        </figure>
    </article>
