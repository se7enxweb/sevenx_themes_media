



    <article class="view-component view-component-quote quote-style-1">
        {% if exp_not(content.fields.title.empty) %}
            <header class="article-header">
                <div class="container">
                    {% if exp_not(content.fields.title.empty) %}
                        <h2 class="title">{{ ng_render_field(content.fields.title) }}</h2>
                    {% endif %}
                </div>
            </header>
        {% endif %}

        {% set items = ngsite_group_fields(content, 'item') %}
        {% if items|count %}
            {% if (items|count)|gt(1) %}
                <div class="quote-swiper swiper"
                    data-effect="slide"
                    data-loop="true"
                    data-autoplay="5000"
                >
                    <div class="swiper-wrapper">
            {% endif %}
            {% for item in items %}
                {% if exp_or(exp_not(item.title.empty), exp_not(item.description.empty)) %}
                    <div class="swiper-slide">
                        <div class="container container-narrow">
                            {% if exp_or(exp_not(item.title.empty), exp_not(item.description.empty)) %}
                                <div class="quote-item">
                                    <img class="quote-icon" src="{{ asset('/images/quote.svg') }}" alt="" />
                                    {% if exp_and(is_set(item.title), exp_not(item.title.empty)) %}
                                        <h3 class="item-title">{{ ng_render_field(item.title) }}</h3>
                                    {% endif %}
                                    {% if exp_and(is_set(item.description), exp_not(item.description.empty)) %}
                                        <div class="item-short">
                                            {{ ng_render_field(item.description) }}
                                        </div>
                                    {% endif %}

                                    <div class="quote-person">
                                        {% if exp_not(item.person_image.empty) %}
                                            <div class="quote-person-image">
                                                {{ ng_render_field(item.person_image, {'parameters': {'alias': 'i160'}}) }}
                                            </div>
                                        {% endif %}
                                        {% if exp_or(exp_not(item.person_name.empty), exp_not(item.person_description.empty)) %}
                                            <div class="quote-person-info">
                                                {% if exp_not(item.person_name.empty) %}
                                                    <div class="quote-person-info-name">{{ item.person_name.value.text }}</div>
                                                {% endif %}
                                                {% if exp_not(item.person_description.empty) %}
                                                    {{ ng_render_field(item.person_description) }}
                                                {% endif %}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
            {% if (items|count)|gt(1) %}
                    </div>
                    <div class="swiper-button-prev"></div>
                    <div class="swiper-button-next"></div>
                </div>
            {% endif %}
        {% endif %}

    </article>
