{% set search = false %}
{% if use_template_search %}
    {% set page_limit = 10 %}
    {% set __switch1 = search_page_limit %}
{% if __switch1 == 1 %}
        {% set page_limit = 5 %}
    {% elseif __switch1 == 2 %}
        {% set page_limit = 10 %}
    {% elseif __switch1 == 3 %}
        {% set page_limit = 20 %}
    {% elseif __switch1 == 4 %}
        {% set page_limit = 30 %}
    {% elseif __switch1 == 5 %}
        {% set page_limit = 50 %}
    {% endif %}
    {% set search = fetch('content', 'search', {'text': search_text, 'section_id': search_section_id, 'subtree_array': search_sub_tree, 'class_id': search_contentclass_id, 'class_attribute_id': search_contentclass_attribute_id, 'offset': view_parameters.offset, 'publish_date': search_date, 'limit': page_limit}) %}
    {% set search_result = search.SearchResult %}
    {% set search_count = search.SearchCount %}
    {% set stop_word_array = search.StopWordArray %}
    {% set search_data = search %}
{% endif %}

<form action={{ '/content/advancedsearch/'|ezurl }} method="get" class="form-search exp-advanced-search">
    <header class="full-page-header full-search-header no-breadcrumbs">
        <div class="container">
            <div class="search-inputs">
                <h1 class="exp-advanced-search-title">{{ 'Advanced search'|i18n('design/ezwebin/content/advancedsearch') }}</h1>

                <div class="exp-advanced-search-fields">
                    <div class="exp-advanced-search-field exp-advanced-search-field-wide">
                        <label class="form-label" for="exp-adv-search-text">{{ 'Search all the words'|i18n('design/ezwebin/content/advancedsearch') }}</label>
                        <input class="form-control" type="text" id="exp-adv-search-text" name="SearchText" value="{{ full_search_text|wash }}" />
                    </div>

                    <div class="exp-advanced-search-field exp-advanced-search-field-wide">
                        <label class="form-label" for="exp-adv-search-phrase">{{ 'Search the exact phrase'|i18n('design/ezwebin/content/advancedsearch') }}</label>
                        <input class="form-control" type="text" id="exp-adv-search-phrase" name="PhraseSearchText" value="{{ phrase_search_text|wash }}" />
                    </div>

                    <div class="exp-advanced-search-field">
                        <label class="form-label" for="exp-adv-search-date">{{ 'Published'|i18n('design/ezwebin/content/advancedsearch') }}</label>
                        <select class="form-select" id="exp-adv-search-date" name="SearchDate">
                            <option value="-1" {% if eq(search_date, '-1') %}
selected="selected"{% endif %}
>{{ 'Any time'|i18n('design/ezwebin/content/advancedsearch') }}</option>
                            <option value="1" {% if eq(search_date, '1') %}
selected="selected"{% endif %}
>{{ 'Last day'|i18n('design/ezwebin/content/advancedsearch') }}</option>
                            <option value="2" {% if eq(search_date, '2') %}
selected="selected"{% endif %}
>{{ 'Last week'|i18n('design/ezwebin/content/advancedsearch') }}</option>
                            <option value="3" {% if eq(search_date, '3') %}
selected="selected"{% endif %}
>{{ 'Last month'|i18n('design/ezwebin/content/advancedsearch') }}</option>
                            <option value="4" {% if eq(search_date, '4') %}
selected="selected"{% endif %}
>{{ 'Last three months'|i18n('design/ezwebin/content/advancedsearch') }}</option>
                            <option value="5" {% if eq(search_date, '5') %}
selected="selected"{% endif %}
>{{ 'Last year'|i18n('design/ezwebin/content/advancedsearch') }}</option>
                        </select>
                    </div>

                    {% if use_template_search %}
                    <div class="exp-advanced-search-field">
                        <label class="form-label" for="exp-adv-search-limit">{{ 'Display per page'|i18n('design/ezwebin/content/advancedsearch') }}</label>
                        <select class="form-select" id="exp-adv-search-limit" name="SearchPageLimit">
                            <option value="1" {% if eq(search_page_limit, 1) %}
selected="selected"{% endif %}
>{{ '5 items'|i18n('design/ezwebin/content/advancedsearch') }}</option>
                            <option value="2" {% if exp_or((([1, 2, 3, 4, 5])|contains(search_page_limit))|exp_not, eq(search_page_limit, 2)) %}
selected="selected"{% endif %}
>{{ '10 items'|i18n('design/ezwebin/content/advancedsearch') }}</option>
                            <option value="3" {% if eq(search_page_limit, 3) %}
selected="selected"{% endif %}
>{{ '20 items'|i18n('design/ezwebin/content/advancedsearch') }}</option>
                            <option value="4" {% if eq(search_page_limit, 4) %}
selected="selected"{% endif %}
>{{ '30 items'|i18n('design/ezwebin/content/advancedsearch') }}</option>
                            <option value="5" {% if eq(search_page_limit, 5) %}
selected="selected"{% endif %}
>{{ '50 items'|i18n('design/ezwebin/content/advancedsearch') }}</option>
                        </select>
                    </div>
                    {% endif %}
                </div>

                {% for sub_tree in search_sub_tree %}
                <input type="hidden" name="SubTreeArray[]" value="{{ sub_tree }}" />
                {% endfor %}

                <div class="exp-advanced-search-actions">
                    <button type="submit" class="btn btn-dark" name="SearchButton" value="{{ 'Search'|i18n('design/ezwebin/content/advancedsearch') }}">{{ 'Search'|i18n('design/ezwebin/content/advancedsearch') }}<i class="icon-search" aria-hidden="true"></i></button>
                </div>

                {% if exp_or(search_text, eq(ezini('SearchSettings', 'AllowEmptySearch', 'site.ini'), 'enabled')) %}
                    {% if search_count|eq(0) %}
                        <div class="result-message result-message-error">
                            <p role="status" class="search-text">{{ 'No results were found when searching for "%1"'|i18n('design/ezwebin/content/advancedsearch', expvoid(), [search_text|wash]) }}</p>
                        </div>
                    {% else %}
                        <div class="result-message result-message-success">
                            <p role="status" class="search-text">{{ 'Search for "%1" returned %2 matches'|i18n('design/ezwebin/content/advancedsearch', expvoid(), [search_text|wash, search_count]) }}</p>
                        </div>
                    {% endif %}
                {% endif %}
            </div>
        </div>
    </header>

    <div class="full-search-results">
        <div class="container">
            {% if exp_and(exp_or(search_text, eq(ezini('SearchSettings', 'AllowEmptySearch', 'site.ini'), 'enabled')), search_result|count) %}
                <div id="search-result" class="search-result">
                    {% for search_item in search_result %}
                        {{ ng_view_content(search_item, 'search') }}
                    {% endfor %}
                </div>
            {% endif %}

            {% expinclude name='navigator' uri='design:navigator/google.tpl' page_uri='/content/advancedsearch' page_uri_suffix=(concat('?SearchText=', search_text|urlencode, '&PhraseSearchText=', phrase_search_text|urlencode, '&SearchContentClassID=', search_contentclass_id, '&SearchContentClassAttributeID=', search_contentclass_attribute_id, '&SearchSectionID=', search_section_id, (search_timestamp|gt(0))|choose('', concat('&SearchTimestamp=', search_timestamp)), (search_sub_tree|gt(0))|choose('', concat('&', 'SubTreeArray[]'|urlencode, '=', search_sub_tree|implode(concat('&', 'SubTreeArray[]'|urlencode, '=')))), '&SearchDate=', search_date, '&SearchPageLimit=', search_page_limit)) item_count=search_count view_parameters=view_parameters item_limit=page_limit %}
        </div>
    </div>
</form>
