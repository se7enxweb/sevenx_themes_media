{% if is_set(location) %}
    <div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    {% expinclude uri='design:content/parts/site_logo.tpl' %}
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|i18n('design/media/content') }}"></button>
                </div>
                <div class="modal-body">
                    {{ ng_view_content(content, 'payload', {'params': {'referer': first_set(referer, 'null'), 'class': 'embed-form'}}) }}
                </div>
            </div>
        </div>
    </div>{% else %}
    <!-- missing location -->{% endif %}
