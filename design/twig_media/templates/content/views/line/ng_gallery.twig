




{% set content_fields = [] %}
{% set toolbar_macros = [] %}
{% if exp_not(is_set(node)) %}
{% set node = false %}
{% endif %}
{% set node = fetch('content', 'node', {'node_id': location.node_id}) %}
<article {{ item_params(toolbar_macros, content, location) }} class="view-type view-type-{{ view_type }} ng-gallery vl4">
    <i class="icon-camera article-icon" aria-hidden="true"></i>

    {% set children = filterChildren(location, ['image'], 1) %}

    {% if (children|count)|gt(0) %}
        {% set gl_img_node = children[0] %}
        {% set gl_url = '' %}
        {% if exp_and(is_set(gl_img_node.data_map.image), gl_img_node.data_map.image.has_content) %}
            {% set gl_obj = gl_img_node.data_map.image.content %}
            {% if is_set(gl_obj.i320) %}
{% set gl_url = gl_obj.i320.url %}
            {% elseif is_set(gl_obj.large) %}
{% set gl_url = gl_obj.large.url %}
            {% elseif is_set(gl_obj.original) %}
{% set gl_url = gl_obj.original.url %}
{% endif %}
        {% endif %}
        {% if gl_url|ne('') %}
        <figure class="image">
            <a href={{ node.url_alias|ezurl }} title="{{ ('Read more about %name'|i18n('design/media/content', '', {'%name': node.name}))|wash }}"><img src={{ gl_url|ezroot }} loading="lazy" alt="" class="exp_image-field"></a>
        </figure>
        {% endif %}
        {% set gl_img_node = null %}
{% set gl_url = null %}
    {% endif %}
    <div class="article-content">
        <header class="article-header">
            <h3 class="title"><a href="{{ exp_path(location) }}">{{ title(content_fields, content) }}</a></h3>
        </header>
        {{ intro(content_fields, content) }}
    </div>
</article>{# exp:template:convert tpl->twig md5:2b54e40a442cab1e7b0686dc0f1d9df1 from templates/content/views/line/ng_gallery.tpl -- generated; a file changed by hand is not replaced without --force #}