



{% set toolbar_macros = [] %}
<article {{ item_params(toolbar_macros, content, location) }} class="view-type view-type-{{ view_type }} file vl4">
    <div class="article-content">
        <header class="article-header">
            <h2 class="title">
                <a href="{{ exp_path(location) }}">
                    {{ node.name|wash }}
                </a>
            </h2>
        </header>
    </div>
</article>{# exp:template:convert tpl->twig md5:eb5e805dc90b530ec57f48ad1866f60e from templates/content/views/line/file.tpl -- generated; a file changed by hand is not replaced without --force #}