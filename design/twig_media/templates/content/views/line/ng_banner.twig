{% if exp_not(is_set(node)) %}
{% set node = false %}
{% endif %}
{% set node = fetch('content', 'node', {'node_id': location.node_id}) %}
{% set bn_url = '' %}
{% if exp_and(is_set(node.data_map.image), node.data_map.image.has_content) %}
    {% set bn_img = node.data_map.image.content %}
    {% if is_set(bn_img.i480) %}
{% set bn_url = bn_img.i480.url %}
    {% elseif is_set(bn_img.large) %}
{% set bn_url = bn_img.large.url %}
    {% elseif is_set(bn_img.original) %}
{% set bn_url = bn_img.original.url %}
{% endif %}
    {% set bn_img = null %}
{% endif %}
<article data-item="true" data-content-id="{{ node.contentobject_id }}" data-location-id="{{ node.node_id }}" class="view-type view-type-{{ view_type }} ng-banner vl4">
    {% if bn_url|ne('') %}
    <figure class="image">
        <span><img src={{ bn_url|ezroot }} loading="lazy" alt="" class="exp_image-field" /></span>
    </figure>
    {% endif %}
    <div class="article-content">
        <header class="article-header">
            <h3 class="title">
                {{ node.name|wash }}
            </h3>
        </header>
        {{ intro('', content, 'description') }}
    </div>
</article>{% set bn_url = null %}
