




{% set content_fields = [] %}
{% set toolbar_macros = [] %}
<article {{ item_params(toolbar_macros, content, location) }} class="view-type view-type-{{ view_type }} {{ content.contentInfo.contentTypeIdentifier|ristring('_', '-') }} vl4">
    {{ image(content_fields, content, location, 'i320') }}

    <div class="article-content">
        <header class="article-header">
            <h2 class="title"><a href="{{ exp_path(location) }}">{{ title(content_fields, content) }}</a></h2>
        </header>
        <div class="short">
            {{ intro(content_fields, content) }}
        </div>
    </div>

</article>{# exp:template:convert tpl->twig md5:5fa384ad9543bc3d883814e60828efb4 from templates/content/views/line.tpl -- generated; a file changed by hand is not replaced without --force #}