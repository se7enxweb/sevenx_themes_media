




{% set content_fields = [] %}
{% set toolbar_macros = [] %}
{% if exp_not(content.fields.image.empty) %}
    <div {{ item_params(toolbar_macros, content, location) }} class="view-type view-type-{{ view_type }} ng-news vl3">
        {% set title = title(content_fields, content) %}

        <a href="{{ asset(ng_image_alias(content.fields.image, 'i1320')) }}" title="{{ title }}" class="js-lightbox-item" data-pswp-width="{{ content.fields.image.value.width }}" data-pswp-height="{{ content.fields.image.value.height }}">
            {{ ng_render_field(content.fields.image, {'parameters': {'alias': 'i1320', 'alt_text': title}}) }}
        </a>
    </div>{% endif %}
