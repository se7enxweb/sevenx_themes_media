{% set content_fields = [] %}
{% set link_title = 'Read more about %name'|i18n('design/media/content', '', {'%name': title(content_fields, content)}) %}
{% set short_text = '' %}
{% if exp_and(hasField(content, 'teaser_intro'), exp_not(content.fields.teaser_intro.empty)) %}
    {% set short_text = ((content.fields.teaser_intro.value.xml|strip_tags)|exp_trim)|shorten(210) %}
{% elseif exp_and(hasField(content, 'full_intro'), exp_not(content.fields.full_intro.empty)) %}
    {% set short_text = ((content.fields.full_intro.value.xml|strip_tags)|exp_trim)|shorten(210) %}
{% elseif exp_and(hasField(content, 'body'), exp_not(content.fields.body.empty)) %}
    {% set short_text = ((content.fields.body.value.xml|strip_tags)|exp_trim)|shorten(210) %}
{% endif %}
<article class="view-type view-type-search {{ content.contentInfo.contentTypeIdentifier|ristring('_', '-') }} vl7">
    <div class="article-content">
        <div class="article-content-text">
            <header class="article-header">
                <h2 class="title"><a href="{{ exp_path(location) }}" title="{{ link_title|wash }}">{{ title(content_fields, content) }}</a></h2>
                <div class="info">
                    {% expinclude uri='design:content/parts/time.tpl' %}
                    <span class="type">{{ content.contentInfo.contentTypeName }}</span>
                </div>
            </header>
            {% if short_text|ne('') %}
                <div class="short">{{ short_text }}</div>
            {% endif %}
        </div>

        {% set image_field = firstNonEmptyField(content, 'teaser_image', 'image') %}
        {% if exp_not(image_field.empty) %}
            <figure class="image">
                <a href="{{ exp_path(location) }}" class="ratio ratio-16x9" title="{{ link_title|wash }}">
                    {{ ng_render_field(image_field, {'parameters': {'alias': 'i480', 'alt_text': first_set(image_field.value.alternativeText, '')}}) }}
                </a>
            </figure>
        {% endif %}
    </div>
</article>
