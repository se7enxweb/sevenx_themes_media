




{% set toolbar_macros = [] %}
{% if exp_or(exp_not(content.fields.video_file.empty), exp_not(content.fields.video_identifier.empty)) %}
    <div {{ item_params(toolbar_macros, content, location) }} class="view-type view-type-{{ view_type }} ng-video vl3  {% if show_details_on_hover %}
show_details_on_hover{% endif %}
">
        {% if image_type|eq('main') %}
            {{ poster_slide(video, content, 'true') }}

            {% if show_details %}
                <div class="info">
                    <h2 class="title">
                        <a href={{ exp_path(location) }}>
                            {{ content.fields.title.value.text }}
                        </a>
                    </h2>
                </div>
            {% endif %}
        {% elseif image_type|eq('thumb') %}
            {{ poster_slide(video, content, 'false') }}
        {% endif %}
    </div>{% endif %}
