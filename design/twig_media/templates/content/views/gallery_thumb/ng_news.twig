





{% set content_fields = [] %}
{% set toolbar_macros = [] %}
<div {{ item_params(toolbar_macros, content, location) }} class="view-type view-type-{{ view_type }} ng-news vl3 {% if show_details_on_hover %}
show_details_on_hover{% endif %}
">
    {% if image_type|eq('main') %}
        {{ image(slide, content, 'image', 'i1320', 'true') }}

        {% if show_details %}
            <div class="info">
                <div class="date">
                    {% expinclude uri='design:content/parts/time.tpl' %}
                </div>
                <h2 class="title"><a href={{ exp_path(location) }}>{{ title(content_fields, content) }}</a></h2>
            </div>
        {% endif %}
    {% elseif image_type|eq('thumb') %}
        {{ image(slide, content, 'image', 'i320') }}
    {% endif %}
</div>{# exp:template:convert tpl->twig md5:811e6c9aeae664c1d153aa40c4e6e5de from templates/content/views/gallery_thumb/ng_news.tpl -- generated; a file changed by hand is not replaced without --force #}