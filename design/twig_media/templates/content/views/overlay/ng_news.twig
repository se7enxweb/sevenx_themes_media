




{% set content_fields = [] %}
{% set toolbar_macros = [] %}
{% if exp_not(is_set(node)) %}
{% set node = false %}
{% endif %}
{% set node = fetch('content', 'node', {'node_id': location.node_id}) %}

<article {{ item_params(toolbar_macros, content, location) }} class="view-type view-type-{{ view_type }} ng-news vl2">
    {% expinclude uri='design:content/parts/item_image.tpl' node=node %}

    <header class="article-header">
        <h3 class="title"><a href={{ node.url_alias|ezurl }}>{{ node.name|wash }}</a></h3>
        <div class="info">
            {% expinclude uri='design:content/parts/author.tpl' %}
            {% expinclude uri='design:content/parts/time.tpl' %}
        </div>
    </header>
</article>{# exp:template:convert tpl->twig md5:3f133a74e868e3c7aabe95ab83a4712e from templates/content/views/overlay/ng_news.tpl -- generated; a file changed by hand is not replaced without --force #}