




{% set content_fields = [] %}
{% set toolbar_macros = [] %}
<article {{ item_params(toolbar_macros, content, location) }} class="view-type view-type-{{ view_type }} ng-gallery vl5">
    {% set gl_children = fetch('content', 'list', {'parent_node_id': location.node_id, 'class_filter_type': 'include', 'class_filter_array': ['image'], 'limit': 1, 'sort_by': ['priority', true]}) %}
    {% if (gl_children|count)|gt(0) %}
        {% set gl_img_node = gl_children[0] %}
        {% set gl_url = '' %}
        {% if exp_and(is_set(gl_img_node.data_map.image), gl_img_node.data_map.image.has_content) %}
            {% set gl_obj = gl_img_node.data_map.image.content %}
            {% if is_set(gl_obj.i480) %}
{% set gl_url = gl_obj.i480.url %}
            {% elseif is_set(gl_obj.large) %}
{% set gl_url = gl_obj.large.url %}
            {% elseif is_set(gl_obj.original) %}
{% set gl_url = gl_obj.original.url %}
{% endif %}
            {% set gl_obj = null %}
        {% endif %}
        {% if gl_url|ne('') %}
        <figure class="image">
            <i class="icon-camera article-icon" aria-hidden="true"></i>
            <a href={{ node.url_alias|ezurl }} title="{{ gl_img_node.name|wash }}"><img src={{ gl_url|ezroot }} loading="lazy" alt="{{ gl_img_node.name|wash }}" class="exp_image-field" /></a>
        </figure>
        {% endif %}
        {% set gl_img_node = null %}
{% set gl_url = null %}
    {% endif %}
    {% set gl_children = null %}
    <header class="article-header">
        <h3 class="title"><a href={{ node.url_alias|ezurl }}>{{ title(content_fields, content) }}</a></h3>
    </header>
</article>{# exp:template:convert tpl->twig md5:6326e22bcb4c3e704a82751b79d6c88a from templates/content/views/mini/ng_gallery.tpl -- generated; a file changed by hand is not replaced without --force #}