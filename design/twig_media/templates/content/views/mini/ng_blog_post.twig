




{% set content_fields = [] %}
{% set toolbar_macros = [] %}
<article {{ item_params(toolbar_macros, content, location) }} class="view-type view-type-{{ view_type }} ng-blog-post vl5">
    {% expinclude uri='design:content/parts/item_image.tpl' node=node image_alias='i160' %}

    <header class="article-header">
        <h3 class="title"><a href="{{ exp_path(location) }}">{{ title(content_fields, content) }}</a></h3>
        <div class="info">
            {% expinclude uri='design:content/parts/author.tpl' %}
            {% expinclude uri='design:content/parts/time.tpl' %}
        </div>
    </header>
</article>{# exp:template:convert tpl->twig md5:e4c35658f7488a5c38f6cfc1328c68f1 from templates/content/views/mini/ng_blog_post.tpl -- generated; a file changed by hand is not replaced without --force #}