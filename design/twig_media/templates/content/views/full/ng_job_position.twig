{% set show_path = 'false' %}
{% set view_type = 'full' %}






{% set content_fields = [] %}
{% if exp_not(content.fields.teaser_intro.empty) %}
    {% set meta_data = {'description': (((saveXML(content.fields.teaser_intro.value.xml)|strip_tags)|exp_trim)|exp_u)[exp_truncate(152)]} %}
{% elseif exp_not(content.fields.full_intro.empty) %}
    {% set meta_data = {'description': (((saveXML(content.fields.full_intro.value.xml)|strip_tags)|exp_trim)|exp_u)[exp_truncate(152)]} %}
{% endif %}
{% explblock name='content' %}
    <article class="view-type view-type-{{ view_type }} ng-job-position vf1">
        {% explblock name='article_header' %}
            <header class="full-page-header">
                <div class="container">
                    <h1 class="full-page-title">{{ ng_render_field(content.fields.title) }}</h1>
                    <div class="full-page-info">
                        {% if exp_not(content.fields.job_location.empty) %}
                            <span>{{ ng_render_field(content.fields.job_location) }}</span>
                        {% endif %}
                        {% if exp_not(content.fields.engagement_type.empty) %}
                            <span>{{ ng_render_field(content.fields.engagement_type) }}</span>
                        {% endif %}
                        {% if exp_not(content.fields.application_deadline.empty) %}
                            <span>{{ 'ngsite.job_application.deadline'|trans }}: {{ ng_render_field(content.fields.application_deadline) }}</span>
                        {% endif %}
                    </div>
                </div>
            </header>
        {% endexplblock %}

        {% explblock name='article_media' %}
            {% if exp_not(content.fields.image.empty) %}
                <div class="full-page-image">
                    <div class="container container-wide">
                        {{ ng_render_field(content.fields.image) }}
                    </div>
                </div>
            {% endif %}
        {% endexplblock %}

        <div class="container container-narrow">
            {% explblock name='article_body' %}
                <div class="full-page-body">
                    {% if exp_not(content.fields.full_intro.empty) %}
                        <div class="full-page-intro">
                            {{ ng_render_field(content.fields.full_intro) }}
                        </div>
                    {% endif %}

                    {% if exp_not(content.fields.job_overview.empty) %}
                        <h3 class="job-details">{{ 'ngsite.job_application.job_overview'|trans }}</h3>
                        {{ ng_render_field(content.fields.job_overview) }}
                    {% endif %}

                    {% if exp_not(content.fields.requirements.empty) %}
                        <h3 class="job-details">{{ 'ngsite.job_application.requirements'|trans }}</h3>
                        {{ ng_render_field(content.fields.requirements) }}
                    {% endif %}

                    {% if exp_not(content.fields.responsibilities.empty) %}
                        <h3 class="job-details">{{ 'ngsite.job_application.responsibilities'|trans }}</h3>
                        {{ ng_render_field(content.fields.responsibilities) }}
                    {% endif %}
                </div>
            {% endexplblock %}
        </div>
    </article>{% endexplblock %}


    <script type="application/ld+json">
        {{ '{' }}            "@context": "http://schema.org",
            "@type": "Article",
            "headline": {{ content.fields.title.value.text|json_ld }},
            {% if content.contentInfo.publishedDate %}
"datePublished": {{ (content.contentInfo.publishedDate|exp_format_date)|json_ld }},
            {% endif %}
{% if exp_not(content.fields.image.empty) %}
                "image": {{ absolute_url(ng_image_alias(content.fields.image, 'i1320'))|json_ld }},
            {% endif %}
            
            {% if is_set(node) %}
{% set ld_license = xrowmetadata_license(node) %}
{% else %}
{% set ld_license = xrowmetadata_license() %}
{% endif %}
            {% if exp_and(ld_license, ld_license.show.json_ld) %}
{{ ld_license.json_ld_property }}{% endif %}
            {% set ld_license = null %}
            "publisher": {{ '{' }}                "@type": "Organization",
                "name": {{ site_name|json_ld }}
            }        }    </script>
