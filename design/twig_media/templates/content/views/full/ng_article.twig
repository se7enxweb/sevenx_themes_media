{% set ld_author_names = ld_author_names ?? null %}
{% set show_path = 'false' %}
{% set view_type = 'full' %}






{% set content_fields = [] %}
{% if exp_not(content.fields.teaser_intro.empty) %}
    {% set meta_data = {'description': (((saveXML(content.fields.teaser_intro.value.xml)|strip_tags)|exp_trim)|exp_u)[exp_truncate(152)]} %}
{% elseif exp_not(content.fields.full_intro.empty) %}
    {% set meta_data = {'description': (((saveXML(content.fields.full_intro.value.xml)|strip_tags)|exp_trim)|exp_u)[exp_truncate(152)]} %}
{% endif %}
{% explblock name='content' %}
    <article class="view-type view-type-{{ view_type }} ng-article" itemscope itemtype="http://schema.org/Article">
        {% explblock name='article_header' %}
            <header class="full-page-header">
                <div class="container">
                    {% expinclude uri='design:content/parts/main_topic.tpl' %}
                    <h1 class="full-page-title" itemprop="headline">{{ ng_render_field(content.fields.title) }}</h1>

                    <div class="full-page-info">
                        {% expinclude uri='design:content/parts/author.tpl' %}
                        {% expinclude uri='design:content/parts/time.tpl' %}
                    </div>
                </div>
            </header>
        {% endexplblock %}

        {% if exp_or(exp_not(content.fields.image.empty), exp_not(content.fields.related_multimedia.empty)) %}
            {% explblock name='article_media' %}
                <div class="full-page-image" itemprop="image">
                    <div class="container container-wide">
                        {{ render(controller('ngsite.controller.relations.related_multimedia_items', {'locationId': location.id, 'includeChildren': 'true', 'contentTypeIdentifiers': ['image', 'ng_video'], 'template': '@ibexadesign/content/parts/related_multimedia.html.twig'})) }}
                    </div>
                </div>
            {% endexplblock %}
        {% endif %}

        <div class="container container-narrow">

            {% explblock name='article_body' %}
                <div class="full-page-body" itemprop="articleBody">
                    {% if exp_not(content.fields.full_intro.empty) %}
                        <div class="full-page-intro" itemprop="description">
                            {{ ng_render_field(content.fields.full_intro) }}
                        </div>
                    {% endif %}

                    {% if exp_not(content.fields.body.empty) %}
                        {{ ng_render_field(content.fields.body) }}
                    {% endif %}

                    {% expinclude uri='design:content/parts/tags.tpl' %}
                </div>
            {% endexplblock %}

        </div>
    </article>{% endexplblock %}


    <script type="application/ld+json">
        {{ '{' }}            "@context": "http://schema.org",
            "@type": "Article",
            "headline": {{ content.fields.title.value.text|json_ld }},
            {% if content.contentInfo.publishedDate %}
                "datePublished": {{ (content.contentInfo.publishedDate|exp_format_date)|json_ld }},
            {% endif %}
            {% if exp_not(content.fields.authors.empty) %}
                "author": {{ '{' }}                    "@type": "Person",
                    {% set ld_author_names = [] %}
{% for author in fieldRelations(content, 'authors') %}
{% set ld_author_names = ld_author_names|append(author.name) %}
{% endfor %}
"name": {{ (ld_author_names|implode(', '))|json_ld }}{% set ld_author_names = null %}
                },
            {% endif %}
            {% if exp_not(content.fields.image.empty) %}
                "image": {{ absolute_url(ng_image_alias(content.fields.image, 'i1320'))|json_ld }},
            {% endif %}
            
            {% if is_set(node) %}
{% set ld_license = xrowmetadata_license(node) %}
{% else %}
{% set ld_license = xrowmetadata_license() %}
{% endif %}
            {% if exp_and(ld_license, ld_license.show.json_ld) %}
{{ ld_license.json_ld_property }}{% endif %}
            {% set ld_license = null %}
            "publisher": {{ '{' }}                "@type": "Organization",
                "name": {{ site_name|json_ld }}
            }        }    </script>
