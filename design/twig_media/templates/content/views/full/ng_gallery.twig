{% set show_path = 'false' %}
{% set view_type = 'full' %}




{% if exp_not(content.fields.teaser_intro.empty) %}
    {% set meta_data = {'description': (((saveXML(content.fields.teaser_intro.value.xml)|strip_tags)|exp_trim)|exp_u)[exp_truncate(152)]} %}
{% elseif exp_not(content.fields.description.empty) %}
    {% set meta_data = {'description': (((saveXML(content.fields.description.value.xml)|strip_tags)|exp_trim)|exp_u)[exp_truncate(152)]} %}
{% endif %}
{% explblock name='content' %}
    <div class="view-type view-type-{{ view_type }} ng-gallery">
        {% explblock name='article_header' %}
            <header class="full-page-header">
                <div class="container">
                    {% expinclude uri='design:content/parts/main_topic.tpl' %}

                    <h1 class="full-page-title">{{ ng_render_field(content.fields.title) }}</h1>

                    <div class="full-page-info">
                        {% expinclude uri='design:content/parts/time.tpl' %}
                    </div>
                </div>
            </header>
        {% endexplblock %}

        {% explblock name='article_media' %}
            <div class="full-page-image">
                <div class="container container-wide">
                    {{ render(controller('ngsite.controller.relations.related_multimedia_items', {'locationId': location.id, 'includeChildren': 'true', 'contentTypeIdentifiers': ['image', 'ng_video'], 'template': '@ibexadesign/content/parts/related_multimedia.html.twig'})) }}
                </div>
            </div>
        {% endexplblock %}

        <div class="container container-narrow">

            {% explblock name='article_body' %}
                <div class="full-page-body">
                    {% if exp_not(content.fields.teaser_intro.empty) %}
                        <div class="full-page-intro">
                            {{ ng_render_field(content.fields.teaser_intro) }}
                        </div>
                    {% endif %}

                    {% if exp_not(content.fields.description.empty) %}
                        {{ ng_render_field(content.fields.description) }}
                    {% endif %}

                    {% expinclude uri='design:content/parts/tags.tpl' %}
                </div>
            {% endexplblock %}

        </div>
    </div>{% endexplblock %}
