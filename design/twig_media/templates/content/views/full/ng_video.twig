{% set view_type = 'full' %}






{% if exp_not(content.fields.teaser_intro.empty) %}
    {% set meta_data = {'description': (((saveXML(content.fields.teaser_intro.value.xml)|strip_tags)|exp_trim)|exp_u)[exp_truncate(152)]} %}
{% endif %}
{% explblock name='content' %}
    <div class="view-type view-type-{{ view_type }} ng-video vf3">
        <div class="container">
            {% explblock name='article_media' %}
            <div class="full-video-player">
                {{ player(video, content) }}
            </div>
            {% endexplblock %}

            {% explblock name='article_header' %}
            <header class="full-video-header">
                <h1 class="title">{{ ng_render_field(content.fields.title) }}</h1>
                {% if content.contentInfo.publishedDate %}
                    <time>{{ content.contentInfo.publishedDate|exp_format_date }}</time>
                {% endif %}
            </header>
            {% endexplblock %}

            {% explblock name='article_body' %}
            {% if exp_not(content.fields.teaser_intro.empty) %}
                <div class="short">
                    {{ ng_render_field(content.fields.teaser_intro) }}
                </div>
            {% endif %}

            {% if exp_not(content.fields.description.empty) %}
                <div class="body">
                    {{ ng_render_field(content.fields.description) }}
                </div>
            {% endif %}
            {% endexplblock %}
        </div>
    </div>{% endexplblock %}
