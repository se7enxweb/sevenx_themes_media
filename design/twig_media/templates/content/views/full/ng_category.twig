{% set show_path = 'false' %}
{% set view_type = 'full' %}




{% if exp_not(content.fields.teaser_intro.empty) %}
    {% set meta_data = {'description': (((saveXML(content.fields.teaser_intro.value.xml)|strip_tags)|exp_trim)|exp_u)[exp_truncate(152)]} %}
{% elseif exp_not(content.fields.full_intro.empty) %}
    {% set meta_data = {'description': (((saveXML(content.fields.full_intro.value.xml)|strip_tags)|exp_trim)|exp_u)[exp_truncate(152)]} %}
{% endif %}
{% explblock name='content' %}
    <div class="view-type view-type-{{ view_type }} ng-category">

        {% explblock name='article_header' %}
        <header class="full-page-header text-center">
            <div class="container">
                <h1 class="full-page-title">{{ ng_render_field(content.fields.title) }}</h1>
                {% if exp_not(content.fields.full_intro.empty) %}
                    <div class="full-page-header-text">
                        <div class="row">
                            <div class="container container-narrow">
                                {{ ng_render_field(content.fields.full_intro) }}
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </header>
        {% endexplblock %}

        <div class="container">
            {% explblock name='article_body' %}
            {% if exp_not(content.fields.body.empty) %}
                <div class="full-page-body">
                    {{ ng_render_field(content.fields.body) }}
                </div>
            {% endif %}
            {% endexplblock %}

            {% set featured_locations = filterFieldRelationLocations(content, 'featured_content') %}
            {% if (featured_locations|count)|gt(0) %}
                <div class="category-featured-content">
                    {% for featured_location in featured_locations %}
                        {{ ng_view_content(featured_location, 'line') }}
                    {% endfor %}
                </div>
            {% endif %}

            {% if content.fields.show_children.value.bool %}
                {% set pager = ng_query('subtree') %}

                {% if (pager|count)|gt(0) %}
                    {% set children_view_type = first_set(content.fields.view_type.value.identifiers[0], 'standard') %}
                    {% set columns = first_set(content.fields.grid_columns.value.identifiers[0], '3') %}
                    {% set column_css_class = {'1': 'col-12', '2': 'col-sm-6', '3': 'col-md-4 col-sm-6', '4': 'col-lg-3 col-md-4 col-sm-6'} %}
                    <div class="category-children">
                        {% if children_view_type|eq('listitem') %}
                            <ul class="listitem-list">
                                {% for pager_item in pager %}
                                    <li>
                                        {{ ng_view_content(pager_item, children_view_type) }}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <div class="row">
                                {% for pager_item in pager %}
                                    <div class="{{ column_css_class[columns] }}">
                                        {{ ng_view_content(pager_item, children_view_type) }}
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                {% endif %}

                {% if haveToPaginate(pager) %}
                    {{ pagerfanta(pager, 'ngsite') }}
                {% endif %}
            {% endif %}
        </div>
    </div>{% endexplblock %}
