




{% set content_fields = [] %}
{% set toolbar_macros = [] %}
<article data-item="true" data-content-id="{{ node.contentobject_id }}" data-location-id="{{ node.node_id }}" class="view-type view-type-{{ view_type }} ng-audio vl6 t1">
    <h3 class="title">
        <a href={{ node.url_alias|ezurl }}>
            <i class="icon-volume-up article-icon" aria-hidden="true"></i>{{ title(content_fields, content) }}
        </a>
    </h3>

    {% if first_set(with_intro, 'false') %}
        {{ intro(content_fields, content) }}
    {% endif %}
</article>{# exp:template:convert tpl->twig md5:2ca142f2108f3601b9e15c3a6fc05df0 from templates/content/views/listitem/ng_audio.tpl -- generated; a file changed by hand is not replaced without --force #}