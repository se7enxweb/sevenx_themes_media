




{% set content_fields = [] %}
{% set toolbar_macros = [] %}
<article data-item="true" data-content-id="{{ node.contentobject_id }}" data-location-id="{{ node.node_id }}" class="view-type view-type-{{ view_type }} ng-article vl6">
    <h3 class="title"><a href={{ node.url_alias|ezurl }}>{{ title(content_fields, content) }}</a></h3>
    <div class="info">
        {% expinclude uri='design:content/parts/author.tpl' %}
    </div>

    {% if first_set(with_intro, 'false') %}
        {{ intro(content_fields, content) }}
    {% endif %}
</article>{# exp:template:convert tpl->twig md5:dec802604ca9bae61bfa0a5dadcce2e1 from templates/content/views/listitem/ng_article.tpl -- generated; a file changed by hand is not replaced without --force #}