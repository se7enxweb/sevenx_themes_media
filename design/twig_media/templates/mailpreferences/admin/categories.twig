{% expinclude uri='design:mailpreferences/parts/page_start.tpl' title=('E-mail preferences: categories'|i18n('design/admin/mailpreferences')) intro=('Each e-mail the system sends belongs to a category. People turn optional categories on and off on their preference page; essential ones are always sent and are listed there with their description.'|i18n('design/admin/mailpreferences')) crumb=false wide=true admin_tab='categories' %}
{% set source_names = {'ini': 'Settings file'|i18n('design/admin/mailpreferences'), 'admin': 'Made here'|i18n('design/admin/mailpreferences'), 'extension': 'Extension'|i18n('design/admin/mailpreferences')} %}
{% expinclude uri='design:mailpreferences/parts/notice.tpl' notice=(first_set(notice, false)) %}

<section class="mp-card mp-cats" aria-labelledby="mp-cats-title">
    <h2 id="mp-cats-title">{{ 'Categories'|i18n('design/admin/mailpreferences') }} <span class="acc-count">{{ categories|count }}</span></h2>
    <ul class="acc-session-list">{% for category in categories %}
        <li class="acc-session">
            <h3>{{ category.name|wash }} <code>{{ category.identifier|wash }}</code>
                {% if category.essential %}
<span class="mp-badge">{{ 'Essential, always sent'|i18n('design/admin/mailpreferences') }}</span>{% else %}
<span class="mp-badge on">{{ 'Optional, off until turned on'|i18n('design/admin/mailpreferences') }}</span>{% endif %}
</h3>{% if category.description|ne('') %}
            <p>{{ category.description|wash }}</p>{% endif %}
            <dl class="acc-facts">
                <dt>{{ 'How often'|i18n('design/admin/mailpreferences') }}</dt>
                <dd>{% if (category.frequencies|count)|gt(0) %}
{% for frequency in category.frequencies %}
{% if not loop.first %}
, {% endif %}
{% if is_set(frequency_names[frequency]) %}
{{ frequency_names[frequency] }}{% else %}
{{ frequency|wash }}{% endif %}
{% endfor %}
{% else %}
&mdash;{% endif %}
</dd>
                <dt>{{ 'Confirmation'|i18n('design/admin/mailpreferences') }}</dt>
                <dd>{% if category.double_opt_in %}
{{ 'Double opt-in'|i18n('design/admin/mailpreferences') }}{% else %}
&mdash;{% endif %}
</dd>
                <dt>{{ 'Defined in'|i18n('design/admin/mailpreferences') }}</dt>
                <dd>{% if is_set(source_names[category.source]) %}
{{ source_names[category.source] }}{% else %}
{{ category.source|wash }}{% endif %}
</dd>
            </dl>{% if category.editable %}
            <div class="mp-actions">
                <a class="mp-btn small outline" href={{ concat('mailpreferences/admin/categories/', category.identifier)|ezurl }}>{{ 'Edit'|i18n('design/admin/mailpreferences') }}<span class="mp-sr"> {{ category.name|wash }}</span></a>
            </div>{% endif %}
        </li>{% endfor %}
    </ul>
</section>
{% set values = cond(edit, edit, first_set(form, false), first_set(form, false), {'identifier': '', 'name': '', 'description': '', 'essential': false, 'frequencies': [], 'double_opt_in': false}) %}
<section class="mp-card" id="mp-category-form" aria-labelledby="mp-category-form-title">
    <h2 id="mp-category-form-title">{% if edit %}
{{ ('Edit "%name"'|i18n('design/admin/mailpreferences', expvoid(), {'%name': edit.name}))|wash }}{% else %}
{{ 'New category'|i18n('design/admin/mailpreferences') }}{% endif %}
</h2>{% if exp_and(edit, edit.source|ne('admin')) %}
    <p class="mp-lead">{{ ('This category is defined in %source. What you change here is stored in the database and shown instead; the identifier and the kind stay as they are defined.'|i18n('design/admin/mailpreferences', expvoid(), {'%source': cond(is_set(source_names[edit.source]), source_names[edit.source], edit.source)}))|wash }}</p>{% elseif edit|exp_not %}
    <p class="mp-lead">{{ 'A new category is optional: nobody receives it until they turn it on. Code sends e-mail in it with eZMail::setCategory( identifier ).'|i18n('design/admin/mailpreferences') }}</p>{% endif %}
    <form method="post" action={{ 'mailpreferences/admin/categories'|ezurl }}>{% if edit %}
        <input type="hidden" name="Identifier" value="{{ edit.identifier|wash }}" />
        <p class="mp-hint">{{ 'Identifier:'|i18n('design/admin/mailpreferences') }} <code>{{ edit.identifier|wash }}</code></p>{% else %}
        <div class="mp-field">
            <label for="mp-cat-identifier">{{ 'Identifier'|i18n('design/admin/mailpreferences') }}</label>
            <input type="text" id="mp-cat-identifier" name="Identifier" value="{{ values.identifier|wash }}" pattern="[a-z][a-z0-9_]*" maxlength="64" required="required" aria-describedby="mp-cat-identifier-hint" />
            <span class="mp-hint" id="mp-cat-identifier-hint">{{ 'Lower case letters, digits and underscores; it cannot be changed later.'|i18n('design/admin/mailpreferences') }}</span>
        </div>{% endif %}
        <div class="mp-field">
            <label for="mp-cat-name">{{ 'Name'|i18n('design/admin/mailpreferences') }}</label>
            <input type="text" id="mp-cat-name" name="Name" value="{{ values.name|wash }}" maxlength="255" required="required" />
        </div>
        <div class="mp-field">
            <label for="mp-cat-description">{{ 'Description, as people see it on their preference page'|i18n('design/admin/mailpreferences') }}</label>
            <textarea id="mp-cat-description" name="Description" rows="3">{{ values.description|wash }}</textarea>
        </div>{% if exp_or(edit|exp_not, edit.source|eq('admin')) %}
        <fieldset class="mp-fieldset">
            <legend>{{ 'How often people may choose to get it'|i18n('design/admin/mailpreferences') }}</legend>{% for frequency, label in frequency_names %}
            <label class="mp-check"><input type="checkbox" name="Frequencies[]" value="{{ frequency|wash }}"{% if values.frequencies|contains(frequency) %}
 checked="checked"{% endif %}
 /> <span>{{ label|wash }}</span></label>{% endfor %}
            <span class="mp-hint">{{ 'None ticked: it is sent when it happens, with no choice of frequency.'|i18n('design/admin/mailpreferences') }}</span>
        </fieldset>
        <label class="mp-check"><input type="checkbox" name="DoubleOptIn" value="1"{% if values.double_opt_in %}
 checked="checked"{% endif %}
 /> <span>{{ 'Ask for a confirmation by e-mail before the first message (double opt-in; use it for newsletters and marketing)'|i18n('design/admin/mailpreferences') }}</span></label>{% endif %}
        <div class="mp-actions">
            <input class="mp-btn primary" type="submit" name="{% if edit %}
StoreCategoryButton{% else %}
CreateCategoryButton{% endif %}
" value="{% if edit %}
{{ 'Save'|i18n('design/admin/mailpreferences') }}{% else %}
{{ 'Create category'|i18n('design/admin/mailpreferences') }}{% endif %}
" />{% if edit %}
            <a class="mp-btn outline" href={{ 'mailpreferences/admin/categories'|ezurl }}>{{ 'Cancel'|i18n('design/admin/mailpreferences') }}</a>{% if edit.source|ne('admin') %}
            <input class="mp-btn outline" type="submit" name="ResetCategoryButton" value="{{ 'Use the defined name and description again'|i18n('design/admin/mailpreferences') }}" />{% elseif edit.removable %}
            <input class="mp-btn danger" type="submit" name="RemoveCategoryButton" value="{{ 'Remove this category'|i18n('design/admin/mailpreferences') }}" />{% endif %}
{% endif %}
        </div>
    </form>
</section>{% set values = null %}
{% set source_names = null %}
{% expinclude uri='design:mailpreferences/parts/page_end.tpl' %}
