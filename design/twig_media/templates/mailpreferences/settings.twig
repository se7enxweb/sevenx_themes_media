{% if mode|eq('admin') %}
{% expinclude uri='design:mailpreferences/parts/page_start.tpl' title=('E-mail preferences of %name'|i18n('design/standard/mailpreferences', expvoid(), {'%name': user_name})) intro=('You are changing these preferences for the user. Each change is recorded as made by an administrator, with your name.'|i18n('design/standard/mailpreferences')) crumb=({'url': 'mailpreferences/admin/user', 'text': 'Find another user'|i18n('design/admin/mailpreferences')}) wide=false admin_tab='user' %}
{% else %}
{% expinclude uri='design:mailpreferences/parts/page_start.tpl' title=('E-mail preferences'|i18n('design/standard/mailpreferences')) intro=('Choose which e-mail you want from us. Essential messages about your account are always sent; everything else only if you want it.'|i18n('design/standard/mailpreferences')) crumb=false wide=false admin_tab=false %}
{% endif %}

    <p class="mp-for">{{ ('For: %email'|i18n('design/standard/mailpreferences', expvoid(), {'%email': email}))|wash }}{% if mode|eq('token') %}
    <br />{{ 'You opened this page with the personal link from one of our e-mails. Please do not forward that e-mail: the link lets anyone change these preferences.'|i18n('design/standard/mailpreferences') }}{% endif %}
{% if exp_and(mode|eq('account'), first_set(can_administrate, false)) %}
    &middot; <a href={{ 'mailpreferences/admin/status'|ezurl }}>{{ 'Administration'|i18n('design/standard/mailpreferences') }}</a>{% endif %}
    </p>
{% expinclude uri='design:mailpreferences/parts/preferences.tpl' %}
{% if exp_and(mode|eq('account'), first_set(notification_settings, false)) %}
    <div class="mp-card">
        <p class="mp-hint">{{ 'Which pages and items you follow is chosen in the notification settings; whether those notifications are sent at all is chosen here.'|i18n('design/standard/mailpreferences') }}</p>
        <div class="mp-actions"><a class="mp-btn outline small" href={{ 'notification/settings'|ezurl }}>{{ 'Notification settings'|i18n('design/standard/mailpreferences') }}</a></div>
    </div>{% endif %}
{% expinclude uri='design:mailpreferences/parts/page_end.tpl' %}
