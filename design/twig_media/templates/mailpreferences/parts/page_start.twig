
<header class="full-page-header acc-header text-center no-breadcrumbs">
    <div class="container">
        <h1 class="full-page-title">{{ title|wash }}</h1>{% if first_set(intro, false) %}
        <p class="full-page-header-text">{{ intro|wash }}</p>{% endif %}
    </div>
</header>

<div class="full-form-content acc-content{% if exp_or(first_set(wide, false), is_set(master)) %}
 acc-wide{% endif %}
">
    <div class="container">{% if first_set(crumb, false) %}
        <p class="acc acc-crumb"><a href={{ crumb.url|ezurl }}>{{ crumb.text|wash }}</a></p>{% endif %}
{% if first_set(admin_tab, false) %}
        {% expinclude uri='design:mailpreferences/parts/admin_tabs.tpl' current=admin_tab %}
{% endif %}
        <div class="mp mp-public mp-media">
