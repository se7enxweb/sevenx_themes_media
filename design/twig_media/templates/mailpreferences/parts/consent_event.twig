
<li class="acc-event{% if exp_or(row.action|eq('on'), row.action|eq('confirm'), row.action|eq('master_on'), row.action|eq('unsuppress')) %}
 is-ok{% elseif exp_or(row.action|eq('off'), row.action|eq('master_off'), row.action|eq('pending')) %}
 is-warn{% elseif exp_or(row.action|eq('suppress'), row.action|eq('erase')) %}
 is-bad{% endif %}
">
    <div class="acc-event-head">
        <p class="mp-event-what"><strong>{{ row.change|wash }}</strong> &middot; {{ row.category|wash }}</p>
        <span class="acc-when">{% if row.time %}
{{ row.time|l10n('shortdatetime') }}{% endif %}
</span>
    </div>
    <p class="acc-event-meta">{% if log %}
        <span>{{ 'Person'|i18n('design/admin/mailpreferences') }}: {% if row.user_id %}
<a href={{ concat('mailpreferences/admin/user/', row.user_id)|ezurl }}>{{ row.who|wash }}</a>{% else %}
{{ row.who|wash }}{% endif %}
{% if row.actor %}
 ({{ ('by %actor'|i18n('design/admin/mailpreferences', expvoid(), {'%actor': row.actor}))|wash }}){% endif %}
</span>{% endif %}
        <span>{{ 'Where'|i18n('design/standard/mailpreferences') }}: {{ row.source_name|wash }}</span>{% if exp_and(log, row.ip) %}
        <span>{{ 'IP address'|i18n('design/admin/mailpreferences') }}: <code>{{ row.ip|wash }}</code></span>{% endif %}
    </p>{% if row.wording|ne('') %}
    <blockquote class="mp-event-wording"><span class="acc-sr-only">{{ 'Text shown'|i18n('design/standard/mailpreferences') }}: </span>{{ row.wording|wash }}</blockquote>{% endif %}
</li>
