{% if is_set(field_errors) %}
    {% set pw_errors = field_errors %}
{% set pw_rules = password_rules %}
{% set pw_min = min_length %}
{% set pw_t = password_js_config.i18n %}
{% set pw_changed = password_changed %}
{% set pw_modern = true %}
{% else %}
    {% set pw_min = cond(ezini_hasvariable('UserSettings', 'MinPasswordLength'), ezini('UserSettings', 'MinPasswordLength'), 3) %}
{% set pw_errors = {'oldPassword': cond(oldPasswordNotValid, ['Your current password is not right. Type it again; it is the one you signed in with.'|i18n('design/media/user')], []), 'newPassword': cond(newPasswordTooShort, ['The new password is too short. Use at least %1 characters; a few words together are easy to remember and hard to guess.'|i18n('design/media/user', '', [pw_min])], []), 'confirmPassword': cond(newPasswordNotMatch, ['The two new passwords are not the same. Type the new password twice, exactly the same.'|i18n('design/media/user')], [])} %}
{% set pw_rules = [{'id': 'length', 'min': pw_min, 'failed': newPasswordTooShort, 'text': 'At least %1 characters.'|i18n('design/media/user', '', [pw_min])}] %}
{% set pw_t = {'show': '', 'ruleUnmet': '', 'strength': ''} %}
{% set pw_changed = exp_and(message, exp_not(exp_or(oldPasswordNotValid, newPasswordNotMatch, newPasswordTooShort))) %}
{% set pw_modern = false %}
{% endif %}
{% set pw_ids = {'oldPassword': 'password-old', 'newPassword': 'password-new', 'confirmPassword': 'password-confirm'} %}
{% set pw_first_error = cond(pw_errors.oldPassword|count, 'password-old', pw_errors.newPassword|count, 'password-new', pw_errors.confirmPassword|count, 'password-confirm', '') %}
<header class="full-page-header acc-header text-center no-breadcrumbs">
    <div class="container">
        <h1 class="full-page-title">{{ 'Change your password'|i18n('design/media/user') }}</h1>
    </div>
</header>

<div class="full-form-content acc-content">
    <div class="container acc acc-pw">
    {% if pw_changed %}
        <div class="acc-notice success" role="status">
            <div>
                <h2>{{ 'Your password has been changed'|i18n('design/media/user') }}</h2>
                <p>{{ 'You are still signed in here. Use the new password the next time you sign in.'|i18n('design/media/user') }}</p>
                {% if exp_or(exp_and(is_set(other_sessions_signed_out), other_sessions_signed_out), exp_and(is_set(sessions_ended), sessions_ended|gt(0))) %}
<p>{{ 'You were signed out on your other devices.'|i18n('design/media/user') }}</p>{% endif %}
                {% if exp_and(is_set(notification_sent), notification_sent) %}
<p>{{ 'We sent a confirmation to your e-mail address.'|i18n('design/media/user') }}</p>{% endif %}
            </div>
        </div>
        <div class="acc-actions">
            <a class="btn btn-primary" href={{ cond(is_set(redirect_uri), redirect_uri, '/user/edit')|ezurl }}>{{ 'Continue'|i18n('design/media/user') }}</a>
            <a class="btn btn-outline" href={{ '/user/edit'|ezurl }}>{{ 'My profile'|i18n('design/media/user') }}</a>
        </div>
    {% else %}
        <form action={{ concat(module.functions.password.uri, '/', userID)|ezurl }} method="post" name="Password" class="embed-form" novalidate{% if pw_modern %}
 data-exp-password-form data-exp-password-config="{{ password_js_config_json|wash }}"{% endif %}
>
        {% if pw_first_error %}
            <div class="acc-notice error acc-pw-summary" id="password-error-summary" role="alert" tabindex="-1" aria-labelledby="password-error-summary-title" data-exp-password-summary>
                <div>
                    <h2 id="password-error-summary-title">{{ 'Your password was not changed'|i18n('design/media/user') }}</h2>
                    <ul>
                    {% for pw_field, pw_id in pw_ids %}
{% for pw_text in pw_errors[pw_field] %}
                        <li><a href="#{{ pw_id }}">{{ pw_text|wash }}</a></li>
                    {% endfor %}
{% endfor %}
                    </ul>
                </div>
            </div>
        {% elseif exp_and(is_set(error_summary), error_summary|count) %}
            <div class="acc-notice error acc-pw-summary" id="password-error-summary" role="alert" tabindex="-1" data-exp-password-summary>
                <div>
                    <h2>{{ 'Your password was not changed'|i18n('design/media/user') }}</h2>
                    <ul>{% for pw_error in error_summary %}
<li>{{ pw_error.text|wash }}</li>{% endfor %}
</ul>
                </div>
            </div>
        {% elseif first_set(demo_mode_locked, false) %}
            
            <div class="acc-notice warning" role="status">
                <div><p>{{ demo_mode_text|wash }}</p></div>
            </div>
        {% elseif first_set(password_change_required, false) %}
            
            <div class="acc-notice warning" role="status">
                <div><p>{{ 'Choose a new password before you continue: an administrator asked you to replace the password you have now.'|i18n('design/standard/user/password') }}</p></div>
            </div>
        {% endif %}
            <div class="acc-card">
                <p class="acc-lead">{{ 'Signed in as %1.'|i18n('design/media/user', '', [userAccount.login|wash]) }}</p>

                <div class="form-group acc-pw-field{% if pw_errors.oldPassword|count %}
 has-error{% endif %}
">
                    <label for="password-old" class="form-label required">{{ 'Current password'|i18n('design/media/user') }}</label>
                    {% if pw_errors.oldPassword|count %}
<p class="acc-pw-error" id="password-old-error">{% for pw_text in pw_errors.oldPassword %}
<span>{{ pw_text|wash }}</span>{% endfor %}
</p>{% endif %}
                    <div class="acc-pw-row">
                        <input id="password-old" class="form-control{% if pw_errors.oldPassword|count %}
 is-invalid{% endif %}
" type="password" name="oldPassword" autocomplete="current-password" required data-exp-password="current"{% if pw_errors.oldPassword|count %}
 aria-invalid="true" aria-describedby="password-old-error"{% endif %}
{% if eq(pw_first_error, 'password-old') %}
 autofocus{% endif %}
 />
                        {% if pw_modern %}
<button type="button" class="btn btn-outline acc-pw-toggle" aria-controls="password-old" aria-pressed="false" data-exp-password-toggle="password-old" hidden><span data-exp-password-toggle-text>{{ pw_t.show|wash }}</span><span class="visually-hidden"> {{ 'current password'|i18n('design/media/user') }}</span></button>{% endif %}
                    </div>
                </div>

                <div class="form-group acc-pw-field{% if pw_errors.newPassword|count %}
 has-error{% endif %}
">
                    <label for="password-new" class="form-label required">{{ 'New password'|i18n('design/media/user') }}</label>
                    {% if pw_errors.newPassword|count %}
<p class="acc-pw-error" id="password-new-error">{% for pw_text in pw_errors.newPassword %}
<span>{{ pw_text|wash }}</span>{% endfor %}
</p>{% endif %}
                    <div class="acc-pw-row">
                        <input id="password-new" class="form-control{% if pw_errors.newPassword|count %}
 is-invalid{% endif %}
" type="password" name="newPassword" autocomplete="new-password" required minlength="{{ pw_min }}" data-exp-password="new" aria-describedby="{% if pw_errors.newPassword|count %}
password-new-error {% endif %}
password-new-rules"{% if pw_errors.newPassword|count %}
 aria-invalid="true"{% endif %}
{% if eq(pw_first_error, 'password-new') %}
 autofocus{% endif %}
 />
                        {% if pw_modern %}
<button type="button" class="btn btn-outline acc-pw-toggle" aria-controls="password-new" aria-pressed="false" data-exp-password-toggle="password-new" hidden><span data-exp-password-toggle-text>{{ pw_t.show|wash }}</span><span class="visually-hidden"> {{ 'new password'|i18n('design/media/user') }}</span></button>{% endif %}
                    </div>
                    <p class="acc-pw-rules-title" id="password-new-rules-title">{{ 'Your new password needs:'|i18n('design/media/user') }}</p>
                    <ul class="acc-pw-rules" id="password-new-rules" aria-labelledby="password-new-rules-title" data-exp-password-rules>
                    {% for pw_rule in pw_rules %}
                        <li data-exp-password-rule="{{ pw_rule.id|wash }}"{% if pw_rule.failed %}
 data-state="unmet" data-failed="true"{% endif %}
>{{ pw_rule.text|wash }}<span class="visually-hidden">, </span><span class="visually-hidden" data-exp-password-rule-state>{% if pw_rule.failed %}
{{ pw_t.ruleUnmet|wash }}{% endif %}
</span></li>
                    {% endfor %}
                    </ul>
                    {% if pw_modern %}
                    <div class="acc-pw-meter" data-exp-password-meter hidden>
                        <span class="acc-pw-meter-caption">{{ pw_t.strength|wash }}:</span>
                        <span class="acc-pw-meter-bar" aria-hidden="true"><span></span></span>
                        <span class="acc-pw-meter-text" data-exp-password-meter-text aria-live="polite"></span>
                    </div>
                    <p class="acc-pw-generate"><button type="button" class="btn btn-outline btn-sm-acc" data-exp-password-generate hidden>{{ 'Generate a strong password'|i18n('design/media/user') }}</button></p>
                    <p class="acc-pw-status" data-exp-password-status role="status" hidden></p>
                    {% endif %}
                </div>

                <div class="form-group acc-pw-field{% if pw_errors.confirmPassword|count %}
 has-error{% endif %}
">
                    <label for="password-confirm" class="form-label required">{{ 'New password again'|i18n('design/media/user') }}</label>
                    {% if pw_errors.confirmPassword|count %}
<p class="acc-pw-error" id="password-confirm-error">{% for pw_text in pw_errors.confirmPassword %}
<span>{{ pw_text|wash }}</span>{% endfor %}
</p>{% endif %}
                    <div class="acc-pw-row">
                        <input id="password-confirm" class="form-control{% if pw_errors.confirmPassword|count %}
 is-invalid{% endif %}
" type="password" name="confirmPassword" autocomplete="new-password" required data-exp-password="confirm"{% if pw_errors.confirmPassword|count %}
 aria-invalid="true" aria-describedby="password-confirm-error"{% endif %}
{% if eq(pw_first_error, 'password-confirm') %}
 autofocus{% endif %}
 />
                        {% if pw_modern %}
<button type="button" class="btn btn-outline acc-pw-toggle" aria-controls="password-confirm" aria-pressed="false" data-exp-password-toggle="password-confirm" hidden><span data-exp-password-toggle-text>{{ pw_t.show|wash }}</span><span class="visually-hidden"> {{ 'new password again'|i18n('design/media/user') }}</span></button>{% endif %}
                    </div>
                    {% if pw_modern %}
<p class="acc-pw-match" data-exp-password-match aria-live="polite" hidden></p>{% endif %}
                </div>

                <div class="acc-actions">
                    <input class="btn btn-primary" type="submit" name="OKButton" value="{{ 'Change password'|i18n('design/media/user') }}" />
                    <input class="btn btn-outline" type="submit" name="CancelButton" value="{{ 'Cancel'|i18n('design/media/user') }}" formnovalidate />
                </div>
            </div>
        {% if exp_and(is_set(redirect_if_discarded), redirect_if_discarded) %}
<input type="hidden" name="RedirectIfDiscarded" value="{{ redirect_if_discarded|wash }}" />{% endif %}
        </form>
        {% if pw_modern %}
{{ ezscript(['exp_password_field.js']) }}{% endif %}
    {% endif %}
    </div>
</div>{% set pw_errors = null %}
{% set pw_rules = null %}
{% set pw_min = null %}
{% set pw_t = null %}
{% set pw_changed = null %}
{% set pw_modern = null %}
{% set pw_ids = null %}
{% set pw_first_error = null %}
