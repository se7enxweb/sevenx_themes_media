{% set tv_tpl = tv_tpl ?? null %}

{% set tv_root = ezini('NodeSettings', 'RootNode', 'content.ini') %}
{% if exp_or(exp_not(tv_root), tv_root|eq('')) %}
    {% set tv_root = 2 %}
{% endif %}
{% set tv_limit = 10 %}
{% set tv_offset = first_set(view_parameters.offset, 0) %}
{% set tv_filter = {'id': 'TagsAttributeFilter', 'params': {'tag_id': tag.id, 'include_synonyms': true}} %}
{% set tv_nodes = fetch('content', 'tree', {'parent_node_id': tv_root, 'extended_attribute_filter': tv_filter, 'offset': tv_offset, 'limit': tv_limit, 'main_node_only': true, 'sort_by': [['published', false]]}) %}
{% set tv_count = fetch('content', 'tree_count', {'parent_node_id': tv_root, 'extended_attribute_filter': tv_filter, 'main_node_only': true}) %}

<article class="view-type view-type-full tag-view">
    <header class="full-page-header no-breadcrumbs text-center">
        <div class="container">
            <h1 class="full-page-title"><span class="exp_string-field">{{ tag.keyword|wash }}</span></h1>
        </div>
    </header>

    
    <div class="container">
        {% if (tv_nodes|count)|gt(0) %}
            <div class="category-children">
                <div class="row">
                    {% for tv_node in tv_nodes %}
                        <div class="col-sm-6 col-md-6 col-lg-4">
                            {% set tv_tpl = item_view_template('standard', tv_node.class_identifier) %}
                            {% if tv_tpl|ne('') %}
                                {% expinclude uri=(concat('design:', tv_tpl)) node=tv_node content=tv_node.object location=tv_node view_type='standard_with_intro' with_intro=1 %}
                            {% endif %}
                            {% set tv_tpl = null %}
                        </div>
                    {% endfor %}
                </div>
            </div>

            {% if tv_count|gt(tv_limit) %}
                {% expinclude uri='design:navigator/google.tpl' page_uri=(tag_url(tag.id)) item_count=tv_count view_parameters=view_parameters item_limit=tv_limit %}
            {% endif %}
        {% else %}
            <p class="no-results">{{ 'ngsite.tags.no_content'|trans }}</p>
        {% endif %}
    </div>
</article>
{% set tv_root = null %}
{% set tv_limit = null %}
{% set tv_offset = null %}
{% set tv_filter = null %}
{% set tv_nodes = null %}
{% set tv_count = null %}
