{% set el_layout = false %}
{% set el_node_id = 0 %}
{% set mp = module_params() %}
{% set el_use_layout = exp_and(is_set(mp.module_name), mp.module_name|eq('content'), is_set(mp.function_name), mp.function_name|eq('view'), is_set(mp.parameters.ViewMode), mp.parameters.ViewMode|eq('full')) %}
{% if el_use_layout %}
    {% if exp_and(is_array(module_result.content_info), is_set(module_result.content_info.node_id), module_result.content_info.node_id|gt(0)) %}
        {% set el_node_id = module_result.content_info.node_id %}
    {% elseif is_set(node.node_id) %}
        {% set el_node_id = node.node_id %}
    {% endif %}
    {% if el_node_id|gt(0) %}
        {% set el_layout = fetch('explayouts', 'resolve_layout_for_node', {'node_id': el_node_id}) %}
    {% else %}
        {% set el_layout = fetch('explayouts', 'resolve_layout', {}) %}
    {% endif %}
{% elseif exp_and(is_set(mp.module_name), mp.module_name|ne('')) %}
    
