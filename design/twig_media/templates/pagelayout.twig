{% set path_array = [] %}
{% if is_array(module_result.content_info) %}
    {% if is_set(module_result.content_info.node_id) %}
        {% if module_result.content_info.node_id|gt(0) %}
            {% set node = fetch('content', 'node', {'node_id': module_result.content_info.node_id}) %}
            {% if node %}
                {% set content = node.object %}
                
                
                {% for path_node in node.path %}
                    {% if path_node.depth|gt(1) %}
                        {% set path_array = path_array|append({'text': path_node.name, 'url': path_node.url_alias}) %}
