{% endif %}
{% set el_renderable_blocks = 0 %}
{% if exp_and(is_array(el_layout), is_set(el_layout.zones)) %}
    {% for el_zone in el_layout.zones %}
        {% if is_set(el_zone.blocks) %}
            {% for el_zone_block in el_zone.blocks %}
                {% if exp_and(el_zone_block.parent_id|eq(0), el_zone_block.definition_identifier|ne('')) %}
                    {% set el_renderable_blocks = el_renderable_blocks|sum(1) %}
                {% endif %}
            {% endfor %}
        {% endif %}
    {% endfor %}
{% endif %}
{% if exp_and(is_array(el_layout), el_renderable_blocks|gt(0)) %}
