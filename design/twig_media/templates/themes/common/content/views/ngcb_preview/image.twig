


<article class="view-type view-type-{{ view_type }} image vl1">
    <i class="icon-camera article-icon" aria-hidden="true"></i>
    <figure class="image">
        {{ ng_render_field(content.fields.image, {'parameters': {'alias': 'i480', 'alt_text': content.fields.name.value.text, 'link_href': exp_path(location), 'lazy_loading': 'false'}}) }}
    </figure>

    <header class="article-header">
        <h2 class="title"><a href="{{ exp_path(location) }}">{{ ng_render_field(content.fields.name) }}</a></h2>
    </header>
</article>{# exp:template:convert tpl->twig md5:9940af3e08d5b866ec52495a55e49110 from templates/themes/common/content/views/ngcb_preview/image.tpl -- generated; a file changed by hand is not replaced without --force #}