




<article class="view-type view-type-{{ view_type }} ng-recipe vl1">
    {{ image(content_fields, content, location, 'null', 'false') }}

    <header class="article-header">
        <h2 class="title"><a href="{{ exp_path(location) }}">{{ title(content_fields, content) }}</a></h2>
        <div class="info">
            {% if exp_not(content.fields.authors.empty) %}
                {% for author in fieldRelations(content, 'authors') %}
                    <a href="{{ exp_path(author) }}" class="article-author">{{ author.name }}</a>
                {% endfor %}
            {% endif %}
            {% if exp_not(content.fields.sponsored_content_disclosure.empty) %}
                <span class="sponsored-tag">{{ 'ngsite.layout.sponsored'|trans }}</span>
            {% elseif exp_not(content.fields.main_topic.empty) %}
                <a href={{ ngsite_topic_path(content.fields.main_topic.value.tags[0])|ezurl }}>{{ content.fields.main_topic.value.tags[0].keyword|wash }}</a>
            {% endif %}
            <span class="recipe-details">
                {% if exp_not(content.fields.preparation_time.empty) %}
                    <span><i class="icon-clock"></i> {{ ng_render_field(content.fields.preparation_time) }} {{ 'ngsite.layout.recipe.min'|trans }}</span>
                {% endif %}
                {% if exp_not(content.fields.serving_calories.empty) %}
                    <span><i class="icon-fire"></i> {{ ng_render_field(content.fields.serving_calories) }} {{ 'ngsite.layout.recipe.cal'|trans }}</span>
                {% endif %}
            </span>
        </div>
    </header>

    {{ intro(content_fields, content) }}
</article>{# exp:template:convert tpl->twig md5:bccd83ee2d7559379f14b82270576ef0 from templates/themes/common/content/views/ngcb_preview/ng_recipe.tpl -- generated; a file changed by hand is not replaced without --force #}