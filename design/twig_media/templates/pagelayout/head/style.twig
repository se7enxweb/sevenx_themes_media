{{ ezscript(['exp-color-mode.js']) }}

{% set media_css_own = ['inter.css', 'explayouts_standard/grid.css', 'index.css', 'index-noncritical.css', 'explayouts.css', 'shop.css', 'account.css', 'error-page.css', 'zoom-support.css', 'exp-youtube-consent.css', 'exp-cookie-consent.css', 'exp-header-menu.css', 'exp-advanced-search.css', 'exp-page-parts.css', 'exp-mobile-layout.css', 'exp-color-mode.css'] %}
{% set media_css_skip = cond(ezini_hasvariable('StylesheetSettings', 'MediaReplacedCSSFileList', 'design.ini'), ezini('StylesheetSettings', 'MediaReplacedCSSFileList', 'design.ini'), []) %}
{% set media_css_extra = [] %}
{% for media_css_setting in ['CSSFileList', 'FrontendCSSFileList'] %}
    {% if ezini_hasvariable('StylesheetSettings', media_css_setting, 'design.ini') %}
        {% for media_css_file in ezini('StylesheetSettings', media_css_setting, 'design.ini') %}
            {% if exp_and(media_css_file|ne(''), (media_css_own|contains(media_css_file))|exp_not, (media_css_skip|contains(media_css_file))|exp_not, (media_css_extra|contains(media_css_file))|exp_not) %}
                {% set media_css_extra = media_css_extra|append(media_css_file) %}
            {% endif %}
        {% endfor %}
    {% endif %}
{% endfor %}
{{ ezcss_load(media_css_own|exp_merge(media_css_extra)) }}{% set media_css_own = null %}
{% set media_css_skip = null %}
{% set media_css_extra = null %}
