<meta name="generator" content="{{ 'Exponential powered by 7x'|i18n('design/media/pagelayout') }}">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=2">
<meta name="theme-color" content="#ffffff">
{% set mt_meta = false %}
{% if node %}
    {% set mt_meta = metadata(node.node_id) %}
{% endif %}
{% set mt_description = '' %}
{% if mt_meta %}
    {% if mt_meta.description|ne('') %}
        {% set mt_description = mt_meta.description %}
    {% endif %}
{% endif %}
{% if mt_description|eq('') %}
    {% if node %}
        {% set mt_intro = firstNonEmptyField(node.object, 'teaser_intro', 'intro', 'description') %}
        {% if exp_not(mt_intro.empty) %}
            
            {% set mt_description = ((mt_intro.value.text|preg_replace('/<[^>]+>/', ' '))|simplify)|shorten(160) %}
        {% endif %}
        {% set mt_intro = null %}
    {% endif %}
{% endif %}

{% if mt_description|eq('') %}
    {% set mt_site_meta = ezini('SiteSettings', 'MetaDataArray') %}
    {% if exp_and(is_set(mt_site_meta.description), mt_site_meta.description|ne('')) %}
        {% set mt_description = mt_site_meta.description %}
    {% endif %}
    {% set mt_site_meta = null %}
{% endif %}
{% if mt_description|ne('') %}
<meta name="description" content="{{ mt_description|wash }}" />{% endif %}
{% if mt_meta %}
    {% if (mt_meta.keywords|count)|gt(0) %}
<meta name="keywords" content="{{ (mt_meta.keywords|implode(', '))|wash }}" />
    {% endif %}
    {% if mt_meta.canonical_url|ne('') %}
<link rel="canonical" href="{{ mt_meta.canonical_url|wash }}" />
    {% endif %}
    
    {% expinclude uri='design:xrowmetadata/opengraph_image.tpl' meta=mt_meta %}
{% endif %}
{% set mt_meta = null %}
{% set mt_description = null %}

{% if node %}
    {% set mt_license = xrowmetadata_license(node) %}
{% else %}
    {% set mt_license = xrowmetadata_license() %}
{% endif %}
{% expinclude uri='design:xrowmetadata/license_head.tpl' license=mt_license json_ld=false %}
{% set mt_license_ld = exp_and(mt_license, mt_license.show.json_ld) %}
{% set mt_last = (path_array|count)|sub(1) %}
<script type="application/ld+json">
{{ '{' }}
    "@context": "https://schema.org",{% if mt_license_ld %}
    "@graph": [
    {{ '{' }}{% endif %}
    "@type": "BreadcrumbList",
    "itemListElement": [
    {% for mt_index, mt_item in path_array %}
        {{ '{' }}            "@type": "ListItem",
            "name": {{ mt_item.text|json_ld }},
            {% if mt_item.url|ne('false') %}
"item": {{ concat('https://', ezini('SiteSettings', 'SiteURL'), '/', mt_item.url)|json_ld }},{% endif %}
            "position": {{ mt_index|sum(1) }}
        }{% if mt_index|lt(mt_last) %}
,{% endif %}
    {% endfor %}
    ]{% if mt_license_ld %}
    },
    {{ mt_license.json_ld_node }}
    ]{% endif %}
}
</script>{% set mt_last = null %}
{% set mt_license = null %}
{% set mt_license_ld = null %}
