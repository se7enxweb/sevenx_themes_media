{$bf_map = $node.object.data_map}
{$content = $node.object}
{$view_type = 'full'}
{explblock name='content'}
<article class="view-type view-type-full ng-blog-post vf1">
    {explblock name='article_header'}
    <header class="full-page-header">
        <div class="container">
            {expinclude uri='design:content/parts/main_topic.tpl' content=$node.object}
            <h1 class="full-page-title"><span class="exp_string-field">{if and(is_set($node.data_map.title), $node.data_map.title.has_content)}
{$node.data_map.title.content|wash}{else}
{$node.name|wash}{/if}
</span></h1>

            <div class="full-page-info">
                {expinclude uri='design:content/parts/author.tpl' content=$node.object node=$node}                {expinclude uri='design:content/parts/time.tpl'}            </div>
        </div>
    </header>
    {/explblock}

    {$bf_img_attr = false}
    {if and(is_set($bf_map.image), $bf_map.image.has_content)}
        {$bf_img_attr = $bf_map.image}
    {elseif and(is_set($bf_map.teaser_image), $bf_map.teaser_image.has_content)}
        {$bf_img_attr = $bf_map.teaser_image}
    {/if}
    {if $bf_img_attr}
    {$bf_img = $bf_img_attr.content}
    {$bf_url = ''}
    {if is_set($bf_img.i1320)}
{$bf_url = $bf_img.i1320.url}
    {elseif is_set($bf_img.large)}
{$bf_url = $bf_img.large.url}
    {elseif is_set($bf_img.original)}
{$bf_url = $bf_img.original.url}
{/if}
    {if $bf_url|ne:''}
    {explblock name='article_media'}
    <div class="full-page-image">
        <div class="container container-wide">
            <div>
                <figure class="image-wrapper">
                    <img src={$bf_url|ezroot} loading="lazy" alt="{$bf_img.alternative_text|wash}" />
                </figure>
            </div>
        </div>
    </div>
    {/explblock}
    {/if}
    {$bf_img = null}
{$bf_url = null}
    {/if}
    {$bf_img_attr = null}

    <div class="container container-narrow">
        {explblock name='article_body'}
        <div class="full-page-body">
            {if and(is_set($bf_map.full_intro), $bf_map.full_intro.has_content)}
            <div class="full-page-intro">
                <div class="exp_richtext-field">{attribute_view_gui attribute=$bf_map.full_intro}</div>
            </div>
            {/if}
            {if and(is_set($bf_map.body), $bf_map.body.has_content)}
            <div class="exp_richtext-field">{attribute_view_gui attribute=$bf_map.body}</div>
            {/if}
            {expinclude uri='design:content/parts/tags.tpl' content=$node.object node=$node}            <div class="sticky-sidebar-wrapper">
                <div class="sticky-sidebar">
                    <div class="sticky-sidebar-inner">
                        {expinclude uri='design:content/parts/social_share.tpl' content=$node.object node=$node}                    </div>
                </div>
            </div>
        </div>
        {/explblock}
    </div>
</article>{/explblock}
{$bf_map = null}
{$view_type = null}
{* exp:template:convert tpl->stpl md5:71011f38f19aca27168fdd89a298a550 from override/templates/node/view/full/full_ng_blog_post.tpl -- generated; a file changed by hand is not replaced without --force *}