






<article {item_params(null, $toolbar_macros, $content, $location)} class="view-type view-type-{$view_type} ng-recipe vl1">
    {image(null, $content_fields, $content, $location)}

    <header class="article-header">
        <h3 class="title"><a href="{exp_exp_path(null, $location)}">{title(null, $content_fields, $content)}</a></h3>
        <div class="info">
            {expinclude uri='design:content/parts/author.tpl'}
            <span class="recipe-details">
                {if not($content.fields.preparation_time.empty)}
                    <span><i class="icon-clock"></i> {ng_render_field(null, $content.fields.preparation_time)} {'ngsite.layout.recipe.min'|trans}</span>
                {/if}
                {if not($content.fields.serving_calories.empty)}
                    <span><i class="icon-fire"></i> {ng_render_field(null, $content.fields.serving_calories)} {'ngsite.layout.recipe.cal'|trans}</span>
                {/if}
            </span>
        </div>
    </header>

    {if first_set($with_intro, 'false')}
        {intro(null, $content_fields, $content)}
    {/if}
</article>{* exp:template:convert tpl->stpl md5:b9862f6269c955a05399f16b3dee8e23 from override/templates/node/view/standard/standard_ng_recipe.tpl -- generated; a file changed by hand is not replaced without --force *}