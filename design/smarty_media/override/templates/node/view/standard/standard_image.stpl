





<article {item_params(null, $toolbar_macros, $content, $location)} class="view-type view-type-{$view_type} image vl1">
    <i class="icon-camera article-icon" aria-hidden="true"></i>
    <figure class="image">
        {ng_render_field(null, $content.fields.image, ['parameters' => ['alias' => 'i480', 'alt_text' => $content.fields.name.value.text, 'link_href' => exp_exp_path(null, $location)]])}
    </figure>

    <header class="article-header">
        <h2 class="title"><a href="{exp_exp_path(null, $location)}">{ng_render_field(null, $content.fields.name)}</a></h2>
    </header>
</article>{* exp:template:convert tpl->stpl md5:41c1e2061a420a4f11b205fc3a6f3b1f from override/templates/node/view/standard/standard_image.tpl -- generated; a file changed by hand is not replaced without --force *}