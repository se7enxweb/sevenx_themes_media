






<article {item_params(null, $toolbar_macros, $content, $location)} class="view-type view-type-{$view_type} ng-news vl1">
    {image(null, $content_fields, $content, $location)}

    <header class="article-header">
        <h3 class="title"><a href="{exp_exp_path(null, $location)}">{title(null, $content_fields, $content)}</a></h3>
        <div class="info">
            {expinclude uri='design:content/parts/author.tpl'}            {expinclude uri='design:content/parts/time.tpl'}        </div>
    </header>

    {if first_set($with_intro, 'false')}
        {intro(null, $content_fields, $content)}
    {/if}
</article>{* exp:template:convert tpl->stpl md5:b14d9d324ef7726d2702e24fa1c0c6ea from override/templates/node/view/standard/standard_ng_news.tpl -- generated; a file changed by hand is not replaced without --force *}