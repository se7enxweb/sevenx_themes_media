






{if or(not($content.fields.video_file.empty), not($content.fields.video_identifier.empty))}
    <article {item_params(null, $toolbar_macros, $content, $location)} class="view-type view-type-{$view_type} ng-video vl1">
        <i class="icon-play article-icon" aria-hidden="true"></i>
        <figure class="image">
            {poster(null, $video, $content, $location, 'i480')}
        </figure>

        <header class="article-header">
            <h3 class="title"><a href="{exp_exp_path(null, $location)}">{title(null, $content_fields, $content)}</a></h3>
        </header>
        {if first_set($with_intro, 'false')}
            {intro(null, $content_fields, $content)}
        {/if}
    </article>{/if}
