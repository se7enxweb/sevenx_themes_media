





{$location_path = exp_exp_path(null, $location)}
{$children = filterChildren(null, $location, ['image'], 1)}

<article {item_params(null, $toolbar_macros, $content, $location)} class="view-type view-type-{$view_type} ng-gallery vl1">
    <i class="icon-camera article-icon" aria-hidden="true"></i>
    {if not(($children.searchHits|exp_count)|eq:0)}
        {$first_image = $children.0.content}

        <figure class="image">
            {ng_render_field(null, $first_image.fields.image, ['parameters' => ['alias' => 'i480', 'alt_text' => $first_image.fields.name.value, 'link_href' => $location_path]])}
        </figure>
    {/if}
    <header class="article-header">
        <h3 class="title"><a href="{$location_path}">{title(null, $content_fields, $content)}</a></h3>
    </header>

    {if first_set($with_intro, 'false')}
        {intro(null, $content_fields, $content)}
    {/if}
</article>{* exp:template:convert tpl->stpl md5:181a74c4c6e5717ddcd2e42074b04c2f from override/templates/node/view/standard/standard_ng_gallery.tpl -- generated; a file changed by hand is not replaced without --force *}