






<article {item_params(null, $toolbar_macros, $content, $location)} class="view-type view-type-{$view_type} ng-audio vl1">
    <i class="icon-volume-up article-icon" aria-hidden="true"></i>
    {image(null, $content_fields, $content, $location)}

    <header class="article-header">
        <h3 class="title">
            <a href="{exp_exp_path(null, $location)}">
                {title(null, $content_fields, $content)}
            </a>
        </h3>
    </header>

    {if first_set($with_intro, 'false')}
        {intro(null, $content_fields, $content)}
    {/if}
</article>{* exp:template:convert tpl->stpl md5:596a178b32293af36aa071bfb55f0cde from override/templates/node/view/standard/standard_ng_audio.tpl -- generated; a file changed by hand is not replaced without --force *}