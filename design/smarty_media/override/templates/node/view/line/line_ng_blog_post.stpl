






<article {item_params(null, $toolbar_macros, $content, $location)} class="view-type view-type-{$view_type} ng-blog-post vl4">
    {image(null, $content_fields, $content, $location, 'i320')}

    <div class="article-content">
        <header class="article-header">
            <h3 class="title"><a href="{exp_exp_path(null, $location)}">{title(null, $content_fields, $content)}</a></h3>
            <div class="info">
                {expinclude uri='design:content/parts/author.tpl'}                {expinclude uri='design:content/parts/time.tpl'}            </div>
        </header>
        {intro(null, $content_fields, $content)}
    </div>
</article>{* exp:template:convert tpl->stpl md5:3c662ea6aa0e5c35e3040009beb93c4d from override/templates/node/view/line/line_ng_blog_post.tpl -- generated; a file changed by hand is not replaced without --force *}