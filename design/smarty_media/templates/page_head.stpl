{$__loop4 = ($site.http_equiv)|expsectionloop:0:null:false}
{foreach $__loop4 as $HTTP__key => $HTTP__item}
{$HTTP__index = $HTTP__item@index}
{$HTTP__number = $HTTP__item@iteration}
<meta http-equiv="{$HTTP__key|wash}" content="{$HTTP__item|wash}" />
    {/foreach}

    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />

    {$__loop5 = ($site.meta)|expsectionloop:0:null:false}
{foreach $__loop5 as $meta__key => $meta__item}
