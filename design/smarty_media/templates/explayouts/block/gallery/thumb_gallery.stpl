{if ($block.values.items|exp_count)|gt:0}
<div class="thumb-swiper">
    <div class="gallery-top swiper"
        data-effect="{first_set($block.parameters.transition, 'slide')}"
        data-length="{$block.values.items|exp_count}"
    >
        <div class="swiper-wrapper">
            {foreach $block.values.items as $tg_entry}
{$tg_node = $tg_entry.node}
            <div class="swiper-slide">
                {expinclude uri='design:explayouts/block/gallery/_thumb_slide.tpl' node=$tg_node alias='i1320' show_info=1}            </div>
            {$tg_node = null}
{/foreach}
        </div>
        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
    </div>
    <div class="swiper gallery-thumbs">
        <div class="swiper-wrapper">
            {foreach $block.values.items as $tg_entry}
{$tg_node = $tg_entry.node}
            <div class="swiper-slide">
                {expinclude uri='design:explayouts/block/gallery/_thumb_slide.tpl' node=$tg_node alias='i320' show_info=0}            </div>
            {$tg_node = null}
{/foreach}
        </div>
    </div>
</div>{/if}
{* exp:template:convert tpl->stpl md5:6b7259765cd4aced5dc712f3f95c7eb9 from templates/explayouts/block/gallery/thumb_gallery.tpl -- generated; a file changed by hand is not replaced without --force *}