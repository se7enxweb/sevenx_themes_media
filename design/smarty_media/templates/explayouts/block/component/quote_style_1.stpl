<article class="view-component view-component-quote quote-style-1">
    <div class="quote-swiper swiper"
        data-effect="slide"
        data-loop="true"
        data-autoplay="5000"
    >
        <div class="swiper-wrapper">
            {$qs_map = $cmp.data_map}
            {foreach exprange(1, 8) as $qs_idx}
                {$qs_title = $qs_map[(concat('item_', $qs_idx, '_title'))]}
                {if and(is_set($qs_title), $qs_title.has_content)}
                <div class="swiper-slide">
                    <div class="container container-narrow">
                        <div class="quote-item">
                            <img class="quote-icon" src={'images/quote.svg'|ezdesign:'no'} alt="" />
                            <h3 class="item-title">                <span         class="exp_string-field" >{$qs_title.content|wash}</span>
</h3>
                            {$qs_desc = $qs_map[(concat('item_', $qs_idx, '_description'))]}
                            {if and(is_set($qs_desc), $qs_desc.has_content)}
                            <div class="item-short">
                                <div         class="exp_richtext-field" >{attribute_view_gui attribute=$qs_desc}</div>
                            </div>
                            {/if}
                            {$qs_desc = null}
                            <div class="quote-person">
                                {$qs_pimg_attr = $qs_map[(concat('item_', $qs_idx, '_person_image'))]}
                                {if and(is_set($qs_pimg_attr), $qs_pimg_attr.has_content)}
                                {$qs_pimg = $qs_pimg_attr.content}
                                {$qs_purl = ''}
                                {if is_set($qs_pimg.i160)}
{$qs_purl = $qs_pimg.i160.url}
                                {elseif is_set($qs_pimg.original)}
{$qs_purl = $qs_pimg.original.url}
{/if}
                                {if $qs_purl|ne:''}
                                <div class="quote-person-image">
                                    <img
            src={$qs_purl|ezroot}
            loading="lazy"                                                alt=""
                    class="exp_image-field"  />
                                </div>
                                {/if}
                                {$qs_pimg = null}
{$qs_purl = null}
                                {/if}
                                {$qs_pimg_attr = null}
                                <div class="quote-person-info">
                                    {$qs_pname = $qs_map[(concat('item_', $qs_idx, '_person_name'))]}
                                    {if and(is_set($qs_pname), $qs_pname.has_content)}
                                    <div class="quote-person-info-name">{$qs_pname.content|wash}</div>
                                    {/if}
                                    {$qs_pname = null}
                                    {$qs_pdesc = $qs_map[(concat('item_', $qs_idx, '_person_description'))]}
                                    {if and(is_set($qs_pdesc), $qs_pdesc.has_content)}
                                    <span         class="exp_string-field" >{$qs_pdesc.content|wash}</span>
                                    {/if}
                                    {$qs_pdesc = null}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {/if}
                {$qs_title = null}
            {/foreach}
            {$qs_map = null}
        </div>
        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
    </div>
</article>
{* exp:template:convert tpl->stpl md5:fd6078f0b679008415c49413576a35d7 from templates/explayouts/block/component/quote_style_1.tpl -- generated; a file changed by hand is not replaced without --force *}