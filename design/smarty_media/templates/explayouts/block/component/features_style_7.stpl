    <article class="view-component view-component-features features-style-7">
        {expinclude uri='design:explayouts/block/component/_features_header.tpl' cmp=$cmp}        <div class="list-zigzag">
            {$fz_map = $cmp.data_map}
            {foreach exprange(1, 8) as $fz_idx}
                {$fz_title = $fz_map[(concat('item_', $fz_idx, '_title'))]}
                {if and(is_set($fz_title), $fz_title.has_content)}
                <div class="list-item">
                    <div class="view-type view-type-zigzag vl9">
                        {$fz_link = false}
                        {$fz_link_attr = $fz_map[(concat('item_', $fz_idx, '_link'))]}
                        {if is_set($fz_link_attr)}
{$fz_link = enhanced_link(null, $fz_link_attr)}
{/if}
                        {$fz_img_attr = $fz_map[(concat('item_', $fz_idx, '_image'))]}
                        {if and(is_set($fz_img_attr), $fz_img_attr.has_content)}
                        {$fz_img = $fz_img_attr.content}
                        {$fz_url = ''}
                        {if is_set($fz_img.i770)}
{$fz_url = $fz_img.i770.url}
                        {elseif is_set($fz_img.large)}
{$fz_url = $fz_img.large.url}
                        {elseif is_set($fz_img.original)}
{$fz_url = $fz_img.original.url}
{/if}
                        {if $fz_url|ne:''}
                        <figure class="image">
                            {if $fz_link}
<a href="{$fz_link.href|wash}" tabindex="-1" aria-hidden="true">{/if}
<img src={$fz_url|ezroot} loading="lazy" alt="{$fz_img.alternative_text|wash}" class="exp_image-field" />{if $fz_link}
</a>{/if}
                        </figure>
                        {/if}
                        {$fz_img = null}
{$fz_url = null}
                        {/if}
                        {$fz_img_attr = null}
                        <div class="article-content">
                            <header class="article-header">
                                {$fz_hl = $fz_map[(concat('item_', $fz_idx, '_highlight_title'))]}
                                {if and(is_set($fz_hl), $fz_hl.has_content)}
                                <span class="eyebrow-title">{$fz_hl.content|wash}</span>
                                {/if}
                                {$fz_hl = null}
                                {if $fz_link}
                                <h3 class="title"><a href="{$fz_link.href|wash}"
                >
    {$fz_title.content|wash}
            </a></h3>
                                {else}
                                <h3 class="title">{$fz_title.content|wash}</h3>
                                {/if}
                            </header>
                            {$fz_short = $fz_map[(concat('item_', $fz_idx, '_description'))]}
                            {if and(is_set($fz_short), $fz_short.has_content)}
                            <div class="short">
                                <div         class="exp_richtext-field" >{attribute_view_gui attribute=$fz_short}</div>
                            </div>
                            {/if}
                            {$fz_short = null}
                            {if $fz_link}
                            <div class="actions">
                                {expinclude uri='design:explayouts/block/component/_link.tpl' link=$fz_link btn_class='btn btn-link'}                            </div>
                            {/if}
                            {$fz_link = null}
{$fz_link_attr = null}
                        </div>
                    </div>
                </div>
                {/if}
                {$fz_title = null}
            {/foreach}
            {$fz_map = null}
        </div>
    </article>
{* exp:template:convert tpl->stpl md5:57e06f3a9e9588720b93c199f51bb390 from templates/explayouts/block/component/features_style_7.tpl -- generated; a file changed by hand is not replaced without --force *}