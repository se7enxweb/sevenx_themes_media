{$cp_map = $cmp.data_map}
{if and(is_set($cp_map.image), $cp_map.image.has_content)}
{$cp_img = $cp_map.image.content}
{$cp_srcset = ''}
{$cp_src = ''}
{$cp_srcset_alias = first_set($srcset_alias, 'original')}
{$cp_src_alias = first_set($src_alias, 'i1920')}
{$cp_focal = exp_exp_focal_point(null, $cp_img, $cp_src_alias)}
{$cp_aliases = [$cp_srcset_alias]}
{if $cp_srcset_alias|ne:'original'}
{$cp_aliases = $cp_aliases|append:'large'}
{/if}
{if $cp_srcset_alias|ne:'large'}
{$cp_aliases = $cp_aliases|append:'large'}
{/if}
{$cp_aliases = $cp_aliases|append:'original'}
{foreach $cp_aliases as $cp_alias}
    {if and($cp_srcset|eq:'', is_set($cp_img[$cp_alias]))}
{$cp_srcset = $cp_img[$cp_alias].url}
{/if}
{/foreach}
{$cp_src_aliases = [$cp_src_alias, 'large', 'original']}
{foreach $cp_src_aliases as $cp_alias}
    {if and($cp_src|eq:'', is_set($cp_img[$cp_alias]))}
{$cp_src = $cp_img[$cp_alias].url}
{/if}
{/foreach}
{if and($cp_srcset|ne:'', $cp_src|ne:'')}
<picture{if (first_set($pic_class, ''))|ne:''}
 class="{$pic_class}"{/if}
>
    <source media="(min-width: 992px)" srcset={$cp_srcset|ezroot}>
    <img
    src={$cp_src|ezroot}
    alt="{$cp_img.alternative_text|wash}"
    class="exp_image-field"{if $cp_focal}
 data-focal-x="{$cp_focal.x}" data-focal-y="{$cp_focal.y}"{/if}
  />
</picture>{/if}
{$cp_img = null}
{$cp_srcset = null}
{$cp_src = null}
{$cp_srcset_alias = null}
{$cp_src_alias = null}
{$cp_aliases = null}
{$cp_src_aliases = null}
{$cp_focal = null}
{/if}
{$cp_map = null}
