<article class="view-component view-component-about about-style-3">
    <div class="row">
        <header class="article-header col-lg-6 mb-3 mb-lg-0">
            {expinclude uri='design:explayouts/block/component/_picture.tpl' cmp=$cmp pic_class='image'}            {expinclude uri='design:explayouts/block/component/_about_eyebrow_title.tpl' cmp=$cmp}        </header>
        <div class="article-info col-lg-5 offset-lg-1">
            {expinclude uri='design:explayouts/block/component/_about_short.tpl' cmp=$cmp}            {if or($cmp.data_map.description.has_content, $cmp.data_map.description_2.has_content)}
                {expinclude uri='design:explayouts/block/component/_about_actions.tpl' cmp=$cmp btn_class='btn btn-primary'}            {/if}
        </div>
    </div>
</article>
{* exp:template:convert tpl->stpl md5:c1c5a93767d19378103ac31c9029c46b from templates/explayouts/block/component/about_style_3.tpl -- generated; a file changed by hand is not replaced without --force *}