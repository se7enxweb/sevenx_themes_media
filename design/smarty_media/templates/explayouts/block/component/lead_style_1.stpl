<article class="view-component view-component-lead lead-style-1">
    <header class="article-header">
        {if and(is_set($cmp.data_map.title), $cmp.data_map.title.has_content)}
        <h2 class="title">
            <span         class="exp_string-field" >{$cmp.data_map.title.content|wash}</span>
        </h2>
        {/if}
    </header>
    <div class="article-info">
        {expinclude uri='design:explayouts/block/component/_about_short.tpl' cmp=$cmp}        {expinclude uri='design:explayouts/block/component/_lead_action.tpl' cmp=$cmp}    </div>
</article>
