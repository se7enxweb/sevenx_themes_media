{$tc_left_class = 'col-md-8'}
{$tc_right_class = 'col-md-4'}
{if $block.view_type|eq:'two_columns_33_66'}
    {$tc_left_class = 'col-md-4'}
    {$tc_right_class = 'col-md-8'}
{elseif or($block.view_type|eq:'two_columns_50_50', $block.view_type|eq:'two_columns_50_50_1')}
    {$tc_left_class = 'col-md-6'}
    {$tc_right_class = 'col-md-6'}
{/if}

<div class="row">
    <div class="{$tc_left_class}">
    {foreach $zone.blocks as $tc_child}
        {if and($tc_child.parent_id|eq:$block.id, $tc_child.placeholder|eq:'left', $tc_child.definition_identifier|ne:'')}
            {expinclude uri='design:explayouts/block/block.tpl' name='tcblock' block=$tc_child zone=$zone module_result=$module_result}        {/if}
    {/foreach}
    </div>
    <div class="{$tc_right_class}">
    {foreach $zone.blocks as $tc_child}
        {if and($tc_child.parent_id|eq:$block.id, $tc_child.placeholder|eq:'right', $tc_child.definition_identifier|ne:'')}
            {expinclude uri='design:explayouts/block/block.tpl' name='tcblock' block=$tc_child zone=$zone module_result=$module_result}        {/if}
    {/foreach}
    </div>
</div>
{$tc_left_class = null}
{$tc_right_class = null}
{* exp:template:convert tpl->stpl md5:4519f1bd6e8a8f9a2f0df62c3eaf1d98 from templates/explayouts/block/two_columns.tpl -- generated; a file changed by hand is not replaced without --force *}