            {expinclude uri=(concat('design:', $gc_tpl)) node=$node content=$node.object location=$node view_type=(first_set($view_type_label, $gc_view)) with_intro=(first_set($with_intro, 0))}        {/if}
    </div>{/foreach}
</div>{$gc_view = null}
