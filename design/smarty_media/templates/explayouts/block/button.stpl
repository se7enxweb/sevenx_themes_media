{if and($block.values.text|ne:'', $block.values.link|ne:'')}
        <a href={$block.values.link|ezurl}
                             class="{$block.values.class|wash}"
                    >
                        {(layout_title(null, $block.values.text))|wash}
    </a>{elseif $block.values.text|ne:''}
        <span class="{$block.values.class|wash}">{(layout_title(null, $block.values.text))|wash}</span>{/if}
