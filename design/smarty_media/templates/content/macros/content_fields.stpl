

    {$alias_name = expvoid()}
    {$lazy_loading = expvoid()}

    {$image_field = firstNonEmptyField(null, $content, 'teaser_image', 'image')}

    {if not($image_field.empty)}
        <figure class="image">
            {expvoid()}
        </figure>
    {/if}




    {$title = firstNonEmptyField(null, $content, 'teaser_title', 'title', 'name')}
    {if not($title.empty)}
        {$title.value.text}
    {else}
        {$content.name}
    {/if}




