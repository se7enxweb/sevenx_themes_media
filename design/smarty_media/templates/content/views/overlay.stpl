





{$content_fields = []}
{$toolbar_macros = []}
<article {item_params(null, $toolbar_macros, $content, $location)} class="view-type view-type-{$view_type} {$content.contentInfo.contentTypeIdentifier|ristring:'_':'-'} vl2">
    {image(null, $content_fields, $content, $location, 'null', 'null')}

    <header class="article-header">
        <h2 class="title"><a href="{exp_exp_path(null, $location)}">{title(null, $content_fields, $content)}</a></h2>
    </header>
</article>{* exp:template:convert tpl->stpl md5:ac7016b655006d7b22e61e26d8c4bdf1 from templates/content/views/overlay.tpl -- generated; a file changed by hand is not replaced without --force *}