





{$toolbar_macros = []}
<article data-item="true" data-content-id="{$node.contentobject_id}" data-location-id="{$node.node_id}" class="view-type view-type-{$view_type} ng-banner vl6">
    <h3 class="title">
        {$node.name|wash}
    </h3>
    {if first_set($with_intro, 'false')}
        {intro(null, '', $content, 'description')}
    {/if}
</article>{* exp:template:convert tpl->stpl md5:70408cb2c790e03cbb3b63790c1293e1 from templates/content/views/listitem/ng_banner.tpl -- generated; a file changed by hand is not replaced without --force *}