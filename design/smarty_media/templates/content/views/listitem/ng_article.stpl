





{$content_fields = []}
{$toolbar_macros = []}
<article data-item="true" data-content-id="{$node.contentobject_id}" data-location-id="{$node.node_id}" class="view-type view-type-{$view_type} ng-article vl6">
    <h3 class="title"><a href={$node.url_alias|ezurl}>{title(null, $content_fields, $content)}</a></h3>
    <div class="info">
        {expinclude uri='design:content/parts/author.tpl'}    </div>

    {if first_set($with_intro, 'false')}
        {intro(null, $content_fields, $content)}
    {/if}
</article>{* exp:template:convert tpl->stpl md5:78ad0a5d84679de6f927c6f8d6248d0b from templates/content/views/listitem/ng_article.tpl -- generated; a file changed by hand is not replaced without --force *}