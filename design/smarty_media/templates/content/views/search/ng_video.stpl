{$content_fields = []}
{$link_title = 'Read more about %name'|i18n:'design/media/content':'':(['%name' => title(null, $content_fields, $content)])}
{$short_text = ''}
{if and(hasField(null, $content, 'teaser_intro'), not($content.fields.teaser_intro.empty))}
    {$short_text = (($content.fields.teaser_intro.value.xml|exp_strip_tags)|trim)|shorten:210}
{elseif and(hasField(null, $content, 'full_intro'), not($content.fields.full_intro.empty))}
    {$short_text = (($content.fields.full_intro.value.xml|exp_strip_tags)|trim)|shorten:210}
{elseif and(hasField(null, $content, 'body'), not($content.fields.body.empty))}
    {$short_text = (($content.fields.body.value.xml|exp_strip_tags)|trim)|shorten:210}
{/if}
<article class="view-type view-type-search ng-video vl7">
    <div class="article-content">
        <div class="article-content-text">
            <header class="article-header">
                <h3 class="title"><a href="{exp_exp_path(null, $location)}" title="{$link_title|wash}">{title(null, $content_fields, $content)}</a></h3>
                <div class="info">
                    {expinclude uri='design:content/parts/time.tpl'}                    <span class="type">{$content.contentInfo.contentTypeName}</span>
                </div>
            </header>
            {if $short_text|ne:''}
                <div class="short">{$short_text}</div>
            {/if}
        </div>

        
        {$poster_url = ''}
        {$poster_service = ''}
        {$video_id = ''}
        {$sr_map = $node.data_map}

        {if and(is_set($sr_map.poster), $sr_map.poster.has_content)}
            {$sr_poster = $sr_map.poster.content}
            {if is_set($sr_poster.i480)}
                {$poster_url = $sr_poster.i480.url|ezroot:'no'}
            {elseif is_set($sr_poster.original)}
                {$poster_url = $sr_poster.original.url|ezroot:'no'}
            {/if}
        {/if}

        {if and($poster_url|eq:'', is_set($sr_map.video_identifier), $sr_map.video_identifier.has_content)}
            {$video_id = $sr_map.video_identifier.content}
            {$sr_type = ''}
            {if is_set($sr_map.video_type)}
                {$sr_type = $sr_map.video_type.data_text}
                {if $sr_type|eq:''}
                    {$sr_type = cond($sr_map.video_type.data_int|eq:2, 'vimeo', $sr_map.video_type.data_int|eq:3, 'dailymotion', $sr_map.video_type.data_int|eq:4, 'upload', 'youtube')}
                {/if}
            {/if}

            
            {if or($sr_type|contains:'vimeo', $sr_type|contains:'dailymotion')}
                {$poster_url = video_thumbnail(null, cond($sr_type|contains:'vimeo', 'vimeo', 'dailymotion'), $video_id)}
                {if $poster_url|eq:''}
                    {$poster_service = cond($sr_type|contains:'vimeo', 'vimeo', 'dailymotion')}
                {/if}
            {elseif $sr_type|ne:'upload'}
                {$poster_url = (video_thumbnail(null, 'youtube', $video_id))|ezroot:'no'}
            {/if}
        {/if}

        {if and($poster_url|eq:'', $poster_service|eq:'')}
            {$poster_url = concat('/', asset(null, 'images/video_poster.png'))}
        {/if}

        <figure class="image">
            <a href="{exp_exp_path(null, $location)}" class="ratio ratio-16x9" title="{$link_title|wash}">
                {if $poster_service|eq:'vimeo'}
                    <img src="" class="video-poster vimeo-poster" data-id="{$video_id|wash}" data-thumbname="thumbnail_large" alt="{$content.name|wash}" />
                {elseif $poster_service|eq:'dailymotion'}
                    <img src="" class="video-poster dailymotion-poster" data-id="{$video_id|wash}" data-thumbname="thumbnail_360_url" alt="{$content.name|wash}" />
                {else}
                    <img src="{$poster_url}" alt="{$content.name|wash}" />
                {/if}
            </a>
            <i class="icon-play article-icon" aria-hidden="true"></i>
        </figure>
    </div>
</article>
{* exp:template:convert tpl->stpl md5:ff30af249f07c0d67dc46b84ddf41059 from templates/content/views/search/ng_video.tpl -- generated; a file changed by hand is not replaced without --force *}