{$node = fetch('content', 'node', ['node_id' => $location.node_id])}
{$sv_ident = ''}
{if and(is_set($node.data_map.video_identifier), $node.data_map.video_identifier.has_content)}
    {$sv_ident = $node.data_map.video_identifier.content}
{/if}
{$sv_type = ''}
{if and(is_set($node.data_map.video_type), $node.data_map.video_type.data_text|ne:'')}
    {$sv_type = $node.data_map.video_type.data_text}
{/if}
{$sv_has_file = false}
{if and(is_set($node.data_map.video_file), $node.data_map.video_file.has_content)}
    {$sv_has_file = true}
{/if}
{if or($sv_ident|ne:'', $sv_has_file)}
    <article data-item="true" data-content-id="{$node.contentobject_id}" data-location-id="{$node.node_id}" class="view-type view-type-{$view_type} ng-video vl1">
        <i class="icon-play article-icon" aria-hidden="true"></i>
        <figure class="image">
            <a href={$node.url_alias|ezurl} class="ratio ratio-16x9" title="{('Read more about %name'|i18n:'design/media/content':'':(['%name' => $node.name]))|wash}">
                {if and($sv_type|contains:'youtube', $sv_ident|ne:'')}
                    <img src="{(video_thumbnail(null, 'youtube', $sv_ident))|ezroot:'no'}" alt="" class="youtube-thumb">
                {elseif and(is_set($node.data_map.poster), $node.data_map.poster.has_content)}
                    {$sv_poster = $node.data_map.poster.content}
                    {$sv_url = ''}
                    {if is_set($sv_poster.i480)}
                        {$sv_url = $sv_poster.i480.url}
                    {elseif is_set($sv_poster.original)}
                        {$sv_url = $sv_poster.original.url}
                    {/if}
                    {if $sv_url|ne:''}
<img src={$sv_url|ezroot} loading="lazy" alt="" class="exp_image-field">{/if}
                    {$sv_poster = null}
{$sv_url = null}
                {elseif $sv_ident|ne:''}
                    <img src="{(video_thumbnail(null, 'youtube', $sv_ident))|ezroot:'no'}" alt="" class="youtube-thumb">
                {/if}
            </a>
        </figure>

        <header class="article-header">
            <h3 class="title"><a href={$node.url_alias|ezurl}>{$node.name|wash}</a></h3>
        </header>
        {if first_set($with_intro, 'false')}
            {$sv_intro_attr = false}
            {if is_set($node.object.data_map.teaser_intro)}
                {if $node.object.data_map.teaser_intro.has_content}
                    {$sv_intro_attr = $node.object.data_map.teaser_intro}
                {/if}
            {/if}
            {if not($sv_intro_attr)}
                {if is_set($node.object.data_map.full_intro)}
                    {if $node.object.data_map.full_intro.has_content}
                        {$sv_intro_attr = $node.object.data_map.full_intro}
                    {/if}
                {/if}
            {/if}
            {if $sv_intro_attr}
<div class="short"><div class="exp_richtext-field">{attribute_view_gui attribute=$sv_intro_attr}</div></div>{/if}
            {$sv_intro_attr = null}
        {/if}
    </article>{/if}
{$sv_ident = null}
{$sv_has_file = null}
{* exp:template:convert tpl->stpl md5:bb48e7ddc817a8577890bae44525a238 from templates/content/views/standard/ng_video.tpl -- generated; a file changed by hand is not replaced without --force *}