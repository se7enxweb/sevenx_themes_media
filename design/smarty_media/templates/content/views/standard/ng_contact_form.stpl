





{$content_fields = []}
{$toolbar_macros = []}
<article {item_params(null, $toolbar_macros, $content, $location)} class="view-type view-type-{$view_type} ng-contact-form vl1">
    <header class="article-header">
        <h3 class="title"><a href={$node.url_alias|ezurl}>{title(null, $content_fields, $content)}</a></h3>
    </header>

    {if first_set($with_intro, 'false')}
        {intro(null, $content_fields, $content)}
    {/if}
</article>{* exp:template:convert tpl->stpl md5:e243d29428c7c27225c195d377476bc9 from templates/content/views/standard/ng_contact_form.tpl -- generated; a file changed by hand is not replaced without --force *}