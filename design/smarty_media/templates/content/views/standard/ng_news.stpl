





{$content_fields = []}
{$toolbar_macros = []}
<article {item_params(null, $toolbar_macros, $content, $location)} class="view-type view-type-{$view_type} ng-news vl1">
    {if not(is_set($node))}
{$node = false}
{/if}
{$node = fetch('content', 'node', ['node_id' => $location.node_id])}
 {expinclude uri='design:content/parts/item_image.tpl' node=$node}
    <header class="article-header">
        <h3 class="title"><a href={$node.url_alias|ezurl}>{title(null, $content_fields, $content)}</a></h3>
        <div class="info">
            {expinclude uri='design:content/parts/author.tpl'}            {expinclude uri='design:content/parts/time.tpl'}        </div>
    </header>

    {if first_set($with_intro, 'false')}
        {intro(null, $content_fields, $content)}
    {/if}
</article>{* exp:template:convert tpl->stpl md5:2e5867df754eea2bc779e2657e11255f from templates/content/views/standard/ng_news.tpl -- generated; a file changed by hand is not replaced without --force *}