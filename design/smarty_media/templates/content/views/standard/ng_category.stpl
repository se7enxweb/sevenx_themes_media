





{$content_fields = []}
{$toolbar_macros = []}
<article {item_params(null, $toolbar_macros, $content, $location)} class="view-type view-type-{$view_type} ng-category vl1">
    <header class="article-header">
        <h3 class="title"><a href={$node.url_alias|ezurl}>{title(null, $content_fields, $content)}</a></h3>
    </header>

    {if first_set($with_intro, 'false')}
        {intro(null, $content_fields, $content)}
    {/if}
</article>{* exp:template:convert tpl->stpl md5:025cc8d5c4618a36a029dc8bb23ad203 from templates/content/views/standard/ng_category.tpl -- generated; a file changed by hand is not replaced without --force *}