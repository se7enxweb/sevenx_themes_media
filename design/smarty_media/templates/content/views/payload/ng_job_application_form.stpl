







    

    {exp_form_start(null, $form, $form_parameters)}
        {exp_form_errors(null, $form)}

        <div class="form-wrapper">
            {exp_form_row(null, $form.sender_first_name, ['ngparams' => ['autocomplete' => 'given-name']])}

            {if not($content.fields.honeypot_field_name.empty)}
                {exp_form_row(null, $form[$content.fields.honeypot_field_name.value.text])}
            {/if}

            {exp_form_row(null, $form.sender_last_name, ['ngparams' => ['autocomplete' => 'family-name']])}
            {exp_form_row(null, $form.sender_email, ['ngparams' => ['autocomplete' => 'email']])}

            {exp_form_row(null, $form.sender_message)}

            {exp_form_row(null, $form.sender_file_cv.children.value.children.file, ['ngparams' => ['label' => $content.fields.sender_file_cv.name]])}
            {exp_form_row(null, $form.sender_motivation_letter.children.value.children.file, ['ngparams' => ['label' => $content.fields.sender_motivation_letter.name]])}
            {exp_form_row(null, $form.gdpr_consent, ['ngparams' => ['label' => $content.fields.gdpr_consent_label.value.xml|exp_ibexa_richtext_to_html5]])}
            {exp_form_row(null, $form.newsletter_1_consent, ['ngparams' => ['label' => $content.fields.newsletter_1_label.value.xml|exp_ibexa_richtext_to_html5]])}

            {exp_form_row(null, $form.referer.value, ['hidden' => 'true', 'attr' => ['value' => $referer]])}

            <div class="form-submit">
                <button type="submit" class="btn btn-primary">{'ngsite.collected_info.button.send'|trans}</button>
            </div>
            {exp_form_rest(null, $form)}
        </div>

    {exp_form_end(null, $form, ['render_rest' => 'false'])}



    {parent()}
