{$show_path = 'false'}
{$view_type = 'full'}




{if not($content.fields.teaser_intro.empty)}
    {$meta_data = ['description' => ((((saveXML(null, $content.fields.teaser_intro.value.xml))|exp_strip_tags)|trim)|exp_u)|expattr:(exp_truncate(null, 152))]}
{elseif not($content.fields.full_intro.empty)}
    {$meta_data = ['description' => ((((saveXML(null, $content.fields.full_intro.value.xml))|exp_strip_tags)|trim)|exp_u)|expattr:(exp_truncate(null, 152))]}
{/if}
{explblock name='content'}
    <div class="view-type view-type-{$view_type} ng-category">

        {explblock name='article_header'}
        <header class="full-page-header text-center">
            <div class="container">
                <h1 class="full-page-title">{ng_render_field(null, $content.fields.title)}</h1>
                {if not($content.fields.full_intro.empty)}
                    <div class="full-page-header-text">
                        <div class="row">
                            <div class="container container-narrow">
                                {ng_render_field(null, $content.fields.full_intro)}
                            </div>
                        </div>
                    </div>
                {/if}
            </div>
        </header>
        {/explblock}

        <div class="container">
            {explblock name='article_body'}
            {if not($content.fields.body.empty)}
                <div class="full-page-body">
                    {ng_render_field(null, $content.fields.body)}
                </div>
            {/if}
            {/explblock}

            {$featured_locations = filterFieldRelationLocations(null, $content, 'featured_content')}
            {if ($featured_locations|exp_count)|gt:0}
                <div class="category-featured-content">
                    {foreach $featured_locations as $featured_location}
                        {ng_view_content(null, $featured_location, 'line')}
                    {/foreach}
                </div>
            {/if}

            {if $content.fields.show_children.value.bool}
                {$pager = ng_query(null, 'subtree')}

                {if ($pager|exp_count)|gt:0}
                    {$children_view_type = first_set($content.fields.view_type.value.identifiers.0, 'standard')}
                    {$columns = first_set($content.fields.grid_columns.value.identifiers.0, '3')}
                    {$column_css_class = ['1' => 'col-12', '2' => 'col-sm-6', '3' => 'col-md-4 col-sm-6', '4' => 'col-lg-3 col-md-4 col-sm-6']}
                    <div class="category-children">
                        {if $children_view_type|eq:'listitem'}
                            <ul class="listitem-list">
                                {foreach $pager as $pager_item}
                                    <li>
                                        {ng_view_content(null, $pager_item, $children_view_type)}
                                    </li>
                                {/foreach}
                            </ul>
                        {else}
                            <div class="row">
                                {foreach $pager as $pager_item}
                                    <div class="{$column_css_class[$columns]}">
                                        {ng_view_content(null, $pager_item, $children_view_type)}
                                    </div>
                                {/foreach}
                            </div>
                        {/if}
                    </div>
                {/if}

                {if haveToPaginate(null, $pager)}
                    {pagerfanta(null, $pager, 'ngsite')}
                {/if}
            {/if}
        </div>
    </div>{/explblock}
{* exp:template:convert tpl->stpl md5:fef0e9dd3c9013a6c892a615f5637e3f from templates/content/views/full/ng_category.tpl -- generated; a file changed by hand is not replaced without --force *}