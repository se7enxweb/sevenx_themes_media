{$show_path = 'false'}
{$view_type = 'full'}




{explblock name='content'}
    <div class="view-type view-type-{$view_type} ng-contact-form">
        {explblock name='article_header'}
        <header class="full-page-header text-center">
            <div class="container">
                <h1 class="full-page-title">{ng_render_field(null, $content.fields.title)}</h1>
                {if not($content.fields.full_intro.empty)}
                    <div class="full-page-header-text">
                        <div class="row">
                            <div class="container container-narrow">
                                {ng_render_field(null, $content.fields.full_intro)}
                            </div>
                        </div>
                    </div>
                {/if}
            </div>
        </header>
        {/explblock}

        {explblock name='article_body'}
        <div class="full-form-content">
            <div class="container">
                {ng_view_content(null, $content, 'payload', ['params' => ['action' => path(null, 'ngsite_info_collection_ajax_submit', ['formContentId' => $content.id]), 'refererLocationId' => $location.id, 'class' => 'embed-form js-form-embed']])}
            </div>
        </div>
        {/explblock}
    </div>{/explblock}
{* exp:template:convert tpl->stpl md5:cc0ae704c3c80f8e5f38c27f305fc551 from templates/content/views/full/ng_contact_form.tpl -- generated; a file changed by hand is not replaced without --force *}