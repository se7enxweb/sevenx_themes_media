{$show_path = 'false'}
{$view_type = 'full'}






{$content_fields = []}
{if not($content.fields.teaser_intro.empty)}
    {$meta_data = ['description' => ((((saveXML(null, $content.fields.teaser_intro.value.xml))|exp_strip_tags)|trim)|exp_u)|expattr:(exp_truncate(null, 152))]}
{elseif not($content.fields.full_intro.empty)}
    {$meta_data = ['description' => ((((saveXML(null, $content.fields.full_intro.value.xml))|exp_strip_tags)|trim)|exp_u)|expattr:(exp_truncate(null, 152))]}
{/if}
{explblock name='content'}
    <article class="view-type view-type-{$view_type} ng-job-position vf1">
        {explblock name='article_header'}
            <header class="full-page-header">
                <div class="container">
                    <h1 class="full-page-title">{ng_render_field(null, $content.fields.title)}</h1>
                    <div class="full-page-info">
                        {if not($content.fields.job_location.empty)}
                            <span>{ng_render_field(null, $content.fields.job_location)}</span>
                        {/if}
                        {if not($content.fields.engagement_type.empty)}
                            <span>{ng_render_field(null, $content.fields.engagement_type)}</span>
                        {/if}
                        {if not($content.fields.application_deadline.empty)}
                            <span>{'ngsite.job_application.deadline'|trans}: {ng_render_field(null, $content.fields.application_deadline)}</span>
                        {/if}
                    </div>
                </div>
            </header>
        {/explblock}

        {explblock name='article_media'}
            {if not($content.fields.image.empty)}
                <div class="full-page-image">
                    <div class="container container-wide">
                        {ng_render_field(null, $content.fields.image)}
                    </div>
                </div>
            {/if}
        {/explblock}

        <div class="container container-narrow">
            {explblock name='article_body'}
                <div class="full-page-body">
                    {if not($content.fields.full_intro.empty)}
                        <div class="full-page-intro">
                            {ng_render_field(null, $content.fields.full_intro)}
                        </div>
                    {/if}

                    {if not($content.fields.job_overview.empty)}
                        <h3 class="job-details">{'ngsite.job_application.job_overview'|trans}</h3>
                        {ng_render_field(null, $content.fields.job_overview)}
                    {/if}

                    {if not($content.fields.requirements.empty)}
                        <h3 class="job-details">{'ngsite.job_application.requirements'|trans}</h3>
                        {ng_render_field(null, $content.fields.requirements)}
                    {/if}

                    {if not($content.fields.responsibilities.empty)}
                        <h3 class="job-details">{'ngsite.job_application.responsibilities'|trans}</h3>
                        {ng_render_field(null, $content.fields.responsibilities)}
                    {/if}
                </div>
            {/explblock}
        </div>
    </article>{/explblock}


    <script type="application/ld+json">
        {ldelim}            "@context": "http://schema.org",
            "@type": "Article",
            "headline": {$content.fields.title.value.text|json_ld},
            {if $content.contentInfo.publishedDate}
"datePublished": {($content.contentInfo.publishedDate|exp_format_date)|json_ld},
            {/if}
{if not($content.fields.image.empty)}
                "image": {(absolute_url(null, ng_image_alias(null, $content.fields.image, 'i1320')))|json_ld},
            {/if}
            
            {if is_set($node)}
{$ld_license = xrowmetadata_license(null, $node)}
{else}
{$ld_license = xrowmetadata_license()}
{/if}
            {if and($ld_license, $ld_license.show.json_ld)}
{$ld_license.json_ld_property}{/if}
            {$ld_license = null}
            "publisher": {ldelim}                "@type": "Organization",
                "name": {$site_name|json_ld}
            {rdelim}        {rdelim}    </script>
{* exp:template:convert tpl->stpl md5:4eb9c137cc013acbf9c6ebbe08910d29 from templates/content/views/full/ng_job_position.tpl -- generated; a file changed by hand is not replaced without --force *}