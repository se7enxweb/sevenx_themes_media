{$show_path = 'false'}
{$view_type = 'full'}




{if not($content.fields.teaser_intro.empty)}
    {$meta_data = ['description' => ((((saveXML(null, $content.fields.teaser_intro.value.xml))|exp_strip_tags)|trim)|exp_u)|expattr:(exp_truncate(null, 152))]}
{/if}
{explblock name='content'}
    <div class="view-type view-type-{$view_type} ng-audio">

        {explblock name='article_header'}
            <header class="full-page-header">
                <div class="container">
                    {expinclude uri='design:content/parts/main_topic.tpl'}                    <h1 class="full-page-title">{ng_render_field(null, $content.fields.title)}</h1>

                    <div class="full-page-info">
                        {expinclude uri='design:content/parts/author.tpl'}                        {expinclude uri='design:content/parts/time.tpl'}                    </div>
                </div>
            </header>
        {/explblock}

        {explblock name='article_media'}
            {if not($content.fields.file.empty)}
                <div class="full-page-audio">
                    <div class="container container-narrow">
                            <audio controls>
                                <source type="audio/mpeg" src="{path(null, 'ngsite_download', ['contentId' => $content.id, 'fieldId' => $content.fields.file.id])}" />
                                {'Your browser does not support the audio element.'|i18n:'design/media/content'}
                            </audio>
                    </div>
                </div>
            {/if}
        {/explblock}

        <div class="container container-narrow">
            {explblock name='article_body'}
                <div class="full-page-body">
                    {if not($content.fields.teaser_intro.empty)}
                        <div class="full-page-intro">
                            {ng_render_field(null, $content.fields.teaser_intro)}
                        </div>
                    {/if}

                    {if not($content.fields.description.empty)}
                        {ng_render_field(null, $content.fields.description)}
                    {/if}

                    {expinclude uri='design:content/parts/tags.tpl'}                </div>
            {/explblock}
        </div>
    </div>{/explblock}
{* exp:template:convert tpl->stpl md5:f1b2b8a0957959c41741f4623834724a from templates/content/views/full/ng_audio.tpl -- generated; a file changed by hand is not replaced without --force *}