{$show_path = 'false'}
{$view_type = 'full'}






{$content_fields = []}
{if not($content.fields.teaser_intro.empty)}
    {$meta_data = ['description' => ((((saveXML(null, $content.fields.teaser_intro.value.xml))|exp_strip_tags)|trim)|exp_u)|expattr:(exp_truncate(null, 152))]}
{elseif not($content.fields.full_intro.empty)}
    {$meta_data = ['description' => ((((saveXML(null, $content.fields.full_intro.value.xml))|exp_strip_tags)|trim)|exp_u)|expattr:(exp_truncate(null, 152))]}
{/if}
{explblock name='content'}
    <article class="view-type view-type-{$view_type} ng-recipe">
        {explblock name='article_header'}
            <header class="full-page-header">
                <div class="container">
                    {expinclude uri='design:content/parts/main_topic.tpl'}
                    <h1 class="full-page-title">{ng_render_field(null, $content.fields.title)}</h1>

                    <div class="full-page-info">
                        {expinclude uri='design:content/parts/author.tpl'}                    </div>
                </div>
            </header>
        {/explblock}

        {explblock name='article_media'}
            {if or(not($content.fields.image.empty), not($content.fields.related_multimedia.empty))}
                <div class="full-page-image">
                    {expinclude uri='design:content/parts/related_multimedia.tpl'}                </div>
            {/if}
        {/explblock}

        <div class="container container-narrow">
            {explblock name='article_body'}
                <div class="full-page-body">
                    {if not($content.fields.full_intro.empty)}
                        <div class="full-page-intro">
                            {ng_render_field(null, $content.fields.full_intro)}
                        </div>
                    {/if}

                    {if not($content.fields.body.empty)}
                        {ng_render_field(null, $content.fields.body)}
                    {/if}

                    {expinclude uri='design:content/parts/tags.tpl'}                </div>
            {/explblock}

            
                <div class="full-recipe-info">
                    {if not($content.fields.serving_calories.empty)}
                        <div class="recipe-calories">
                            {ng_render_field(null, $content.fields.serving_calories)} {'ngsite.layout.recipe.cal'|trans}
                        </div>
                    {/if}

                    <ul class="recipe-serving-info">
                        {if not($content.fields.serving_fat.empty)}
                            <li>{ng_render_field(null, $content.fields.serving_fat)} <span class="tt">{'ngsite.layout.recipe.fat'|trans}</span></li>
                        {/if}
                        {if not($content.fields.serving_carbohydrates.empty)}
                            <li>{ng_render_field(null, $content.fields.serving_carbohydrates)} <span class="tt">{'ngsite.layout.recipe.carbs'|trans}</span></li>
                        {/if}
                        {if not($content.fields.serving_protein.empty)}
                            <li>{ng_render_field(null, $content.fields.serving_protein)} <span class="tt">{'ngsite.layout.recipe.protein'|trans}</span></li>
                        {/if}
                    </ul>

                    {if not($content.fields.preparation_time.empty)}
                        <div class="recipe-time">
                            {'ngsite.layout.recipe.preparation_time'|trans}
                            <time>{ng_render_field(null, $content.fields.preparation_time)} {'ngsite.layout.recipe.min'|trans}</time>
                        </div>
                    {/if}
                    {expinclude uri='design:content/parts/social_share.tpl'}                </div>
            
        </div>
    </article>{/explblock}



{* exp:template:convert tpl->stpl md5:50fb5d5c573949eebd97d066b59ed7ff from templates/content/views/full/ng_recipe.tpl -- generated; a file changed by hand is not replaced without --force *}