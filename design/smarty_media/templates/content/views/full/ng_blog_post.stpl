{$show_path = 'false'}
{$view_type = 'full'}






{$content_fields = []}
{if not($content.fields.teaser_intro.empty)}
    {$meta_data = ['description' => ((((saveXML(null, $content.fields.teaser_intro.value.xml))|exp_strip_tags)|trim)|exp_u)|expattr:(exp_truncate(null, 152))]}
{elseif not($content.fields.full_intro.empty)}
    {$meta_data = ['description' => ((((saveXML(null, $content.fields.full_intro.value.xml))|exp_strip_tags)|trim)|exp_u)|expattr:(exp_truncate(null, 152))]}
{/if}
{explblock name='content'}
    <article class="view-type view-type-{$view_type} ng-blog-post vf1" itemscope itemtype="http://schema.org/BlogPosting">

        {explblock name='article_header'}
            <header class="full-page-header">
                <div class="container">
                    {expinclude uri='design:content/parts/main_topic.tpl'}                    <h1 class="full-page-title" itemprop="headline">{ng_render_field(null, $content.fields.title)}</h1>

                    <div class="full-page-info">
                        {expinclude uri='design:content/parts/author.tpl'}                        {expinclude uri='design:content/parts/time.tpl'}                    </div>
                </div>
            </header>
        {/explblock}

        {if not($content.fields.image.empty)}
            {explblock name='article_media'}
                <div class="full-page-image" itemprop="image">
                    <div class="container container-wide">
                        {render(null, controller(null, 'ngsite.controller.relations.related_multimedia_items', ['locationId' => $location.id, 'includeChildren' => 'true', 'contentTypeIdentifiers' => ['image', 'ng_video'], 'template' => '@ibexadesign/content/parts/related_multimedia.html.twig']))}
                    </div>
                </div>
            {/explblock}
        {/if}

        <div class="container container-narrow">
            {explblock name='article_body'}
                <div class="full-page-body" itemprop="articleBody">
                    {if not($content.fields.full_intro.empty)}
                        <div class="full-page-intro" itemprop="description">
                            {ng_render_field(null, $content.fields.full_intro)}
                        </div>
                    {/if}

                    {if not($content.fields.body.empty)}
                        {ng_render_field(null, $content.fields.body)}
                    {/if}

                    {expinclude uri='design:content/parts/tags.tpl'}
                     <div class="sticky-sidebar-wrapper">
                        <div id="sticky-sidebar" class="sticky-sidebar">
                            <div class="sticky-sidebar-inner">
                                {expinclude uri='design:content/parts/social_share.tpl'}                            </div>
                        </div>
                    </div>
                </div>
            {/explblock}
        </div>
    </article>{/explblock}


    <script type="application/ld+json">
        {ldelim}            "@context": "http://schema.org",
            "@type": "Blog",
            "headline": {$content.fields.title.value.text|json_ld},
            {if $content.contentInfo.publishedDate}
                "datePublished": {($content.contentInfo.publishedDate|exp_format_date)|json_ld},
            {/if}
            {if not($content.fields.authors.empty)}
                "author": {ldelim}                    "@type": "Person",
                    {$ld_author_names = []}
{$__loop1 = fieldRelations(null, $content, 'authors')}
{foreach $__loop1 as $author}
{$ld_author_names = $ld_author_names|append:$author.name}
{/foreach}
"name": {($ld_author_names|exp_implode:', ')|json_ld}{$ld_author_names = null}
                {rdelim},
            {/if}
            {if not($content.fields.image.empty)}
                "image": {(absolute_url(null, ng_image_alias(null, $content.fields.image, 'i1320')))|json_ld},
            {/if}
            
            {if is_set($node)}
{$ld_license = xrowmetadata_license(null, $node)}
{else}
{$ld_license = xrowmetadata_license()}
{/if}
            {if and($ld_license, $ld_license.show.json_ld)}
{$ld_license.json_ld_property}{/if}
            {$ld_license = null}
            "publisher": {ldelim}                "@type": "Organization",
                "name": {$site_name|json_ld}
            {rdelim}        {rdelim}    </script>
{* exp:template:convert tpl->stpl md5:c65edcd881457455625b8d6947776288 from templates/content/views/full/ng_blog_post.tpl -- generated; a file changed by hand is not replaced without --force *}