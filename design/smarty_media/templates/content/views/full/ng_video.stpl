{$view_type = 'full'}






{if not($content.fields.teaser_intro.empty)}
    {$meta_data = ['description' => ((((saveXML(null, $content.fields.teaser_intro.value.xml))|exp_strip_tags)|trim)|exp_u)|expattr:(exp_truncate(null, 152))]}
{/if}
{explblock name='content'}
    <div class="view-type view-type-{$view_type} ng-video vf3">
        <div class="container">
            {explblock name='article_media'}
            <div class="full-video-player">
                {player(null, $video, $content)}
            </div>
            {/explblock}

            {explblock name='article_header'}
            <header class="full-video-header">
                <h1 class="title">{ng_render_field(null, $content.fields.title)}</h1>
                {if $content.contentInfo.publishedDate}
                    <time>{$content.contentInfo.publishedDate|exp_format_date}</time>
                {/if}
            </header>
            {/explblock}

            {explblock name='article_body'}
            {if not($content.fields.teaser_intro.empty)}
                <div class="short">
                    {ng_render_field(null, $content.fields.teaser_intro)}
                </div>
            {/if}

            {if not($content.fields.description.empty)}
                <div class="body">
                    {ng_render_field(null, $content.fields.description)}
                </div>
            {/if}
            {/explblock}
        </div>
    </div>{/explblock}
{* exp:template:convert tpl->stpl md5:e5b940da38722b982a92cd139429c31d from templates/content/views/full/ng_video.tpl -- generated; a file changed by hand is not replaced without --force *}