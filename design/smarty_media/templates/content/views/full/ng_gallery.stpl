{$show_path = 'false'}
{$view_type = 'full'}




{if not($content.fields.teaser_intro.empty)}
    {$meta_data = ['description' => ((((saveXML(null, $content.fields.teaser_intro.value.xml))|exp_strip_tags)|trim)|exp_u)|expattr:(exp_truncate(null, 152))]}
{elseif not($content.fields.description.empty)}
    {$meta_data = ['description' => ((((saveXML(null, $content.fields.description.value.xml))|exp_strip_tags)|trim)|exp_u)|expattr:(exp_truncate(null, 152))]}
{/if}
{explblock name='content'}
    <div class="view-type view-type-{$view_type} ng-gallery">
        {explblock name='article_header'}
            <header class="full-page-header">
                <div class="container">
                    {expinclude uri='design:content/parts/main_topic.tpl'}
                    <h1 class="full-page-title">{ng_render_field(null, $content.fields.title)}</h1>

                    <div class="full-page-info">
                        {expinclude uri='design:content/parts/time.tpl'}                    </div>
                </div>
            </header>
        {/explblock}

        {explblock name='article_media'}
            <div class="full-page-image">
                <div class="container container-wide">
                    {render(null, controller(null, 'ngsite.controller.relations.related_multimedia_items', ['locationId' => $location.id, 'includeChildren' => 'true', 'contentTypeIdentifiers' => ['image', 'ng_video'], 'template' => '@ibexadesign/content/parts/related_multimedia.html.twig']))}
                </div>
            </div>
        {/explblock}

        <div class="container container-narrow">

            {explblock name='article_body'}
                <div class="full-page-body">
                    {if not($content.fields.teaser_intro.empty)}
                        <div class="full-page-intro">
                            {ng_render_field(null, $content.fields.teaser_intro)}
                        </div>
                    {/if}

                    {if not($content.fields.description.empty)}
                        {ng_render_field(null, $content.fields.description)}
                    {/if}

                    {expinclude uri='design:content/parts/tags.tpl'}                </div>
            {/explblock}

        </div>
    </div>{/explblock}
{* exp:template:convert tpl->stpl md5:288d04368b6bbaef5f1c862d6809e9de from templates/content/views/full/ng_gallery.tpl -- generated; a file changed by hand is not replaced without --force *}