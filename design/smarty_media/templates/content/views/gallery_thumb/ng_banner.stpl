






{$toolbar_macros = []}
<div {item_params(null, $toolbar_macros, $content, $location)} class="view-type view-type-{$view_type} ng-banner vl3 {if $show_details_on_hover}
show_details_on_hover{/if}
">
    {if $image_type|eq:'main'}
        {image(null, $slide, $content, 'image', 'i1320', 'true')}

        {if $show_details}
            <div class="info">
                <h2 class="title">
                    {content_link(null, $links, $content, $content.fields.title.value.text)}
                </h2>
            </div>
        {/if}
    {elseif $image_type|eq:'thumb'}
        {image(null, $slide, $content, 'image', 'i320')}
    {/if}
</div>{* exp:template:convert tpl->stpl md5:c5d4678aeff0240a35e097e2bcc76b13 from templates/content/views/gallery_thumb/ng_banner.tpl -- generated; a file changed by hand is not replaced without --force *}