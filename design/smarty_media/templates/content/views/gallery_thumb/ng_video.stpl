





{$toolbar_macros = []}
{if or(not($content.fields.video_file.empty), not($content.fields.video_identifier.empty))}
    <div {item_params(null, $toolbar_macros, $content, $location)} class="view-type view-type-{$view_type} ng-video vl3  {if $show_details_on_hover}
show_details_on_hover{/if}
">
        {if $image_type|eq:'main'}
            {poster_slide(null, $video, $content, 'true')}

            {if $show_details}
                <div class="info">
                    <h2 class="title">
                        <a href={exp_exp_path(null, $location)}>
                            {$content.fields.title.value.text}
                        </a>
                    </h2>
                </div>
            {/if}
        {elseif $image_type|eq:'thumb'}
            {poster_slide(null, $video, $content, 'false')}
        {/if}
    </div>{/if}
{* exp:template:convert tpl->stpl md5:c278511ebbeff1ade7c39045a037b858 from templates/content/views/gallery_thumb/ng_video.tpl -- generated; a file changed by hand is not replaced without --force *}