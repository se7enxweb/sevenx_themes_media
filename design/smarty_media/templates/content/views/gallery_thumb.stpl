






{$content_fields = []}
{$toolbar_macros = []}
{if not(is_set($node))}
{$node = false}
{/if}
{$node = fetch('content', 'node', ['node_id' => $location.node_id])}

<div {item_params(null, $toolbar_macros, $content, $location)} class="view-type view-type-{$view_type} {$content.contentInfo.contentTypeIdentifier|ristring:'_':'-'} vl3 {if $show_details_on_hover}
show_details_on_hover{/if}
">
    {if $image_type|eq:'main'}
        {image(null, $slide, $content, 'image', 'i1320', 'true')}

        {if $show_details}
            <div class="info">
                <h2 class="title"><a href={$node.url_alias|ezurl}>{$node.name|wash}</a></h2>
            </div>
        {/if}
    {elseif $image_type|eq:'thumb'}
        {image(null, $slide, $content, 'image', 'i320')}
    {/if}
</div>{* exp:template:convert tpl->stpl md5:77f46d051b703625b19ad1b5e83a739d from templates/content/views/gallery_thumb.tpl -- generated; a file changed by hand is not replaced without --force *}