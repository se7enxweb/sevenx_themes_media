





{$content_fields = []}
{$toolbar_macros = []}
{if not(is_set($node))}
{$node = false}
{/if}
{$node = fetch('content', 'node', ['node_id' => $location.node_id])}

<article {item_params(null, $toolbar_macros, $content, $location)} class="view-type view-type-{$view_type} ng-blog-post vl2">
    {expinclude uri='design:content/parts/item_image.tpl' node=$node}
    <header class="article-header">
        <h3 class="title"><a href={$node.url_alias|ezurl}>{$node.name|wash}</a></h3>
        <div class="info">
            {expinclude uri='design:content/parts/author.tpl'}            {expinclude uri='design:content/parts/time.tpl'}        </div>
    </header>
</article>{* exp:template:convert tpl->stpl md5:af4158e24c4714e08ada372b11c7c68e from templates/content/views/overlay/ng_blog_post.tpl -- generated; a file changed by hand is not replaced without --force *}