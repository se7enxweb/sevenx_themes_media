                    <span class="icon-cancel"></span>
                </a>
            </div>
            <div class="modal-body">
            </div>
        </div>
    </div>
</div>{* exp:template:convert tpl->stpl md5:e8e3a212d4a06f972eaa70605c384502 from templates/content/views/modal.tpl -- generated; a file changed by hand is not replaced without --force *}