





{$content_fields = []}
{$toolbar_macros = []}
<article {item_params(null, $toolbar_macros, $content, $location)} class="view-type view-type-{$view_type} ng-recipe vl4">
    {expinclude uri='design:content/parts/item_image.tpl' node=$node image_alias='i320'}
    <div class="article-content">
        <header class="article-header">
            <h3 class="title"><a href="{exp_exp_path(null, $location)}">{title(null, $content_fields, $content)}</a></h3>
            <div class="info">
                {expinclude uri='design:content/parts/author.tpl'}
                <span class="recipe-details">
                    {if and(is_set($node.data_map.preparation_time), $node.data_map.preparation_time.has_content)}
                        <span><i class="icon-clock"></i> <span class="exp_integer-field">{$node.data_map.preparation_time.content}</span> {'min'|i18n:'design/media/content/recipe'}</span>
                    {/if}
                    {if and(is_set($node.data_map.serving_calories), $node.data_map.serving_calories.has_content)}
                        <span><i class="icon-fire"></i> <span class="exp_integer-field">{$node.data_map.serving_calories.content}</span> {'cal'|i18n:'design/media/content/recipe'}</span>
                    {/if}
                </span>
            </div>
        </header>
        {intro(null, $content_fields, $content)}
    </div>
</article>{* exp:template:convert tpl->stpl md5:f70ab9e7a423b0ebe582365f9659a929 from templates/content/views/line/ng_recipe.tpl -- generated; a file changed by hand is not replaced without --force *}