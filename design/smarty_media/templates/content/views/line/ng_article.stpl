





{$content_fields = []}
{$toolbar_macros = []}
<article {item_params(null, $toolbar_macros, $content, $location)} class="view-type view-type-{$view_type} ng-article vl4">
    {expinclude uri='design:content/parts/item_image.tpl' node=$node image_alias='i320'}
    <div class="article-content">
        <header class="article-header">
            <h3 class="title"><a href="{exp_exp_path(null, $location)}">{title(null, $content_fields, $content)}</a></h3>
            <div class="info">
                {expinclude uri='design:content/parts/author.tpl'}            </div>
        </header>
        {intro(null, $content_fields, $content)}
    </div>
</article>{* exp:template:convert tpl->stpl md5:9024d256e790aa435186ad34d321c85f from templates/content/views/line/ng_article.tpl -- generated; a file changed by hand is not replaced without --force *}