




{$toolbar_macros = []}
<article {item_params(null, $toolbar_macros, $content, $location)} class="view-type view-type-{$view_type} file vl4">
    <div class="article-content">
        <header class="article-header">
            <h2 class="title">
                <a href="{exp_exp_path(null, $location)}">
                    {$node.name|wash}
                </a>
            </h2>
        </header>
    </div>
</article>{* exp:template:convert tpl->stpl md5:6708b7106b7c2ec42bbe3d2e719294f1 from templates/content/views/line/file.tpl -- generated; a file changed by hand is not replaced without --force *}