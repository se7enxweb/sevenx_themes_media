






{$content_fields = []}
{$toolbar_macros = []}
<div {item_params(null, $toolbar_macros, $content, $location)} class="view-type view-type-{$view_type} image vl3">
    {$title = title(null, $content_fields, $content)}

    <a href="{asset(null, ng_image_alias(null, $content.fields.image, 'i1320'))}" title="{$title}" class="js-lightbox-item" data-pswp-width="{$content.fields.image.value.width}" data-pswp-height="{$content.fields.image.value.height}">
        {image(null, $slide, $content)}
    </a>
</div>{* exp:template:convert tpl->stpl md5:ab7e64afdddab41befc24cbfc3ceb590 from templates/content/views/gallery_grid/image.tpl -- generated; a file changed by hand is not replaced without --force *}