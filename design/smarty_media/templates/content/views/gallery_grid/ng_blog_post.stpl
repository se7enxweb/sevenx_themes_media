





{$content_fields = []}
{$toolbar_macros = []}
{if not($content.fields.image.empty)}
    <div {item_params(null, $toolbar_macros, $content, $location)} class="view-type view-type-{$view_type} ng-blog-post vl3">
        {if not($content.fields.authors.empty)}
            {$author = ((fieldRelations(null, $content, 'authors'))|expattr:0)|expattr:'name'}
        {else}
            {$author = $content.owner.name}
        {/if}

        {$date = $content.fields.publish_date.value.value|exp_format_date}
        {$title = title(null, $content_fields, $content)}

        <a href="{asset(null, ng_image_alias(null, $content.fields.image, 'i1320'))}" title="{'%title by %author (%date)'|i18n:'ngsite':expvoid():(['%title' => $title, '%author' => $author, '%date' => $date])}" class="js-lightbox-item" data-pswp-width="{$content.fields.image.value.width}" data-pswp-height="{$content.fields.image.value.height}">
            {ng_render_field(null, $content.fields.image, ['parameters' => ['alias' => 'i1320', 'alt_text' => $title]])}
        </a>
    </div>{/if}
{* exp:template:convert tpl->stpl md5:c7dbf828a12d712fcb879b120cbe5a6e from templates/content/views/gallery_grid/ng_blog_post.tpl -- generated; a file changed by hand is not replaced without --force *}