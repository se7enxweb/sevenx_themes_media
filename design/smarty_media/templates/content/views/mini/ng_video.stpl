






{$content_fields = []}
{$toolbar_macros = []}
{$vd_node = fetch('content', 'node', ['node_id' => $location.node_id])}
{$vd_youtube = ''}
{if and(is_set($vd_node.data_map.video_identifier), $vd_node.data_map.video_identifier.has_content)}
    {$vd_youtube = $vd_node.data_map.video_identifier.content}
{/if}
{if $vd_youtube|ne:''}
    <article {item_params(null, $toolbar_macros, $content, $location)} class="view-type view-type-{$view_type} ng-video vl5">
        <figure class="image">
            <i class="icon-play article-icon" aria-hidden="true"></i>
    <a href={$vd_node.url_alias|ezurl} class="ratio ratio-1x1" title="{('Read more about %name'|i18n:'design/media/content':'':(['%name' => $vd_node.name]))|wash}">
        <img src="{(video_thumbnail(null, 'youtube', $vd_youtube))|ezroot:'no'}" alt="" />
    </a>
        </figure>

        <header class="article-header">
            <h3 class="title"><a href="{exp_exp_path(null, $location)}">{title(null, $content_fields, $content)}</a></h3>
        </header>
    </article>{/if}
{$vd_youtube = null}
{$vd_node = null}
