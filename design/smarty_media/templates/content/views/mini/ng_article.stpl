





{$content_fields = []}
{$toolbar_macros = []}
<article {item_params(null, $toolbar_macros, $content, $location)} class="view-type view-type-{$view_type} ng-article vl5">
    {expinclude uri='design:content/parts/item_image.tpl' node=$node image_alias='i160'}
    <header class="article-header">
        <h3 class="title"><a href="{exp_exp_path(null, $location)}">{title(null, $content_fields, $content)}</a></h3>
        <div class="info">
            {expinclude uri='design:content/parts/author.tpl'}        </div>
    </header>
</article>{* exp:template:convert tpl->stpl md5:c19b4e99eab642a4dc2db55da9dc546d from templates/content/views/mini/ng_article.tpl -- generated; a file changed by hand is not replaced without --force *}