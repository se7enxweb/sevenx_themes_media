{if hasField(null, $content, 'authors')}
    {$__loop1 = fieldRelations(null, $content, 'authors')}
{foreach $__loop1 as $author}
        {$author_rel = ''}
        {if and(is_set($view_type), $view_type|eq:'full')}
            {$author_rel = ' rel="author" itemprop="author"'}
        {/if}
        <a class="author" href="{exp_exp_path(null, $author)}"{$author_rel}>{$author.name|wash}</a>
        {$author_rel = null}
    {/foreach}
{/if}
