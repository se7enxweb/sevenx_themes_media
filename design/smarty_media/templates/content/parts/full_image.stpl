{$fi_node = false}
{if and(is_set($module_result.content_info.node_id), $module_result.content_info.node_id|gt:0)}
    {$fi_node = fetch('content', 'node', ['node_id' => $module_result.content_info.node_id])}
{/if}
{if $fi_node}
{$fi_url = ''}
{$fi_alt = $fi_node.name}
{$fi_attr = false}
{if and(is_set($fi_node.data_map.image), $fi_node.data_map.image.has_content)}
    {$fi_attr = $fi_node.data_map.image}
{elseif and(is_set($fi_node.data_map.teaser_image), $fi_node.data_map.teaser_image.has_content)}
    {$fi_attr = $fi_node.data_map.teaser_image}
{/if}
{if $fi_attr}
    {$fi_obj = $fi_attr.content}
    {if is_set($fi_obj.i1320)}
{$fi_url = $fi_obj.i1320.url}
    {elseif is_set($fi_obj.large)}
{$fi_url = $fi_obj.large.url}
    {elseif is_set($fi_obj.original)}
{$fi_url = $fi_obj.original.url}
{/if}
    {$fi_alt = first_set($fi_alt)}
    {$fi_obj = null}
{/if}
{if $fi_url|ne:''}
{explblock name='article_media'}
<div class="full-page-image">
    <div>
        <figure class="image-wrapper">
        <img
            src={$fi_url|ezroot}
            loading="lazy" alt="{$fi_alt|wash}"
        />
        </figure>
    </div>
</div>{/explblock}
{/if}
{$fi_url = null}
{$fi_alt = null}
{/if}
{$fi_node = null}
{* exp:template:convert tpl->stpl md5:6ed4cb5c992efe4a2d2abb1338b86260 from templates/content/parts/full_image.tpl -- generated; a file changed by hand is not replaced without --force *}