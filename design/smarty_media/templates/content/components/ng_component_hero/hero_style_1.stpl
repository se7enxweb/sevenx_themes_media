


{$image = $content.fields.image}
{$image_mobile = $content.fields.image_mobile}
{$local_video = $content.fields.video}
{$local_video_mobile = $content.fields.video_mobile}


    <article class="view-component view-component-hero hero-style-1">
        <div class="container">
            <div class="row">
                <div class="col-md-10 col-lg-8 col-xl-7">
                    <header class="article-header">
                        {if not($content.fields.eyebrow_title.empty)}
                            <div class="eyebrow-title">
                                {ng_render_field(null, $content.fields.eyebrow_title)}
                            </div>
                        {/if}
                        {if not($content.fields.title.empty)}
                            <h1 class="title">
                                {ng_render_field(null, $content.fields.title)}
                            </h1>
                        {/if}
                        {if not($content.fields.description.empty)}
                            <div class="short">
                                {ng_render_field(null, $content.fields.description)}
                            </div>
                        {/if}
                        <div class="actions">
                            {if not($content.fields.link_1.empty)}
                                {ng_render_field(null, $content.fields.link_1, ['parameters' => ['css_class' => 'btn btn-primary']])}
                            {/if}

                            {if not($content.fields.link_2.empty)}
                                {ng_render_field(null, $content.fields.link_2, ['parameters' => ['css_class' => 'btn btn-default']])}
                            {/if}
                        </div>
                    </header>
                </div>
            </div>
        </div>
        <figure>
            {if and(is_set($local_video), not($local_video.empty))}
                <video preload="auto" autoplay="" loop="" muted="" playsinline="" class="js-responsive-video"
                    data-desktop-vid="{path(null, 'ngsite_download', ['contentId' => $content.id, 'fieldId' => $local_video.id, 'isInline' => 1])}"
                    {if and(is_set($local_video_mobile), not($local_video_mobile.empty))}
                    data-mobile-vid="{path(null, 'ngsite_download', ['contentId' => $content.id, 'fieldId' => $local_video_mobile.id, 'isInline' => 1])}"
                {/if}
                ></video>
                <span class="overlay"></span>
            {elseif not($image.empty)}
                <picture>
                    {if not($image_mobile.empty)}
                        <source media="(max-width: 991px)" srcset="{ng_image_alias(null, $content.fields.image_mobile, 'i770')}">
                    {/if}
                    <source media="(min-width: 992px)" srcset="{ng_image_alias(null, $content.fields.image, 'original')}">
                    {ng_render_field(null, $content.fields.image, ['parameters' => ['lazy_loading' => 'false', 'alias' => 'i1920']])}
                </picture>
                <span class="overlay"></span>
            {/if}
        </figure>
    </article>
{* exp:template:convert tpl->stpl md5:ad4ee256c112ff11163b2a2e37e0949d from templates/content/components/ng_component_hero/hero_style_1.tpl -- generated; a file changed by hand is not replaced without --force *}