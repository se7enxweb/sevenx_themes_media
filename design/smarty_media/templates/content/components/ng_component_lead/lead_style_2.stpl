




<article class="view-component view-component-lead lead-style-2">
    <div class="row">
        <div class="col-lg-5">
            <header class="article-header">
                {if not($content.fields.eyebrow_title.empty)}
                    <div class="eyebrow-title">
                        {ng_render_field(null, $content.fields.eyebrow_title)}
                    </div>
                {/if}

                {if not($content.fields.title.empty)}
                    <h2 class="title">
                        {ng_render_field(null, $content.fields.title)}
                    </h2>
                {/if}
            </header>
            {if not($content.fields.description.empty)}
                <div class="article-info">
                    <div class="short">
                        {ng_render_field(null, $content.fields.description)}
                    </div>
                </div>
            {/if}
        </div>
        <div class="col-lg-5 offset-lg-1 mt-5 mt-lg-0">
            {if not($content.fields.link_1.empty)}
                {if $content.fields.link_1.value.isTargetEmbed}
                    <div class="embedded-form">
                {else}
                    <div class="actions">
                {/if}
                    {ng_render_field(null, $content.fields.link_1, ['parameters' => ['css_class' => 'btn btn-primary']])}
                </div>
            {/if}
        </div>
    </div>
</article>
{* exp:template:convert tpl->stpl md5:6758fb10ecbb662a049a2a619fa1d882 from templates/content/components/ng_component_lead/lead_style_2.tpl -- generated; a file changed by hand is not replaced without --force *}