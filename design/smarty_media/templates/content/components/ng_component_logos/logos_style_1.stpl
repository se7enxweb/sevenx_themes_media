




    <article class="view-component view-component-logos logos-style-1">
        <header class="article-header">
            <div class="text">
                {if not($content.fields.eyebrow_title.empty)}
                    <div class="eyebrow-title">
                        {ng_render_field(null, $content.fields.eyebrow_title)}
                    </div>
                {/if}
                {if not($content.fields.title.empty)}
                    <h2 class="title">
                        {ng_render_field(null, $content.fields.title)}
                    </h2>
                {/if}
                {if not($content.fields.description.empty)}
                    <div class="short">
                        {ng_render_field(null, $content.fields.description)}
                    </div>
                {/if}
            </div>
            <div class="actions">
                {if not($content.fields.link_1.empty)}
                    {ng_render_field(null, $content.fields.link_1, ['parameters' => ['css_class' => 'btn btn-primary']])}
                {/if}
                {if not($content.fields.link_2.empty)}
                    {ng_render_field(null, $content.fields.link_2, ['parameters' => ['css_class' => 'btn btn-default']])}
                {/if}
            </div>
        </header>

        {$logos = filterFieldRelations(null, $content, 'logos', ['ng_logo'], 12, 1)}

        <div class="logo-grid">
        {foreach $logos as $logo}
            <div class="logo-grid-item">
                {if not($logo.fields.logo_svg.empty)}
                    <img src="{asset(null, $logo.fields.logo_svg.value.id, 'exp_file')}" alt="{$logo.name}" />
                {/if}
            </div>
        {/foreach}
        </div>
    </article>
{* exp:template:convert tpl->stpl md5:26a323d45872e0f6ade92a5762a855d4 from templates/content/components/ng_component_logos/logos_style_1.tpl -- generated; a file changed by hand is not replaced without --force *}