


{$image = fieldValue(null, $content, 'image')}
{$image_mobile = fieldValue(null, $content, 'image_mobile')}


    <article class="view-component view-component-about about-style-1">

        {if or(not($content.fields.eyebrow_title.empty), not($content.fields.title.empty))}
            <header class="article-header">
                {if not($content.fields.eyebrow_title.empty)}
                    <div class="eyebrow-title">
                        {ng_render_field(null, $content.fields.eyebrow_title)}
                    </div>
                {/if}

                {if not($content.fields.title.empty)}
                    <h2 class="title">
                        {ng_render_field(null, $content.fields.title)}
                    </h2>
                {/if}
            </header>
        {/if}
        
        <div class="article-info">
            {if not($content.fields.description.empty)}
                <div class="short">
                    {ng_render_field(null, $content.fields.description)}
                </div>
            {/if}

            <div class="actions">
                {if not($content.fields.link_1.empty)}
                    {ng_render_field(null, $content.fields.link_1, ['parameters' => ['css_class' => 'btn btn-secondary']])}
                {/if}

                {if not($content.fields.link_2.empty)}
                    {ng_render_field(null, $content.fields.link_2, ['parameters' => ['css_class' => 'btn btn-default']])}
                {/if}
            </div>
        </div>

    </article>
{* exp:template:convert tpl->stpl md5:189d14726cc2706e5e0e3a43a1c1f1a2 from templates/content/components/ng_component_about/about_style_1.tpl -- generated; a file changed by hand is not replaced without --force *}