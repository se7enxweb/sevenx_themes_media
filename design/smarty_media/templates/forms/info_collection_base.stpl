

    {$attributes = []}

    {if and(hasField(null, $content, 'gtm_event_prefix'), not($content.fields.gtm_event_prefix.empty))}
        {$attributes = $attributes|merge:(['data-gtm-event-prefix' => $content.fields.gtm_event_prefix.value.text])}
    {/if}

    {if and(is_set($class), not(($class|exp_count)|eq:0))}
        {$attributes = $attributes|merge:(['class' => $class])}
    {/if}

    {$form_parameters = ['action' => first_set($action, ''), 'attr' => $attributes]}

{if not($is_collected)}
    {$twig_block_form_body}{else}
    
        <div class="full-form-response">
            {if not($content.fields.success_text.empty)}
                {ng_render_field(null, $content.fields.success_text)}
            {else}
                <p>{'ngsite.collected_info.success_text'|trans}</p>
            {/if}
        </div>
    {/if}
{* exp:template:convert tpl->stpl md5:372b094d8f51a74e08b1acda66321ff4 from templates/forms/info_collection_base.tpl -- generated; a file changed by hand is not replaced without --force *}