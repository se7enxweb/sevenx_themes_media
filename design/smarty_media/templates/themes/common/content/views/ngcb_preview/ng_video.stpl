





{if or(not($content.fields.video_file.empty), not($content.fields.video_identifier.empty))}
    <article class="view-type view-type-{$view_type} ng-video vl1">
        <i class="icon-play article-icon" aria-hidden="true"></i>
        <figure class="image">
            {poster(null, $video, $content, $location)}
        </figure>

        <header class="article-header">
            <h2 class="title"><a href="{exp_exp_path(null, $location)}">{title(null, $content_fields, $content)}</a></h2>
            <div class="info">
                {if not($content.fields.sponsored_content_disclosure.empty)}
                    <span class="sponsored-tag">{'ngsite.layout.sponsored'|trans}</span>
                {elseif not($content.fields.main_topic.empty)}
                    <a href={(ngsite_topic_path(null, $content.fields.main_topic.value.tags.0))|ezurl}>{$content.fields.main_topic.value.tags.0.keyword|wash}</a>
                {/if}
            </div>
        </header>

        {intro(null, $content_fields, $content)}
    </article>{/if}
{* exp:template:convert tpl->stpl md5:683b2105799211b44795227fd8cd32e7 from templates/themes/common/content/views/ngcb_preview/ng_video.tpl -- generated; a file changed by hand is not replaced without --force *}