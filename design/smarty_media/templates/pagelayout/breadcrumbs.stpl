{$bc_path_array = false}
{if is_set($path_array)}
    {$bc_path_array = $path_array}
{else}
    {$bc_node = false}
    {if and(is_set($node), is_object($node))}
        {$bc_node = $node}
    {elseif and(is_set($module_result), is_set($module_result.content_info), is_set($module_result.content_info.node_id), $module_result.content_info.node_id|gt:0)}
        {$bc_node = fetch('content', 'node', ['node_id' => $module_result.content_info.node_id])}
    {/if}
    {if $bc_node}
        {$bc_items = []}
        {foreach $bc_node.path as $bc_path_node}
            {if $bc_path_node.depth|gt:1}
                {$bc_items = $bc_items|append:(['text' => $bc_path_node.name, 'url' => $bc_path_node.url_alias])}
            {/if}
        {/foreach}
        {$bc_items = $bc_items|append:(['text' => $bc_node.name, 'url' => false])}
        {$bc_path_array = $bc_items}
        {$bc_items = null}
    {/if}
    {$bc_node = null}
{/if}
{if not(is_set($show_path))}
    {$show_path = true}
{/if}
{if and($show_path, $bc_path_array, gt($bc_path_array|exp_count, 2))}
    <nav class="breadcrumb-wrapper" aria-label="{'Breadcrumbs'|i18n:'design/media/pagelayout'}">
        <ol>
            <li class="breadcrumb-item">
                <a href={$bc_path_array.0.url|ezurl}>
                    <i class="icon-home" aria-hidden="true"></i>
                    <span>{$bc_path_array.0.text|wash}</span>
                </a>
            </li>
            {foreach $bc_path_array as $bc_index => $path_item}
                {if $bc_index|gt:0}
                    {if not($path_item.url)}
                    <li class="breadcrumb-item breadcrumb-item--no-link"><span{if $bc_index|eq:(($bc_path_array|exp_count)|sub:1)}
 aria-current="location"{/if}
>{$path_item.text|wash}</span></li>
                    {else}
                    <li class="breadcrumb-item breadcrumb-item--link"><a href={$path_item.url|ezurl}{if $bc_index|eq:(($bc_path_array|exp_count)|sub:1)}
 aria-current="location"{/if}
><span>{$path_item.text|wash}</span></a></li>
                    {/if}
                {/if}
            {/foreach}
        </ol>
    </nav>{/if}
{* exp:template:convert tpl->stpl md5:eeaccdf4e352ba0e4d710cc2c99739d6 from templates/pagelayout/breadcrumbs.tpl -- generated; a file changed by hand is not replaced without --force *}