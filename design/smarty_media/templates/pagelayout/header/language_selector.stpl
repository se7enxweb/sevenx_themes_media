{$ls_current_node = false}
{if exp_is_array($module_result.content_info)}
    {if is_set($module_result.content_info.node_id)}
        {if $module_result.content_info.node_id|gt:0}
            {$ls_current_node = fetch('content', 'node', ['node_id' => $module_result.content_info.node_id])}
        {/if}
    {/if}
{/if}
{$ls_translations = []}
{if and(is_object($ls_current_node), $ls_current_node.url_alias|ne:'')}
    {$ls_translations = language_switcher($ls_current_node.url_alias)}
{else}
    {$ls_translations = language_switcher('')}
{/if}
{if ($ls_translations|exp_count)|gt:1}
    {$ls_current_siteaccess = ''}
    {$ls_current_translation = false}

    {$ls_current_locale = ezini('RegionalSettings', 'Locale')}

    
    {foreach $ls_translations as $ls_siteaccess => $ls_translation}
        {if $ls_translation.locale|eq:$ls_current_locale}
            {$ls_current_siteaccess = $ls_siteaccess}
            {$ls_current_translation = $ls_translation}
        {elseif $ls_current_siteaccess|eq:''}
            
            {$ls_current_siteaccess = $ls_siteaccess}
            {$ls_current_translation = $ls_translation}
        {/if}
    {/foreach}

    <div class="language-selector dropdown">
        <button data-bs-toggle="dropdown" class="current-lang" aria-label="{'Change language'|i18n:'design/media/pagelayout'}" aria-controls="langSelector" aria-expanded="false">
            {$ls_current_translation.text|wash}&nbsp;<i class="icon-angle-down" aria-hidden="true"></i>
        </button>

        <ul class="dropdown-menu" id="langSelector">
        {foreach $ls_translations as $ls_siteaccess => $ls_translation}
            {if $ls_siteaccess|eq:$ls_current_siteaccess}
                <li class="current"><a href="#" data-toggle="dropdown">{$ls_translation.text|wash}</a></li>
            {else}
                <li><a href={$ls_translation.url|ezurl} aria-label="{$ls_translation.text|wash}">{$ls_translation.text|wash}</a></li>
            {/if}
        {/foreach}
        </ul>
    </div>

    {$ls_current_siteaccess = null}
{$ls_current_translation = null}
{/if}
{$ls_current_node = null}
{$ls_translations = null}
{* exp:template:convert tpl->stpl md5:b68f948c29dbf8e30e26f0cd3dba980b from templates/pagelayout/header/language_selector.tpl -- generated; a file changed by hand is not replaced without --force *}