{$site_title = first_set($site_name, '')}
{$page_title = ''}
{if exp_is_array($module_result.content_info)}
    {if is_set($module_result.content_info.node_id)}
        {if $module_result.content_info.node_id|gt:0}
            {$title_node = fetch('content', 'node', ['node_id' => $module_result.content_info.node_id])}
            {if $title_node}
                {$title_meta = metadata(null, $title_node.node_id)}
                {$page_title = $title_node.name}
                {if $title_meta}
                    {if $title_meta.title|ne:''}
                        {$page_title = $title_meta.title}
                    {/if}
                {/if}
                {$title_meta = null}
            {/if}
        {/if}
    {/if}
{/if}
{if and($page_title|eq:'', is_set($module_result.errorType))}
    {$title_error_key = concat($module_result.errorType, '/', first_set($module_result.errorNumber, ''))}
    {$__switch1 = $title_error_key}
{if $__switch1 == 'kernel/1'}
        {if $current_user.is_logged_in}
            {$page_title = 'You don\'t have access to this page'|i18n:'design/media/error'}
        {else}
            {$page_title = 'Please sign in to see this page'|i18n:'design/media/error'}
        {/if}
    {elseif $__switch1|in_array:(['kernel/2', 'kernel/20', 'kernel/21'])}
{$page_title = 'We couldn\'t find that page'|i18n:'design/media/error'}
{elseif $__switch1 == 'kernel/3'}
{$page_title = 'This page isn\'t available'|i18n:'design/media/error'}
{elseif $__switch1 == 'kernel/4'}
{$page_title = 'This page has moved'|i18n:'design/media/error'}
{elseif $__switch1 == 'kernel/5'}
{$page_title = 'This page isn\'t available in that language'|i18n:'design/media/error'}
{elseif $__switch1 == 'kernel/6'}
{elseif $__switch1 == 'kernel/22'}
{$page_title = 'This part of the site is switched off'|i18n:'design/media/error'}
{elseif $__switch1 == 'kernel/50'}
{$page_title = 'We\'ll be right back'|i18n:'design/media/error'}
{elseif $__switch1 == 'shop/1'}
{$page_title = 'This item can\'t be bought'|i18n:'design/media/error'}
{elseif $__switch1 == 'shop/2'}
{$page_title = 'This product can\'t be added to your basket'|i18n:'design/media/error'}
{elseif $__switch1 == 'shop/3'}
{$page_title = 'That currency isn\'t available'|i18n:'design/media/error'}
{elseif $__switch1 == 'shop/4'}
{$page_title = 'That currency isn\'t available at the moment'|i18n:'design/media/error'}
{else}
{$page_title = 'Error'|i18n:'design/media/error'}
{/if}
    {$title_error_key = null}
{/if}
{if $page_title|eq:''}
    {if exp_is_array($module_result.path)}
        {foreach $module_result.path as $title_path_element}
            {if is_set($title_path_element.text)}
                {if $title_path_element.text|ne:''}
                    {$page_title = $title_path_element.text}
                {/if}
            {/if}
        {/foreach}
    {/if}
{/if}
{if $page_title|ne:''}
    {if $page_title|ne:$site_name}
        {$site_title = concat($page_title, cond(($site_title|exp_count)|gt:0, concat(' - ', $site_title), ''))}
    {else}
        {$site_title = $page_title}
    {/if}
{/if}
<title>{$site_title|wash}</title>{$page_title = null}
{* exp:template:convert tpl->stpl md5:6a81d7ead57196697f0d6c3792b52765 from templates/pagelayout/head/title.tpl -- generated; a file changed by hand is not replaced without --force *}