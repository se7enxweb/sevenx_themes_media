<meta name="generator" content="{'Exponential powered by 7x'|i18n:'design/media/pagelayout'}">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=2">
<meta name="theme-color" content="#ffffff">
{$mt_meta = false}
{if $node}
    {$mt_meta = metadata(null, $node.node_id)}
{/if}
{$mt_description = ''}
{if $mt_meta}
    {if $mt_meta.description|ne:''}
        {$mt_description = $mt_meta.description}
    {/if}
{/if}
{if $mt_description|eq:''}
    {if $node}
        {$mt_intro = firstNonEmptyField(null, $node.object, 'teaser_intro', 'intro', 'description')}
        {if not($mt_intro.empty)}
            
            {$mt_description = (($mt_intro.value.text|preg_replace:'/<[^>]+>/':' ')|simplify)|shorten:160}
        {/if}
        {$mt_intro = null}
    {/if}
{/if}

{if $mt_description|eq:''}
    {$mt_site_meta = ezini('SiteSettings', 'MetaDataArray')}
    {if and(is_set($mt_site_meta.description), $mt_site_meta.description|ne:'')}
        {$mt_description = $mt_site_meta.description}
    {/if}
    {$mt_site_meta = null}
{/if}
{if $mt_description|ne:''}
<meta name="description" content="{$mt_description|wash}" />{/if}
{if $mt_meta}
    {if ($mt_meta.keywords|exp_count)|gt:0}
<meta name="keywords" content="{($mt_meta.keywords|exp_implode:', ')|wash}" />
    {/if}
    {if $mt_meta.canonical_url|ne:''}
<link rel="canonical" href="{$mt_meta.canonical_url|wash}" />
    {/if}
    
    {expinclude uri='design:xrowmetadata/opengraph_image.tpl' meta=$mt_meta}{/if}
{$mt_meta = null}
{$mt_description = null}

{if $node}
    {$mt_license = xrowmetadata_license(null, $node)}
{else}
    {$mt_license = xrowmetadata_license()}
{/if}
{expinclude uri='design:xrowmetadata/license_head.tpl' license=$mt_license json_ld=false}{$mt_license_ld = and($mt_license, $mt_license.show.json_ld)}
{$mt_last = ($path_array|exp_count)|sub:1}
<script type="application/ld+json">
{ldelim}
    "@context": "https://schema.org",{if $mt_license_ld}
    "@graph": [
    {ldelim}{/if}
    "@type": "BreadcrumbList",
    "itemListElement": [
    {foreach $path_array as $mt_index => $mt_item}
        {ldelim}            "@type": "ListItem",
            "name": {$mt_item.text|json_ld},
            {if $mt_item.url|ne:'false'}
"item": {(concat('https://', ezini('SiteSettings', 'SiteURL'), '/', $mt_item.url))|json_ld},{/if}
            "position": {$mt_index|sum:1}
        {rdelim}{if $mt_index|lt:$mt_last}
,{/if}
    {/foreach}
    ]{if $mt_license_ld}
    },
    {$mt_license.json_ld_node}
    ]{/if}
}
</script>{$mt_last = null}
{$mt_license = null}
{$mt_license_ld = null}
{* exp:template:convert tpl->stpl md5:e487f38231492a76742b7c1d97e2c82d from templates/pagelayout/head/meta.tpl -- generated; a file changed by hand is not replaced without --force *}