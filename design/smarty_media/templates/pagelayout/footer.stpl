{$ft_site_info = fetch('content', 'object', ['object_id' => false, 'remote_id' => ezini('SiteInfo', 'RemoteID', 'menu.ini')])}
{if is_object($ft_site_info)}
<footer class="site-footer">
    <div class="container">
        {expinclude uri='design:content/parts/site_logo.tpl'}
        <div class="footer-menu">
        {$ft_ids = (ezini('SiteInfo', 'FooterMenuID', 'menu.ini'))|unique}
        {$ft_last = (exp_count(null, $ft_ids))|sub:1}
        {$ft_node = false}
        {$ft_display_id = false}
        {$ft_nexus_ids = (ezini('SiteInfo', 'NexusFooterMenuID', 'menu.ini'))|unique}
        {if ($ft_ids|exp_count)|gt:0}
            <ul class="nav navbar-nav">
            {foreach $ft_ids as $ft_index => $ft_id}
                {$ft_node = fetch('content', 'node', ['node_id' => $ft_id])}
                {$ft_display_id = $ft_id}
                {if and(is_set($ft_nexus_ids[$ft_index]), $ft_nexus_ids[$ft_index]|ne:'')}
                    {$ft_display_id = $ft_nexus_ids[$ft_index]}
                {/if}
                {if is_object($ft_node)}
                {$ft_href = cond($ft_node.url_alias|begins_with:'fit-healthy/', $ft_node.url_alias|ezroot, $ft_node.url_alias|ezurl)}
                <li id="menu-item-additional_menu-location-id-{$ft_display_id}"{if $ft_index|eq:0}
 class="firstli"{elseif $ft_index|eq:$ft_last}
 class="lastli"{/if}
 data-location-id="{$ft_display_id}">
                    <a href={$ft_href}>{$ft_node.name|wash}</a>
                </li>
                {$ft_href = null}
                {/if}
            {/foreach}
            </ul>
        {/if}
        </div>

                <nav class="footer-social" role="navigation">
            <ul>
                {if and(is_set($ft_site_info), $ft_site_info.data_map.facebook.has_content)}
                    <li>
                        <a href="{$ft_site_info.data_map.facebook.content}" aria-label="{'Visit us on %social'|i18n:'design/media/pagelayout':'':(['%social' => 'Facebook'])}" target="_blank" noreferrer="" noopener="">
                            <i class="icon-facebook"></i>
                            <span class="tt">Facebook</span>
                        </a>
                    </li>
                {/if}
                {if and(is_set($ft_site_info), $ft_site_info.data_map.twitter.has_content)}
                    <li>
                        <a href="{$ft_site_info.data_map.twitter.content}" aria-label="{'Visit us on %social'|i18n:'design/media/pagelayout':'':(['%social' => 'Twitter'])}" target="_blank" noreferrer="" noopener="">
                            <i class="icon-twitter"></i>
                            <span class="tt">Twitter</span>
                        </a>
                    </li>
                {/if}
                {if and(is_set($ft_site_info), $ft_site_info.data_map.instagram.has_content)}
                    <li>
                        <a href="{$ft_site_info.data_map.instagram.content}" aria-label="{'Visit us on %social'|i18n:'design/media/pagelayout':'':(['%social' => 'Instagram'])}" target="_blank" noreferrer="" noopener="">
                            <i class="icon-instagram"></i>
                            <span class="tt">Instagram</span>
                        </a>
                    </li>
                {/if}
                {if and(is_set($ft_site_info), $ft_site_info.data_map.linkedin.has_content)}
                    <li>
                        <a href="{$ft_site_info.data_map.linkedin.content}" aria-label="{'Visit us on %social'|i18n:'design/media/pagelayout':'':(['%social' => 'LinkedIn'])}" target="_blank" noreferrer="" noopener="">
                            <i class="icon-linkedin"></i>
                            <span class="tt">LinkedIn</span>
                        </a>
                    </li>
                {/if}
            </ul>
        </nav>

        
        {$ft_links_rid = 'media-o-footer-links'}
        {if ezini_hasvariable('SiteInfo', 'FooterLinksRemoteID', 'menu.ini')}
            {$ft_links_rid = ezini('SiteInfo', 'FooterLinksRemoteID', 'menu.ini')}
        {/if}
        {$ft_links_object = fetch('content', 'object', ['object_id' => false, 'remote_id' => $ft_links_rid])}
        {if and(is_object($ft_links_object), $ft_links_object.main_node_id)}
            {$ft_links = fetch('content', 'list', ['parent_node_id' => $ft_links_object.main_node_id, 'sort_by' => $ft_links_object.main_node.sort_array, 'class_filter_type' => 'include', 'class_filter_array' => ['ng_menu_item']])}
{$ft_links_last = 0}
{$ft_links_home = ((((ezini('SiteSettings', 'IndexPage', 'site.ini'))|exp_explode:'/')|extract_right:1)|exp_implode:'')|int}
{$ft_links_object_id = false}
{$ft_links_url = ''}
            {if $ft_links_home|lt:1}
{$ft_links_home = ezini('NodeSettings', 'RootNode', 'content.ini')}
{/if}
            {if and(is_set($module_result), is_set($module_result.content_info), is_set($module_result.content_info.object_id))}
                {$ft_links_object_id = $module_result.content_info.object_id}
            {/if}
            {$ft_links_last = (exp_count(null, $ft_links))|sub:1}
            {if ($ft_links|exp_count)|gt:0}
        <div class="footer-menu footer-links">
            <ul class="nav navbar-nav">
            {foreach $ft_links as $ft_links_index => $ft_link}
                {$ft_links_url = $ft_link.data_map.item_url.content|trim}
                {if $ft_links_url|eq:''}
{continue}
{/if}
                {if $ft_links_url|eq:'/content/edit'}
                    {$ft_links_url = cond($ft_links_object_id, concat('/content/edit/', $ft_links_object_id), '/user/login')}
                {elseif or($ft_links_url|eq:'/content/view/sitemap', $ft_links_url|eq:'/content/view/tagcloud')}
                    {$ft_links_url = concat($ft_links_url, '/', $ft_links_home)}
                {/if}
                <li id="menu-item-footer_links-location-id-{$ft_link.node_id}"{if $ft_links_index|eq:0}
 class="firstli"{elseif $ft_links_index|eq:$ft_links_last}
 class="lastli"{/if}
 data-location-id="{$ft_link.node_id}">
                    <a href={if $ft_links_url|begins_with:'http'}
"{$ft_links_url|wash}"{else}
{$ft_links_url|ezurl}{/if}
{if $ft_link.data_map.target_blank.data_int}
 target="_blank" rel="noopener noreferrer"{/if}
>{$ft_link.name|wash}</a>
                </li>
            {/foreach}
            </ul>
        </div>
            {/if}
            {$ft_links = null}
{$ft_links_last = null}
{$ft_links_home = null}
{$ft_links_object_id = null}
{$ft_links_url = null}
        {/if}
        {$ft_links_rid = null}
{$ft_links_object = null}

        <div class="footer-info">
                        {expinclude uri='design:parts/cookie_settings_link.tpl'}
            <div>
                <div class="exp_richtext-field">
                    <p>{'This demo site is built on Exponential 6.0.15+ and Exponential Layouts.'|i18n:'design/media/pagelayout'}</p>
                </div>
            </div>

            <address>
                {'Powered by %company &amp; %exponential'|i18n:'design/media/pagelayout':expvoid():(['%company' => '<a href="https://se7enx.com">7x</a>', '%exponential' => '<a href="https://exponential.earth">Exponential</a>'])}
            </address>
        </div>
    </div>
</footer>{/if}
{$ft_site_info = null}
{* exp:template:convert tpl->stpl md5:e339c962e8b8043ca8097558a3fc7701 from templates/pagelayout/footer.tpl -- generated; a file changed by hand is not replaced without --force *}